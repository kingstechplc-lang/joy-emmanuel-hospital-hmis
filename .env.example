# =====================================================================
# Joy Emmanuel Hospital HMIS — environment variables
# =====================================================================
# Copy this file to `.env` and fill in real values.
# Never commit `.env` — `.gitignore` excludes it.
# =====================================================================

# ─── Database (Neon PostgreSQL) ────────────────────────────────────────
# Pooled connection (used by Prisma client at runtime — serverless-safe)
DATABASE_URL="postgresql://USER:PASSWORD@HOSTPOOLER.neon.tech/DBNAME?sslmode=require&channel_binding=require"
# Direct connection (used by Prisma migrate / db push — bypasses pooler)
DIRECT_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require&channel_binding=require"

# ─── NextAuth.js ───────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-32-byte-random-string"
# Public URL of the deployed app (used for callback URLs)
NEXTAUTH_URL="http://localhost:3000"

# ─── NHIA Claim-it integration (optional — defaults to "mock" transport) ─
# Transport: "mock" (default, in-process) | "bridge" (external NHIA bridge)
NHIA_CLAIMIT_TRANSPORT="mock"
# Bridge URL when transport="bridge"
NHIA_CLAIMIT_BRIDGE_URL=""
# Upstream NHIA API base (production gateway)
NHIA_API_BASE_URL=""
# Timeout & retry tuning
NHIA_CLAIMIT_TIMEOUT_MS="30000"
NHIA_CLAIMIT_RETRY_COUNT="3"

# ─── Node runtime ──────────────────────────────────────────────────────
NODE_ENV="development"
