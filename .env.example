# =====================================================================
# Joy Emmanuel Hospital HMIS — environment variables
# =====================================================================
# Copy this file to `.env` and fill in real values.
# Never commit `.env` — `.gitignore` excludes it.
# =====================================================================

# ─── Database (Neon PostgreSQL) ────────────────────────────────────────
# Pooled connection (used by Prisma client at runtime — serverless-safe)
DATABASE_URL="postgresql://USER:PASSWORD@HOSTPOOLER.neon.tech/DBNAME?sslmode=require&channel_binding=require"
# Direct connection (used by Prisma migrate / db push — bypasses pooler)
DIRECT_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require&channel_binding=require"

# ─── NextAuth.js ───────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-32-byte-random-string"
# Public URL of the deployed app (used for callback URLs)
NEXTAUTH_URL="http://localhost:3000"

# ─── NHIA Claim-it integration (optional — defaults to "mock" transport) ─
# Transport: "mock" (default, in-process) | "bridge" (external NHIA bridge)
NHIA_CLAIMIT_TRANSPORT="mock"
# Bridge URL when transport="bridge"
NHIA_CLAIMIT_BRIDGE_URL=""
# Upstream NHIA API base (production gateway)
NHIA_API_BASE_URL=""
# Timeout & retry tuning
NHIA_CLAIMIT_TIMEOUT_MS="30000"
NHIA_CLAIMIT_RETRY_COUNT="3"

# ─── Node runtime ──────────────────────────────────────────────────────
NODE_ENV="development"

# ─── Z.ai AI provider (for the AI Assistant view) ─────────────────────
# Optional — if unset, the AI Assistant is disabled. When set, the HMIS
# calls the OpenAI-compatible chat-completions endpoint at
# {ZAI_BASE_URL}/chat/completions. Get these from https://z.ai.
#
# ZAI_BASE_URL: Z.ai international API base (omit the /chat/completions
#   suffix — the service appends it). Verified working value:
#   "https://api.z.ai/api/paas/v4"
# ZAI_API_KEY: your Z.ai API key (Bearer token).
# ZAI_MODEL: optional model override. If unset, defaults to "glm-4-plus"
#   (the only verified-valid model on the international api.z.ai endpoint
#   for accounts without free-tier access — glm-4-flash returns
#   "Unknown Model" code 1211 here). See src/lib/ai/ai-service.ts for
#   the full model-availability matrix.
ZAI_BASE_URL=""
ZAI_API_KEY=""
ZAI_MODEL=""
