// =====================================================================
// JOY EMMANUEL HOSPITAL — HMIS DATABASE SCHEMA
// =====================================================================
// Designed per the Neon PostgreSQL Database Architecture spec.
// Production database: Neon PostgreSQL.
//
// PRIMARY PRINCIPLE: ONE PATIENT = ONE MASTER PATIENT RECORD
//   patients are organization-level (NOT facility-owned)
//   encounters are facility-specific and reference patients.id
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------
// ORGANIZATION HIERARCHY
// ---------------------------------------------------------------------

model Organization {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String?
  logoUrl     String?
  phone       String?
  email       String?
  address     String?
  website     String?
  status      String   @default("active") // active | inactive
  settings    String? // JSONB in PG
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  facilities             Facility[]
  users                  User[]
  roles                  Role[]
  patients               Patient[]
  insuranceProviders     InsuranceProvider[]
  medications            Medication[]
  laboratoryTests        LaboratoryTest[]
  services               Service[]
  inventoryItems         InventoryItem[]
  suppliers              Supplier[]
  equipment              Equipment[]
  documents              Document[]
  tasks                  Task[]
  auditLogs              AuditLog[]
  systemSettings         SystemSetting[]
  patientMergeEvents     PatientMergeEvent[]     @relation("mergeOrgEvents")
  trainingRecords        TrainingRecord[]
  certifications         Certification[]
  incidentReports        IncidentReport[]
  shiftHandovers         ShiftHandover[]
  wardRounds             WardRound[]
  vaccineCatalogs        VaccineCatalog[]
  vaccineScheduleDoses   VaccineScheduleDose[]
  vaccineWastage         VaccineWastage[]
  coldChainAlerts        ColdChainAlert[]
  medicationInteractions MedicationInteraction[]
  servicePackages        ServicePackage[]
  ambulanceVehicles      AmbulanceVehicle[]
  ambulanceTrips         AmbulanceTrip[]
}

model Facility {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  code           String
  facilityType   String? // hospital | clinic | pharmacy | lab | admin
  description    String?
  address        String?
  city           String?
  region         String?
  country        String?
  phone          String?
  email          String?
  status         String       @default("active")
  timezone       String?
  settings       String? // JSONB in PG
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  departments                   Department[]
  wards                         Ward[]
  beds                          Bed[]
  staffFacilities               StaffFacility[]
  userRoles                     UserRole[]
  encounters                    Encounter[]
  appointments                  Appointment[]
  queues                        Queue[]
  staffShifts                   StaffShift[]
  inventory                     FacilityInventory[]
  inventoryTransactions         InventoryTransaction[]
  equipment                     Equipment[]
  purchaseOrders                PurchaseOrder[]
  goodsReceived                 GoodsReceived[]
  stockTransfersFrom            StockTransfer[]                @relation("stockFromFacility")
  stockTransfersTo              StockTransfer[]                @relation("stockToFacility")
  invoices                      Invoice[]
  payments                      Payment[]
  insuranceClaims               InsuranceClaim[]
  labOrders                     LabOrder[]
  imagingOrders                 ImagingOrder[]
  procedures                    Procedure[]
  admissions                    Admission[]
  patientTransfersFrom          PatientTransfer[]              @relation("ptFromFacility")
  patientTransfersTo            PatientTransfer[]              @relation("ptToFacility")
  referralsFrom                 Referral[]                     @relation("refFromFacility")
  referralsTo                   Referral[]                     @relation("refToFacility")
  immunizations                 Immunization[]
  aefiRecords                   AEFI[]
  vaccineWastage                VaccineWastage[]
  coldChainAlerts               ColdChainAlert[]
  // Maternity back-relations
  ancVisits                     AncVisit[]
  laborAndDeliveries            LaborAndDelivery[]
  postnatalVisits               PostnatalVisit[]
  // Ambulance back-relations
  ambulanceVehicles             AmbulanceVehicle[]
  ambulanceTrips                AmbulanceTrip[]
  documents                     Document[]
  notifications                 Notification[]
  tasks                         Task[]
  auditLogs                     AuditLog[]
  systemSettings                SystemSetting[]
  maternityRecords              MaternityRecord[]
  patientAccessLogs             PatientAccessLog[]
  breakGlassEvents              BreakGlassEvent[]
  facilityServicePrices         FacilityServicePrice[]
  prescriptions                 Prescription[]
  bedAssignments                BedAssignment[]
  staffAttendance               StaffAttendance[]
  incidentReports               IncidentReport[]
  shiftHandovers                ShiftHandover[]
  wardRounds                    WardRound[]
  intakeOutputEntries           IntakeOutputEntry[]
  intakeOutputMonitoringPeriods IntakeOutputMonitoringPeriod[]
  intakeOutputAlerts            IntakeOutputAlert[]
  intakeOutputAlertConfigs      IntakeOutputAlertConfig[]
  dischargeRecords              DischargeRecord[]
  creditNotes                   CreditNote[]
  stockAdjustments              StockAdjustment[]
  supplierEvaluations           SupplierEvaluation[]
  supplierComplaints            SupplierComplaint[]

  @@unique([organizationId, code])
}

model Department {
  id               String   @id @default(cuid())
  facilityId       String
  facility         Facility @relation(fields: [facilityId], references: [id])
  name             String
  code             String
  category         String?  @default("Clinical") // Clinical | Diagnostic | Pharmaceutical | Nursing | Finance | Records | Technical | Management | Custom
  description      String?
  headStaffId      String? // Department Head (Staff ID)
  location         String? // Physical location (e.g., "Block A, Floor 2")
  contactExtension String? // Phone extension
  operatingHours   String? // JSON: { mon: "08:00-17:00", tue: "08:00-17:00", ... }
  status           String   @default("active") // active | inactive | closed | under_maintenance | archived
  settings         String?
  createdById      String?
  updatedById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  units           Unit[]
  wards           Ward[]
  encounters      Encounter[]
  appointments    Appointment[]
  queues          Queue[]
  staffFacilities StaffFacility[]
  userRoles       UserRole[]
  staffShifts     StaffShift[]
  equipment       Equipment[]
  tasks           Task[]
  shiftHandovers  ShiftHandover[]
  services        Service[]

  @@unique([facilityId, code])
  @@index([facilityId, status])
  @@index([category])
}

model Unit {
  id             String     @id @default(cuid())
  departmentId   String
  department     Department @relation(fields: [departmentId], references: [id])
  name           String
  code           String
  description    String?
  headStaffId    String? // Unit Head (Staff ID)
  location       String? // Physical location
  room           String? // Room number
  operatingHours String? // JSON
  status         String     @default("active") // active | inactive | archived
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  staffFacilities StaffFacility[]
  appointments    Appointment[]
  queues          Queue[]
  services        Service[]

  @@unique([departmentId, code])
}

model Ward {
  id           String      @id @default(cuid())
  facilityId   String
  facility     Facility    @relation(fields: [facilityId], references: [id])
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  name         String
  code         String
  wardType     String? // general | private | maternity | icu | emergency | paediatric | surgical
  genderPolicy String? // mixed | male | female
  capacity     Int         @default(0)
  status       String      @default("active")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  rooms                         Room[]
  beds                          Bed[]
  bedAssignments                BedAssignment[]
  wardRounds                    WardRound[]
  intakeOutputMonitoringPeriods IntakeOutputMonitoringPeriod[]
  intakeOutputAlertConfigs      IntakeOutputAlertConfig[]
}

model Room {
  id         String   @id @default(cuid())
  wardId     String
  ward       Ward     @relation(fields: [wardId], references: [id])
  roomNumber String
  roomType   String? // private | semi-private | ward
  capacity   Int      @default(1)
  status     String   @default("active")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  beds           Bed[]
  bedAssignments BedAssignment[]
}

model Bed {
  id                String   @id @default(cuid())
  facilityId        String
  facility          Facility @relation(fields: [facilityId], references: [id])
  wardId            String
  ward              Ward     @relation(fields: [wardId], references: [id])
  roomId            String?
  room              Room?    @relation(fields: [roomId], references: [id])
  bedNumber         String
  bedCode           String? // unique code, e.g., GH-JEH-MW-101-A
  bedType           String? // regular | icu | hdu | maternity | pediatric | neonatal | isolation | emergency | psychiatric | surgical | orthopedic | private | semi_private | other
  // ---- Extended master fields ----
  building          String? // building name/number
  floor             String? // floor identifier
  genderRestriction String? // male | female | any
  ageRestriction    String? // neonate | infant | child | adolescent | adult | elderly | any
  isolationCapable  Boolean  @default(false)
  oxygen            Boolean  @default(false)
  ventilator        Boolean  @default(false)
  cardiacMonitoring Boolean  @default(false)
  icuMonitoring     Boolean  @default(false)
  suction           Boolean  @default(false)
  accessibility     Boolean  @default(false) // wheelchair accessible
  description       String?
  // Lifecycle
  status            String   @default("available") // available | occupied | reserved | blocked | cleaning | maintenance | out_of_service | isolation | temporarily_unavailable
  lifecycleStatus   String   @default("active") // active | inactive | retired
  notes             String?
  createdById       String?
  updatedById       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  bedAssignments  BedAssignment[]
  bedReservations BedReservation[]
  cleanings       BedCleaning[]
  maintenances    BedMaintenance[]
  blocks          BedBlock[]

  @@unique([wardId, bedNumber])
  @@index([facilityId, status])
  @@index([facilityId, lifecycleStatus])
  @@index([wardId, status])
  @@index([bedType])
}

// ---------------------------------------------------------------------
// IDENTITY & ACCESS MANAGEMENT
// ---------------------------------------------------------------------

model User {
  id                  String       @id @default(cuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id])
  username            String       @unique
  email               String       @unique
  passwordHash        String
  firstName           String
  middleName          String?
  lastName            String
  phone               String?
  status              String       @default("active") // active | disabled | locked | pending
  lastLoginAt         DateTime?
  passwordChangedAt   DateTime?
  failedLoginAttempts Int          @default(0)
  lockedUntil         DateTime?
  mfaEnabled          Boolean      @default(false)
  mfaSecret           String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  staff                      Staff?
  userRoles                  UserRole[]
  appointmentsBooked         Appointment[]              @relation("apptBookedBy")
  encounters                 Encounter[]                @relation("encounterCreatedBy")
  consultations              Consultation[]             @relation("consultationClinician")
  prescriptions              Prescription[]             @relation("rxPrescriber")
  labOrders                  LabOrder[]                 @relation("labOrderClinician")
  imagingOrders              ImagingOrder[]             @relation("imagingOrderClinician")
  procedures                 Procedure[]                @relation("procedurePerformer")
  admissions                 Admission[]                @relation("admissionAdmittedBy")
  discharges                 DischargeRecord[]          @relation("dischargeUser")
  dischargesRequested        DischargeRecord[]          @relation("dischargeRequester")
  dischargesApproved         DischargeRecord[]          @relation("dischargeApprover")
  dischargesCancelled        DischargeRecord[]          @relation("dischargeCanceller")
  dischargesFinalized        DischargeRecord[]          @relation("dischargeFinalizer")
  dischargesAmended          DischargeRecord[]          @relation("dischargeAmender")
  dischargesClinicalCleared  DischargeRecord[]          @relation("dischargeClinicalClear")
  dischargesNursingCleared   DischargeRecord[]          @relation("dischargeNursingClear")
  dischargesFinancialCleared DischargeRecord[]          @relation("dischargeFinancialClear")
  dischargesPharmacyCleared  DischargeRecord[]          @relation("dischargePharmacyClear")
  nursingNotes               NursingNote[]              @relation("nursingNoteAuthor")
  carePlans                  CarePlan[]                 @relation("carePlanAuthor")
  referralsMade              Referral[]                 @relation("referralMadeBy")
  referralsReceived          Referral[]                 @relation("referralReceivedBy")
  referralEvents             ReferralEvent[]            @relation("referralEventActor")
  referralFeedback           ReferralFeedback[]         @relation("referralFeedbackAuthor")
  referralMessages           ReferralMessage[]          @relation("referralMessageSender")
  aefiReported               AEFI[]                     @relation("aefiReportedBy")
  aefiReviewed               AEFI[]                     @relation("aefiReviewedBy")
  vaccineWastageDisposed     VaccineWastage[]           @relation("wasteDisposedBy")
  coldChainRecorded          ColdChainAlert[]           @relation("coldChainRecordedBy")
  coldChainAcked             ColdChainAlert[]           @relation("coldChainAckedBy")
  // Maternity back-relations
  maternityRecords           MaternityRecord[]          @relation("maternityCreator")
  ancVisitsRecorded          AncVisit[]                 @relation("ancVisitRecorder")
  laborClinician             LaborAndDelivery[]         @relation("laborClinician")
  laborMidwife               LaborAndDelivery[]         @relation("laborMidwife")
  postnatalVisitsRecorded    PostnatalVisit[]           @relation("postnatalRecorder")
  // Medication back-relations
  medicationsCreated         Medication[]               @relation("medicationCreator")
  medicationsUpdated         Medication[]               @relation("medicationUpdater")
  // Service back-relations
  servicesCreated            Service[]                  @relation("serviceCreator")
  servicesUpdated            Service[]                  @relation("serviceUpdater")
  servicePriceChanges        ServicePriceHistory[]      @relation("servicePriceChanger")
  packagesCreated            ServicePackage[]           @relation("packageCreator")
  // Ambulance back-relations
  ambulanceVehiclesCreated   AmbulanceVehicle[]         @relation("ambulanceCreator")
  ambulanceTripsRequested    AmbulanceTrip[]            @relation("ambulanceRequester")
  patientTransfers           PatientTransfer[]          @relation("ptRequestedBy")
  transfersApproved          PatientTransfer[]          @relation("ptApprovedBy")
  transfersAccepted          PatientTransfer[]          @relation("ptAcceptedBy")
  transfersRejected          PatientTransfer[]          @relation("ptRejectedBy")
  transfersDeparted          PatientTransfer[]          @relation("ptDepartedBy")
  transfersArrived           PatientTransfer[]          @relation("ptArrivedBy")
  transfersCompleted         PatientTransfer[]          @relation("ptCompletedBy")
  transfersCancelled         PatientTransfer[]          @relation("ptCancelledBy")
  transfersAmended           PatientTransfer[]          @relation("ptAmendedBy")
  immunizations              Immunization[]             @relation("immunizationAdmin")
  triageRecords              TriageRecord[]             @relation("triageNurse")
  vitalSigns                 VitalSign[]                @relation("vitalSignAuthor")
  invoices                   Invoice[]                  @relation("invoiceCreator")
  invoicesReviewed           Invoice[]                  @relation("invoiceReviewer")
  invoicesApproved           Invoice[]                  @relation("invoiceApprover")
  invoicesIssued             Invoice[]                  @relation("invoiceIssuer")
  invoicesVoided             Invoice[]                  @relation("invoiceVoider")
  invoicesCancelled          Invoice[]                  @relation("invoiceCanceller")
  invoicesWrittenOff         Invoice[]                  @relation("invoiceWriteOff")
  invoicesDiscountApproved   Invoice[]                  @relation("invoiceDiscountApprover")
  payments                   Payment[]                  @relation("paymentReceiver")
  refunds                    Refund[]                   @relation("refundProcessedBy")
  refundsRequested           Refund[]                   @relation("refundRequestedBy")
  refundsApproved            Refund[]                   @relation("refundApprovedBy")
  refundsReviewed            Refund[]                   @relation("refundReviewedBy")
  refundsRejected            Refund[]                   @relation("refundRejectedBy")
  refundsCancelled           Refund[]                   @relation("refundCancelledBy")
  refundsReversed            Refund[]                   @relation("refundReversedBy")
  refundsVerified            Refund[]                   @relation("refundVerifiedBy")
  creditNotesIssued          CreditNote[]               @relation("creditNoteIssuer")
  invoiceAdjustmentsApproved InvoiceAdjustment[]        @relation("adjustmentApprover")
  purchaseOrders             PurchaseOrder[]            @relation("poRequestedBy")
  purchaseOrdersApproved     PurchaseOrder[]            @relation("poApprovedBy")
  inventoryTransactions      InventoryTransaction[]
  stockTransfers             StockTransfer[]            @relation("stRequestedBy")
  stockTransfersApproved     StockTransfer[]            @relation("stApprovedBy")
  stockTransfersReceived     StockTransfer[]            @relation("stReceivedBy")
  goodsReceived              GoodsReceived[]            @relation("goodsReceivedBy")
  inventoryItemsCreated      InventoryItem[]            @relation("inventoryItemCreator")
  stockAdjustmentsRequested  StockAdjustment[]          @relation("adjustmentRequestedBy")
  stockAdjustmentsApproved   StockAdjustment[]          @relation("adjustmentApprovedBy")
  documents                  Document[]                 @relation("docUploader")
  consents                   Consent[]                  @relation("consentRecorder")
  tasks                      Task[]                     @relation("taskAssignee")
  tasksCreated               Task[]                     @relation("taskCreator")
  notifications              Notification[]
  auditLogs                  AuditLog[]
  breakGlassEvents           BreakGlassEvent[]
  patientAccessLogs          PatientAccessLog[]
  medicationAdministrations  MedicationAdministration[]
  systemSettings             SystemSetting[]
  mergesPerformed            PatientMergeEvent[]        @relation("mergePerformedBy")
  mergesApproved             PatientMergeEvent[]        @relation("mergeApprovedBy")
  allergiesRecorded          Allergy[]                  @relation("allergiesRecorded")
  maintenancePerformed       EquipmentMaintenance[]     @relation("maintenancePerformedBy")
  incidentsReported          IncidentReport[]           @relation("incidentReporter")
  handoversOutgoing          ShiftHandover[]            @relation("handoverOutgoing")
  handoversIncoming          ShiftHandover[]            @relation("handoverIncoming")
  wardRoundsAsConsultant     WardRound[]                @relation("wardRoundConsultant")
  wardRoundsAsCreator        WardRound[]                @relation("wardRoundCreator")
  intakeOutputRecorded       IntakeOutputEntry[]        @relation("intakeOutputRecorder")
  intakeOutputVerified       IntakeOutputEntry[]        @relation("intakeOutputVerifier")
  intakeOutputAmended        IntakeOutputEntry[]        @relation("intakeOutputAmender")
  intakeOutputAlertsAck      IntakeOutputAlert[]        @relation("intakeOutputAlertAck")
  // Supplier back-relations
  suppliersApproved          Supplier[]                 @relation("supplierApprovedBy")
  suppliersVerified          Supplier[]                 @relation("supplierVerifiedBy")
  suppliersSuspended         Supplier[]                 @relation("supplierSuspendedBy")
  suppliersCreated           Supplier[]                 @relation("supplierCreatedBy")
  supplierDocsVerified       SupplierDocument[]         @relation("supplierDocVerifiedBy")
  supplierEvaluations        SupplierEvaluation[]       @relation("supplierEvaluatedBy")
  supplierComplaintsResolved SupplierComplaint[]        @relation("supplierComplaintResolvedBy")
}

model Staff {
  id                             String    @id @default(cuid())
  userId                         String    @unique
  user                           User      @relation(fields: [userId], references: [id])
  staffNumber                    String    @unique
  firstName                      String
  middleName                     String?
  lastName                       String
  dateOfBirth                    DateTime?
  phone                          String?
  email                          String?
  professionalRole               String? // doctor | nurse | pharmacist | lab_scientist | radiographer | etc
  professionalRegistrationNumber String?
  employmentStatus               String    @default("active") // active | on_leave | suspended | terminated
  employmentType                 String? // full_time | part_time | contract | locum
  hireDate                       DateTime?
  terminationDate                DateTime?
  createdAt                      DateTime  @default(now())
  updatedAt                      DateTime  @updatedAt

  staffFacilities   StaffFacility[]
  shifts            StaffShift[]
  leaves            LeaveRecord[]
  attendanceRecords StaffAttendance[]
  trainingRecords   TrainingRecord[]
  certifications    Certification[]
}

model StaffFacility {
  id           String      @id @default(cuid())
  staffId      String
  staff        Staff       @relation(fields: [staffId], references: [id])
  facilityId   String
  facility     Facility    @relation(fields: [facilityId], references: [id])
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  unitId       String? // Unit assignment within the department
  unit         Unit?       @relation(fields: [unitId], references: [id])
  position     String?
  staffRole    String? // Role within this department (e.g., 'Senior Nurse', 'Consultant')
  isPrimary    Boolean     @default(false)
  startDate    DateTime?
  endDate      DateTime?
  status       String      @default("active") // active | inactive | transferred
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([staffId, facilityId])
}

model Role {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  code           String
  description    String?
  isSystemRole   Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  permissions RolePermission[]
  userRoles   UserRole[]

  @@unique([organizationId, code])
}

model Permission {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String?
  module      String?
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id])
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
}

model UserRole {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id])
  roleId       String
  role         Role        @relation(fields: [roleId], references: [id])
  facilityId   String?
  facility     Facility?   @relation(fields: [facilityId], references: [id])
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  createdAt    DateTime    @default(now())

  @@unique([userId, roleId, facilityId, departmentId])
}

// ---------------------------------------------------------------------
// PATIENT MASTER INDEX (ORGANIZATION-LEVEL)
// ---------------------------------------------------------------------

model Patient {
  id                     String       @id @default(cuid())
  organizationId         String
  organization           Organization @relation(fields: [organizationId], references: [id])
  patientNumber          String // JEM-00000001 (UNIQUE within org)
  firstName              String
  middleName             String?
  lastName               String
  previousName           String?
  dateOfBirth            DateTime?
  sex                    String? // male | female | intersex | unknown
  gender                 String?
  maritalStatus          String?
  nationality            String?
  occupation             String?
  phone                  String?
  alternativePhone       String?
  email                  String?
  address                String?
  city                   String?
  region                 String?
  country                String?
  preferredLanguage      String?
  photoUrl               String?
  bloodGroup             String?
  status                 String       @default("active") // active | inactive | merged | deceased
  registeredAtFacilityId String?
  registeredBy           String?
  registrationDate       DateTime     @default(now())
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  identifiers                   PatientIdentifier[]
  contacts                      PatientContact[]
  emergencyContacts             EmergencyContact[]
  nextOfKin                     NextOfKin[]
  insurance                     PatientInsurance[]
  encounters                    Encounter[]
  appointments                  Appointment[]
  triageRecords                 TriageRecord[]
  vitalSigns                    VitalSign[]
  consultations                 Consultation[]
  diagnoses                     Diagnosis[]
  allergies                     Allergy[]
  medicalHistory                MedicalHistory[]
  surgicalHistory               SurgicalHistory[]
  familyHistory                 FamilyHistory[]
  socialHistory                 SocialHistory[]
  immunizations                 Immunization[]
  aefiRecords                   AEFI[]
  // Maternity back-relations
  ancVisits                     AncVisit[]
  laborAndDeliveries            LaborAndDelivery[]             @relation("laborPatient")
  postnatalVisits               PostnatalVisit[]               @relation("postnatalPatient")
  // Ambulance back-relation
  ambulanceTrips                AmbulanceTrip[]
  labOrders                     LabOrder[]
  imagingOrders                 ImagingOrder[]
  procedures                    Procedure[]
  prescriptions                 Prescription[]
  medicationAdministrations     MedicationAdministration[]
  admissions                    Admission[]
  referralsFrom                 Referral[]                     @relation("refPatientFrom")
  referralsTo                   Referral[]                     @relation("refPatientTo")
  patientTransfers              PatientTransfer[]
  nursingNotes                  NursingNote[]
  carePlans                     CarePlan[]
  documents                     Document[]
  consents                      Consent[]
  invoices                      Invoice[]
  payments                      Payment[]
  insuranceClaims               InsuranceClaim[]
  maternityRecords              MaternityRecord[]
  newbornRecords                NewbornRecord[]                @relation("newbornMother")
  bedAssignments                BedAssignment[]
  discharges                    DischargeRecord[]
  breakGlassEvents              BreakGlassEvent[]
  accessLogs                    PatientAccessLog[]
  eligibilityVerifications      EligibilityVerification[]
  waitingList                   WaitingList[]
  mergeEventsSource             PatientMergeEvent[]            @relation("mergeSource")
  mergeEventsTarget             PatientMergeEvent[]            @relation("mergeTarget")
  tasks                         Task[]
  queueEntries                  QueueEntry[]
  intakeOutputEntries           IntakeOutputEntry[]
  intakeOutputMonitoringPeriods IntakeOutputMonitoringPeriod[]
  intakeOutputAlerts            IntakeOutputAlert[]
  // Ward Round back-relations
  wardRoundPatients             WardRoundPatient[]
  wardRoundNotes                WardRoundNote[]
  wardRoundActions              WardRoundAction[]
  creditNotes                   CreditNote[]

  @@unique([organizationId, patientNumber])
}

model PatientIdentifier {
  id               String    @id @default(cuid())
  patientId        String
  patient          Patient   @relation(fields: [patientId], references: [id])
  identifierType   String // ghana_card | passport | insurance_number | national_id | hospital_id | other
  identifierValue  String
  issuingAuthority String?
  isPrimary        Boolean   @default(false)
  verified         Boolean   @default(false)
  verifiedAt       DateTime?
  createdAt        DateTime  @default(now())

  @@unique([identifierType, identifierValue])
  @@index([patientId])
}

model PatientContact {
  id               String   @id @default(cuid())
  patientId        String
  patient          Patient  @relation(fields: [patientId], references: [id])
  contactType      String? // parent | spouse | sibling | guardian | caregiver | other
  name             String
  relationship     String?
  phone            String?
  alternativePhone String?
  email            String?
  address          String?
  isPrimary        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([patientId])
}

model EmergencyContact {
  id               String   @id @default(cuid())
  patientId        String
  patient          Patient  @relation(fields: [patientId], references: [id])
  name             String
  relationship     String?
  phone            String?
  alternativePhone String?
  address          String?
  isPrimary        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([patientId])
}

model NextOfKin {
  id               String   @id @default(cuid())
  patientId        String
  patient          Patient  @relation(fields: [patientId], references: [id])
  name             String
  relationship     String?
  phone            String?
  alternativePhone String?
  email            String?
  address          String?
  isPrimary        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([patientId])
}

model InsuranceProvider {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  name             String
  code             String
  // ---- Extended master fields ----
  legalName        String?
  shortName        String?
  displayName      String?
  providerType     String       @default("private") // nhis | private | corporate | managed_care | employer_sponsored | government | institutional | self_funded | other
  organizationType String?
  country          String?
  region           String?
  phone            String?
  email            String?
  website          String?
  address          String?
  postalAddress    String?
  contactPerson    String?
  claimsContact    String?
  financeContact   String?
  // Status & dates
  status           String       @default("active") // active | inactive | suspended | pending | expired | terminated | retired
  effectiveDate    DateTime?
  endDate          DateTime?
  notes            String?
  settings         String?
  // Versioning / ownership
  createdById      String?
  updatedById      String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  patientInsurance      PatientInsurance[]
  insuranceClaims       InsuranceClaim[]
  plans                 InsurancePlan[]
  contacts              ProviderContact[]
  facilityRelationships ProviderFacilityRelationship[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, providerType])
}

// ---------------------------------------------------------------------
// INSURANCE PLAN — a provider may have multiple plans
// ---------------------------------------------------------------------

model InsurancePlan {
  id                    String            @id @default(cuid())
  organizationId        String
  insuranceProviderId   String
  insuranceProvider     InsuranceProvider @relation(fields: [insuranceProviderId], references: [id], onDelete: Cascade)
  code                  String
  name                  String
  shortName             String?
  description           String?
  planType              String            @default("individual") // individual | family | corporate | employer | government | nhis | managed_care | other
  // Coverage configuration
  coveragePercentage    Float? // e.g., 80 means payer covers 80%
  fixedCopayment        Float? // fixed copayment amount
  deductible            Float? // deductible amount
  annualLimit           Float? // annual monetary limit
  visitLimit            Int? // number of visits per period
  // Authorization / referral rules
  authorizationRequired Boolean           @default(false)
  referralRequired      Boolean           @default(false)
  // Status & dates
  status                String            @default("active") // active | inactive | suspended | expired | retired
  effectiveDate         DateTime?
  endDate               DateTime?
  coverageRules         String? // JSON: configurable coverage rules
  notes                 String?
  // Ownership
  createdById           String?
  updatedById           String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  serviceCoverage PlanServiceCoverage[]
  benefits        PlanBenefit[]
  authorizations  InsuranceAuthorization[]

  @@unique([organizationId, code])
  @@index([insuranceProviderId])
  @@index([organizationId, status])
}

// ---------------------------------------------------------------------
// PLAN SERVICE COVERAGE — links plan to Services & Pricing
// (does NOT duplicate the service catalog — only stores coverage rules)
// ---------------------------------------------------------------------

model PlanServiceCoverage {
  id                    String        @id @default(cuid())
  insurancePlanId       String
  insurancePlan         InsurancePlan @relation(fields: [insurancePlanId], references: [id], onDelete: Cascade)
  serviceId             String? // FK → Service (optional; null = rule applies to all services)
  coverageType          String        @default("covered") // covered | partially_covered | not_covered | authorization_required | referral_required
  coveragePercentage    Float? // override plan-level percentage for this service
  fixedCopayment        Float? // service-specific copayment
  patientResponsibility Float? // percentage patient pays
  quantityLimit         Int? // max quantity per period
  monetaryLimit         Float? // max amount per period
  notes                 String?
  status                String        @default("active")
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([insurancePlanId])
  @@index([serviceId])
}

// ---------------------------------------------------------------------
// PLAN BENEFIT — configurable benefit categories
// ---------------------------------------------------------------------

model PlanBenefit {
  id                 String        @id @default(cuid())
  insurancePlanId    String
  insurancePlan      InsurancePlan @relation(fields: [insurancePlanId], references: [id], onDelete: Cascade)
  benefitCategory    String // outpatient | inpatient | pharmacy | laboratory | imaging | procedures | maternity | dental | optical | emergency | other
  covered            Boolean       @default(true)
  coveragePercentage Float?
  annualLimit        Float?
  visitLimit         Int?
  notes              String?
  status             String        @default("active")
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([insurancePlanId])
  @@index([benefitCategory])
}

// ---------------------------------------------------------------------
// PROVIDER CONTACT — multiple contacts per provider
// ---------------------------------------------------------------------

model ProviderContact {
  id                  String            @id @default(cuid())
  insuranceProviderId String
  insuranceProvider   InsuranceProvider @relation(fields: [insuranceProviderId], references: [id], onDelete: Cascade)
  contactType         String            @default("general") // general | claims | finance | authorization | technical | management
  name                String
  position            String?
  phone               String?
  email               String?
  notes               String?
  status              String            @default("active")
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([insuranceProviderId])
  @@index([contactType])
}

// ---------------------------------------------------------------------
// PROVIDER-FACILITY RELATIONSHIP — multi-facility availability
// ---------------------------------------------------------------------

model ProviderFacilityRelationship {
  id                  String            @id @default(cuid())
  insuranceProviderId String
  insuranceProvider   InsuranceProvider @relation(fields: [insuranceProviderId], references: [id], onDelete: Cascade)
  facilityId          String
  availability        String            @default("available") // available | unavailable | pending
  acceptedPlans       String? // JSON array of plan IDs accepted at this facility
  contractReference   String?
  effectiveDate       DateTime?
  endDate             DateTime?
  notes               String?
  status              String            @default("active")
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@unique([insuranceProviderId, facilityId])
  @@index([facilityId])
}

// ---------------------------------------------------------------------
// INSURANCE AUTHORIZATION / PRE-AUTHORIZATION
// ---------------------------------------------------------------------

model InsuranceAuthorization {
  id                  String         @id @default(cuid())
  organizationId      String
  insuranceProviderId String
  insurancePlanId     String?
  insurancePlan       InsurancePlan? @relation(fields: [insurancePlanId], references: [id], onDelete: SetNull)
  patientId           String?
  serviceId           String? // FK → Service
  authorizationNumber String?
  authorizationDate   DateTime?
  expiryDate          DateTime?
  approvedService     String?
  approvedQuantity    Int?
  approvedAmount      Float?
  status              String         @default("pending") // pending | approved | rejected | expired | cancelled
  notes               String?
  authorizedById      String?
  patientInsuranceId  String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([insuranceProviderId])
  @@index([patientId])
  @@index([status])
}

model PatientInsurance {
  id                      String            @id @default(cuid())
  patientId               String
  patient                 Patient           @relation(fields: [patientId], references: [id])
  insuranceProviderId     String
  insuranceProvider       InsuranceProvider @relation(fields: [insuranceProviderId], references: [id])
  membershipNumber        String?
  policyNumber            String?
  principalMember         String?
  relationshipToPrincipal String?
  coverageStart           DateTime?
  coverageEnd             DateTime?
  verificationStatus      String            @default("pending") // pending | verified | rejected | expired
  verifiedAt              DateTime?
  status                  String            @default("active")
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  @@index([patientId])
}

// ---------------------------------------------------------------------
// ENCOUNTERS (FACILITY-SPECIFIC, LINKS PATIENT → FACILITY)
// ---------------------------------------------------------------------

model Encounter {
  id               String      @id @default(cuid())
  patientId        String
  patient          Patient     @relation(fields: [patientId], references: [id])
  facilityId       String
  facility         Facility    @relation(fields: [facilityId], references: [id])
  departmentId     String?
  department       Department? @relation(fields: [departmentId], references: [id])
  unitId           String?
  encounterNumber  String // ENC-2026-000001
  encounterType    String // opd | emergency | inpatient | follow_up | laboratory | pharmacy | imaging | procedure | maternity | other
  status           String      @default("open") // open | in_progress | completed | cancelled | admitted | discharged
  priority         String      @default("routine") // routine | urgent | emergency
  attendingStaffId String?
  startAt          DateTime    @default(now())
  endAt            DateTime?
  createdById      String?
  createdBy        User?       @relation("encounterCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  triageRecords             TriageRecord[]
  vitalSigns                VitalSign[]
  consultations             Consultation[]
  diagnoses                 Diagnosis[]
  labOrders                 LabOrder[]
  imagingOrders             ImagingOrder[]
  procedures                Procedure[]
  prescriptions             Prescription[]
  admissions                Admission[]
  nursingNotes              NursingNote[]
  carePlans                 CarePlan[]
  referrals                 Referral[]
  invoices                  Invoice[]
  documents                 Document[]
  consents                  Consent[]
  queueEntries              QueueEntry[]
  medicationAdministrations MedicationAdministration[]
  tasks                     Task[]
  maternityRecords          MaternityRecord[]
  intakeOutputEntries       IntakeOutputEntry[]

  @@unique([facilityId, encounterNumber])
  @@index([patientId, facilityId])
  @@index([facilityId, status, startAt])
}

model Appointment {
  id                String      @id @default(cuid())
  patientId         String
  patient           Patient     @relation(fields: [patientId], references: [id])
  facilityId        String
  facility          Facility    @relation(fields: [facilityId], references: [id])
  departmentId      String?
  department        Department? @relation(fields: [departmentId], references: [id])
  unitId            String? // Specific unit within the department
  unit              Unit?       @relation(fields: [unitId], references: [id])
  staffId           String?
  serviceId         String? // Link to a specific service
  appointmentNumber String
  appointmentType   String? // new | follow_up | walk_in | telemedicine | recurring
  scheduledStart    DateTime
  scheduledEnd      DateTime?
  status            String      @default("scheduled") // scheduled | confirmed | checked_in | in_progress | completed | cancelled | no_show
  reason            String?
  notes             String?
  createdById       String?
  createdBy         User?       @relation("apptBookedBy", fields: [createdById], references: [id])
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  history AppointmentHistory[]

  @@unique([facilityId, appointmentNumber])
  @@index([patientId])
  @@index([facilityId, scheduledStart, status])
  @@index([staffId])
  @@index([status])
}

// ---------------------------------------------------------------------
// CLINICIAN SCHEDULE — Working hours per clinician per day
// ---------------------------------------------------------------------
model ClinicianSchedule {
  id               String   @id @default(cuid())
  organizationId   String
  staffId          String // links to Staff record
  staffName        String?
  facilityId       String?
  departmentId     String?
  dayOfWeek        String // MON | TUE | WED | THU | FRI | SAT | SUN
  startTime        String // "08:00"
  endTime          String // "17:00"
  breakStart       String? // "12:00"
  breakEnd         String? // "12:30"
  slotDurationMin  Int      @default(30)
  maxDailyBookings Int      @default(20)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([organizationId, staffId])
  @@index([organizationId, facilityId])
}

// ---------------------------------------------------------------------
// CLINIC SESSION — Specific clinic session (e.g., Cardiology Monday AM)
// ---------------------------------------------------------------------
model ClinicSession {
  id              String   @id @default(cuid())
  organizationId  String
  facilityId      String?
  departmentId    String?
  staffId         String?
  staffName       String?
  sessionName     String // e.g., "Cardiology Clinic"
  specialty       String? // e.g., CARDIO
  dayOfWeek       String // MON | TUE | WED | THU | FRI | SAT | SUN
  startTime       String // "08:00"
  endTime         String // "13:00"
  slotDurationMin Int      @default(15)
  maxBookings     Int      @default(20)
  room            String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId, facilityId])
  @@index([organizationId, specialty])
  @@index([organizationId, dayOfWeek])
}

// ---------------------------------------------------------------------
// BLOCKED SLOT — Time slots blocked by admin/clinician
// ---------------------------------------------------------------------
model BlockedSlot {
  id             String   @id @default(cuid())
  organizationId String
  facilityId     String?
  staffId        String?
  blockedDate    DateTime
  startTime      String // "10:00"
  endTime        String // "11:00"
  reason         String // e.g., "Administrative meeting", "Training"
  blockedById    String?
  blockedByName  String?
  createdAt      DateTime @default(now())

  @@index([organizationId, facilityId, blockedDate])
  @@index([organizationId, staffId, blockedDate])
}

// ---------------------------------------------------------------------
// WAITING LIST — Patients waiting for an available slot
// ---------------------------------------------------------------------
model WaitingList {
  id             String    @id @default(cuid())
  organizationId String
  patientId      String
  patient        Patient   @relation(fields: [patientId], references: [id])
  facilityId     String?
  departmentId   String?
  staffId        String?
  specialty      String?
  preferredDate  DateTime?
  preferredTime  String? // "morning" | "afternoon" | "any"
  priority       String    @default("routine") // routine | urgent | high
  contactMethod  String    @default("phone") // phone | sms | email
  notes          String?
  status         String    @default("waiting") // waiting | notified | booked | cancelled
  notifiedAt     DateTime?
  bookedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, facilityId, status])
}

// ---------------------------------------------------------------------
// APPOINTMENT HISTORY — Audit trail of appointment changes
// ---------------------------------------------------------------------
model AppointmentHistory {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  action        String // created | confirmed | rescheduled | cancelled | checked_in | completed | no_show | modified
  fromStatus    String?
  toStatus      String?
  fromDateTime  DateTime?
  toDateTime    DateTime?
  reason        String?
  changedById   String?
  changedByName String?
  changedAt     DateTime    @default(now())

  @@index([appointmentId])
}

model Queue {
  id           String      @id @default(cuid())
  facilityId   String
  facility     Facility    @relation(fields: [facilityId], references: [id])
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  unitId       String? // Unit-specific queue
  unit         Unit?       @relation(fields: [unitId], references: [id])
  queueDate    DateTime    @default(now())
  queueType    String? // registration | triage | consultation | lab | pharmacy | imaging | billing
  status       String      @default("active") // active | closed
  createdAt    DateTime    @default(now())

  entries QueueEntry[]
}

model QueueEntry {
  id              String     @id @default(cuid())
  queueId         String
  queue           Queue      @relation(fields: [queueId], references: [id])
  patientId       String
  patient         Patient    @relation(fields: [patientId], references: [id])
  encounterId     String?
  encounter       Encounter? @relation(fields: [encounterId], references: [id])
  appointmentId   String? // Link to appointment if applicable
  queueNumber     Int
  priority        String     @default("routine") // routine | urgent | emergency
  status          String     @default("waiting") // waiting | called | in_progress | on_hold | completed | skipped | cancelled
  calledAt        DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  onHoldAt        DateTime? // When put on hold
  resumedAt       DateTime? // When resumed from hold
  assignedStaffId String?
  serviceId       String? // Which service the patient is queuing for
  notes           String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([queueId, queueNumber])
  @@index([queueId, status])
}

// ---------------------------------------------------------------------
// CLINICAL — TRIAGE, VITALS, CONSULTATIONS, DIAGNOSES, ALLERGIES, HISTORY
// ---------------------------------------------------------------------

model TriageRecord {
  id                  String    @id @default(cuid())
  encounterId         String
  encounter           Encounter @relation(fields: [encounterId], references: [id])
  patientId           String
  patient             Patient   @relation(fields: [patientId], references: [id])
  temperature         Float?
  pulse               Int?
  respiratoryRate     Int?
  systolicBp          Int?
  diastolicBp         Int?
  oxygenSaturation    Float?
  weight              Float?
  height              Float?
  bmi                 Float?
  bloodGlucose        Float?
  painScore           Int?
  consciousnessLevel  String? // GCS or AVPU
  triageCategory      String? // 1_immediate | 2_urgent | 3_standard | 4_non_urgent
  chiefComplaint      String?
  notes               String?
  // Enhanced triage fields
  generalAppearance   String? // alert | distressed | confused | lethargic | unresponsive
  painLocation        String?
  painCharacter       String?
  gcsEye              Int? // 1-4
  gcsVerbal           Int? // 1-5
  gcsMotor            Int? // 1-6
  gcsTotal            Int? // 3-15 (auto-calculated)
  isReassessment      Boolean   @default(false)
  parentTriageId      String? // link to original triage if reassessment
  abnormalVitalsAlert String? // JSON array of abnormal vital warnings
  escalationLevel     String? // none | nurse | clinician | emergency_team
  escalationReason    String?
  recordedById        String?
  recordedBy          User?     @relation("triageNurse", fields: [recordedById], references: [id])
  recordedAt          DateTime  @default(now())
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([patientId])
  @@index([encounterId])
  @@index([triageCategory])
  @@index([isReassessment])
}

model VitalSign {
  id               String    @id @default(cuid())
  patientId        String
  patient          Patient   @relation(fields: [patientId], references: [id])
  encounterId      String
  encounter        Encounter @relation(fields: [encounterId], references: [id])
  temperature      Float?
  pulse            Int?
  respiratoryRate  Int?
  systolicBp       Int?
  diastolicBp      Int?
  oxygenSaturation Float?
  weight           Float?
  height           Float?
  bmi              Float?
  bloodGlucose     Float?
  painScore        Int?
  recordedById     String?
  recordedBy       User?     @relation("vitalSignAuthor", fields: [recordedById], references: [id])
  recordedAt       DateTime  @default(now())
  createdAt        DateTime  @default(now())

  @@index([patientId, recordedAt])
  @@index([encounterId])
}

model Consultation {
  id                       String    @id @default(cuid())
  encounterId              String
  encounter                Encounter @relation(fields: [encounterId], references: [id])
  patientId                String
  patient                  Patient   @relation(fields: [patientId], references: [id])
  clinicianId              String?
  clinician                User?     @relation("consultationClinician", fields: [clinicianId], references: [id])
  chiefComplaint           String?
  historyPresentingIllness String?
  pastMedicalHistory       String?
  pastSurgicalHistory      String?
  medicationHistory        String?
  familyHistory            String?
  socialHistory            String?
  reviewOfSystems          String?
  physicalExamination      String?
  assessment               String?
  treatmentPlan            String?
  followUpPlan             String?
  status                   String    @default("draft") // draft | signed | amended
  signedById               String?
  signedAt                 DateTime?
  // Enhanced consultation fields
  disposition              String? // outpatient | admission | referral | follow_up | pharmacy | lab | imaging | procedure | discharge | emergency | other
  dispositionNotes         String?
  patientInstructions      String?
  addendumText             String?
  addendumById             String?
  addendumAt               DateTime?
  consultationStart        DateTime? // when clinician started the consultation
  consultationEnd          DateTime? // when finalized
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@index([patientId])
  @@index([encounterId])
  @@index([status])
  @@index([disposition])
}

model Diagnosis {
  id                 String            @id @default(cuid())
  patientId          String
  patient            Patient           @relation(fields: [patientId], references: [id])
  encounterId        String
  encounter          Encounter         @relation(fields: [encounterId], references: [id])
  // Link to the master catalog (optional — historical records may be free-text)
  catalogId          String?
  catalog            DiagnosisCatalog? @relation(fields: [catalogId], references: [id])
  // Snapshotted code + name at time of recording (preserves history even if catalog changes)
  diagnosisCode      String? // ICD-10 / ICD-11 / SNOMED CT
  codeSystem         String?           @default("ICD-10") // ICD-10 | ICD-11 | SNOMED_CT | LOCAL | OTHER
  diagnosisName      String
  diagnosisType      String            @default("primary") // primary | secondary | differential | provisional | confirmed | final | principal | admission | discharge | working | historical
  clinicalStatus     String            @default("active") // active | resolved | relapse | inactive | ruled_out
  verificationStatus String            @default("confirmed") // unconfirmed | provisional | differential | confirmed | refuted
  isPrimary          Boolean           @default(false)
  isChronic          Boolean           @default(false)
  onsetDate          DateTime?
  resolvedDate       DateTime?
  diagnosedById      String?
  diagnosedAt        DateTime          @default(now())
  notes              String?
  // Amendment tracking
  amendedFromId      String?
  amendmentReason    String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  statusHistory            DiagnosisStatusHistory[]
  referralPrimaryDiagnoses Referral[]               @relation("referralPrimaryDiagnosis")

  @@index([patientId])
  @@index([encounterId])
  @@index([catalogId])
  @@index([diagnosisCode])
  @@index([clinicalStatus])
}

// ---------------------------------------------------------------------
// DIAGNOSIS CATALOG — Master list of standardized diagnoses
// (ICD-10, ICD-11, SNOMED CT, local codes)
// ---------------------------------------------------------------------
model DiagnosisCatalog {
  id               String   @id @default(cuid())
  organizationId   String
  code             String // e.g., I10, E11, J00
  codeSystem       String   @default("ICD-10") // ICD-10 | ICD-11 | SNOMED_CT | LOCAL | OTHER
  name             String // Standardized name
  description      String?
  category         String? // e.g., cardiovascular, endocrine, respiratory
  parentCategory   String? // higher-level grouping
  synonyms         String? // JSON array of strings: ["HTN", "High BP", "Hypertension"]
  searchTerms      String? // JSON array — additional searchable keywords
  sexRestriction   String? // null | male | female — informational only, does NOT block
  minAgeYears      Int? // informational only — does NOT block
  maxAgeYears      Int? // informational only — does NOT block
  isChronicDefault Boolean  @default(false) // hint that this is typically chronic
  specialty        String? // e.g., CARDIO, DERM — for specialty filtering
  isActive         Boolean  @default(true)
  version          String? // terminology version (e.g., "2024", "ICD-10-2023")
  source           String? // e.g., "WHO", "Local"
  // Ghana NHIS compliance fields
  nhisGdrgCode     String? // Ghana Diagnostic Related Groupings code (e.g., "GD-701")
  nhisGdrgName     String? // G-DRG description
  nhisTariff       Float? // NHIS tariff amount (GHS) for this diagnosis group
  isNhisClaimable  Boolean  @default(true) // whether this diagnosis is covered by NHIS
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  encounterDiagnoses Diagnosis[]
  claimDiagnoses     ClaimDiagnosis[]
  favorites          DiagnosisFavorite[]

  @@unique([organizationId, code, codeSystem])
  @@index([organizationId, category])
  @@index([organizationId, specialty])
  @@index([organizationId, isActive])
  @@index([organizationId, isNhisClaimable])
}

// ---------------------------------------------------------------------
// DIAGNOSIS STATUS HISTORY — Audit trail of status changes
// ---------------------------------------------------------------------
model DiagnosisStatusHistory {
  id               String    @id @default(cuid())
  diagnosisId      String
  diagnosis        Diagnosis @relation(fields: [diagnosisId], references: [id], onDelete: Cascade)
  fromStatus       String?
  toStatus         String
  fromVerification String?
  toVerification   String?
  changedById      String?
  changedByName    String?
  reason           String?
  changedAt        DateTime  @default(now())

  @@index([diagnosisId])
}

// ---------------------------------------------------------------------
// DIAGNOSIS FAVORITES — Per-clinician favorites for fast access
// ---------------------------------------------------------------------
model DiagnosisFavorite {
  id        String           @id @default(cuid())
  userId    String
  catalogId String
  catalog   DiagnosisCatalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())

  @@unique([userId, catalogId])
  @@index([userId])
}

model Allergy {
  id           String   @id @default(cuid())
  patientId    String
  patient      Patient  @relation(fields: [patientId], references: [id])
  allergen     String
  reaction     String?
  severity     String? // mild | moderate | severe | anaphylactic
  status       String   @default("active") // active | inactive | resolved
  verified     Boolean  @default(false)
  recordedById String?
  recordedBy   User?    @relation("allergiesRecorded", fields: [recordedById], references: [id])
  recordedAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([patientId])
}

model MedicalHistory {
  id            String    @id @default(cuid())
  patientId     String
  patient       Patient   @relation(fields: [patientId], references: [id])
  condition     String
  description   String?
  diagnosedDate DateTime?
  resolvedDate  DateTime?
  status        String    @default("active") // active | resolved | chronic | inactive
  recordedById  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([patientId])
}

model SurgicalHistory {
  id            String    @id @default(cuid())
  patientId     String
  patient       Patient   @relation(fields: [patientId], references: [id])
  procedureName String
  procedureDate DateTime?
  facility      String?
  surgeon       String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([patientId])
}

model FamilyHistory {
  id           String   @id @default(cuid())
  patientId    String
  patient      Patient  @relation(fields: [patientId], references: [id])
  relationship String
  condition    String
  notes        String?
  recordedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([patientId])
}

model SocialHistory {
  id               String   @id @default(cuid())
  patientId        String
  patient          Patient  @relation(fields: [patientId], references: [id])
  smokingStatus    String?
  alcoholStatus    String?
  occupation       String?
  livingSituation  String?
  otherInformation String?
  recordedById     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([patientId])
}

// ---------------------------------------------------------------------
// MEDICATIONS, PRESCRIPTIONS, ADMINISTRATION
// ---------------------------------------------------------------------

model Medication {
  id                   String       @id @default(cuid())
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id])
  // Core identification
  genericName          String
  brandName            String?
  strength             String? // e.g. "500mg", "250mg/5mL", "100mg/mL"
  strengthValue        Float? // Numeric strength for structured search
  strengthUnit         String? // mg | mL | % | IU | mcg
  dosageForm           String? // tablet | capsule | syrup | suspension | injection | cream | ointment | gel | drops | suppository | powder | sachet | inhaler | patch | other
  route                String? // oral | iv | im | sc | topical | rectal | vaginal | ophthalmic | otic | nasal | inhalation | sublingual | buccal | other
  unit                 String?
  description          String?
  // Classification
  medicationCategory   String? // analgesics | antibiotics | antimalarials | antihypertensives | antidiabetics | antihistamines | antacids | antiemetics | antifungals | antivirals | cardiovascular | respiratory | dermatological | obstetric | paediatric | emergency | surgical | vitamins_supplements | other
  therapeuticClass     String? // e.g. "Penicillin", "NSAID", "ACE inhibitor"
  atcCode              String? // WHO ATC code (e.g. N02BE01 for paracetamol)
  // Identification codes
  barcode              String? // GTIN/EAN/UPC barcode
  productCode          String? // Internal product code / SKU
  nhisCode             String? // NHIS tariff code (e.g. ACETAZTA1)
  nhisTariffAmount     Float? // NHIS reimbursable price in GHS
  nhisPrescribingLevel String? // NHIS prescribing level (A | B1 | B2 | C | D | M)
  nhisUnitOfPricing    String? // NHIS unit of pricing (e.g. Tablet, Vial, Ampoule)
  // Manufacturer
  manufacturer         String?
  countryOfOrigin      String?
  // Safety flags
  prescriptionStatus   String?      @default("prescription_required") // otc | prescription_required | restricted
  controlledStatus     String? // none | class_a | class_b | class_c | class_d
  isHighAlert          Boolean      @default(false) // ISMP high-alert medication
  pregnancyCategory    String? // A | B | C | D | X | unknown
  lactationSafety      String? // safe | use_with_caution | avoid | unknown
  // Defaults for prescribing
  defaultDose          String?
  defaultFrequency     String?
  defaultRoute         String?
  defaultDuration      String?
  // Formulary
  formularyStatus      String?      @default("formulary") // formulary | non_formulary | restricted | not_available
  // Storage
  storageConditions    String? // room_temp | refrigerate | freeze | cold_chain
  // Status & lifecycle
  status               String       @default("active") // active | inactive | discontinued | restricted | temporarily_unavailable
  // Ownership
  createdById          String?
  createdBy            User?        @relation("medicationCreator", fields: [createdById], references: [id])
  updatedById          String?
  updatedBy            User?        @relation("medicationUpdater", fields: [updatedById], references: [id])
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  prescriptionItems PrescriptionItem[]
  administrations   MedicationAdministration[]
  inventoryItems    InventoryItem[]            @relation("medicationInventoryItem")
  interactionsA     MedicationInteraction[]    @relation("interactionMedA")
  interactionsB     MedicationInteraction[]    @relation("interactionMedB")

  @@index([organizationId, status])
  @@index([organizationId, genericName])
  @@index([organizationId, therapeuticClass])
  @@index([organizationId, medicationCategory])
  @@index([barcode])
  @@index([nhisCode])
}

// =====================================================================
// MEDICATION INTERACTION — Drug-drug interaction rules
// =====================================================================
// Configurable interaction pairs. When a prescription is created, the
// system checks the patient's active medications against this table.
// Interactions are warnings only — they never block prescribing.
model MedicationInteraction {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id])
  // The two medications (or therapeutic classes) that interact
  medicationAId     String?
  medicationA       Medication?  @relation("interactionMedA", fields: [medicationAId], references: [id])
  medicationBId     String?
  medicationB       Medication?  @relation("interactionMedB", fields: [medicationBId], references: [id])
  // Alternatively, match by therapeutic class (e.g. "NSAID" + "Warfarin")
  therapeuticClassA String? // e.g. "NSAID", "ACE inhibitor"
  therapeuticClassB String? // e.g. "Anticoagulant"
  // Interaction details
  severity          String       @default("moderate") // mild | moderate | severe | contraindicated
  description       String // What happens
  clinicalAdvice    String? // What to do (e.g. "Monitor INR closely", "Consider alternative")
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([organizationId, isActive])
  @@index([medicationAId])
  @@index([medicationBId])
  @@index([therapeuticClassA, therapeuticClassB])
}

model Prescription {
  id                   String    @id @default(cuid())
  patientId            String
  patient              Patient   @relation(fields: [patientId], references: [id])
  encounterId          String
  encounter            Encounter @relation(fields: [encounterId], references: [id])
  prescriptionNumber   String
  prescriberId         String?
  prescriber           User?     @relation("rxPrescriber", fields: [prescriberId], references: [id])
  facilityId           String
  facility             Facility  @relation(fields: [facilityId], references: [id])
  status               String    @default("pending") // draft | pending | approved | partially_dispensed | dispensed | cancelled | discontinued
  prescribedAt         DateTime  @default(now())
  finalizedAt          DateTime?
  discontinuedAt       DateTime?
  discontinuedById     String?
  discontinuedReason   String?
  cancelledReason      String?
  notes                String?
  // Safety tracking
  allergyWarnings      String? // JSON array of allergy warnings shown
  duplicateWarnings    String? // JSON array of duplicate medication warnings
  interactionWarnings  String? // JSON array of drug-drug interaction warnings
  warningsAcknowledged Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  items PrescriptionItem[]

  @@unique([facilityId, prescriptionNumber])
  @@index([patientId, status])
  @@index([facilityId, status])
  @@index([status])
}

model PrescriptionItem {
  id                 String       @id @default(cuid())
  prescriptionId     String
  prescription       Prescription @relation(fields: [prescriptionId], references: [id])
  medicationId       String
  medication         Medication   @relation(fields: [medicationId], references: [id])
  dose               String?
  frequency          String? // BD | TDS | QDS | PRN | STAT | once weekly
  route              String?
  duration           String? // 5 days | 2 weeks | 1 month
  durationValue      Int? // numeric duration (e.g., 5)
  durationUnit       String? // days | weeks | months
  quantity           Int          @default(0)
  quantityCalculated Boolean      @default(false)
  instructions       String?
  isPRN              Boolean      @default(false)
  prnIndication      String? // condition for PRN use
  prnMaxFrequency    String? // max PRN frequency
  isSTAT             Boolean      @default(false)
  isOneTime          Boolean      @default(false)
  startDate          DateTime?
  endDate            DateTime?
  diagnosisId        String? // link to diagnosis/indication
  dispensedQuantity  Int          @default(0)
  status             String       @default("pending") // pending | dispensed | partially_dispensed | cancelled | discontinued
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  administrations MedicationAdministration[]
}

model MedicationAdministration {
  id                 String            @id @default(cuid())
  patientId          String
  patient            Patient           @relation(fields: [patientId], references: [id])
  encounterId        String
  encounter          Encounter         @relation(fields: [encounterId], references: [id])
  prescriptionItemId String?
  prescriptionItem   PrescriptionItem? @relation(fields: [prescriptionItemId], references: [id])
  medicationId       String
  medication         Medication        @relation(fields: [medicationId], references: [id])
  doseGiven          String?
  route              String?
  administeredById   String?
  administeredBy     User?             @relation(fields: [administeredById], references: [id])
  administeredAt     DateTime          @default(now())
  status             String            @default("given") // given | held | refused | missed
  notes              String?
  createdAt          DateTime          @default(now())

  @@index([patientId, administeredAt])
}

// ---------------------------------------------------------------------
// LABORATORY INFORMATION SYSTEM
// ---------------------------------------------------------------------

model LaboratoryTest {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  name             String
  code             String
  shortName        String?
  displayName      String?
  description      String?
  category         String? // haematology | chemistry | microbiology | serology | endocrinology | parasitology | urinalysis | histopathology | cytology | blood_bank | molecular | toxicology | other
  testType         String       @default("single") // single | panel | profile | culture | microscopy | quantitative | qualitative | semi_quantitative | molecular | pathology | other
  resultType       String       @default("numeric") // numeric | text | qualitative | pos_neg | reactive_nonreactive | detected_not_detected | categorical | structured | organism | titer | other
  specimenType     String? // primary specimen (legacy field — kept for back-compat with lab-orders/results)
  unit             String? // primary unit (legacy field — kept for back-compat)
  referenceRange   String? // primary reference range text (legacy field — kept for back-compat)
  price            Float        @default(0) // legacy default price (kept for back-compat; authoritative pricing via serviceId)
  status           String       @default("active") // active | inactive | retired | archived | temporarily_unavailable | referral_out
  priority         String       @default("routine") // routine | urgent | stat
  isPanel          Boolean      @default(false)
  isReferralOut    Boolean      @default(false)
  referralLab      String?
  isBillable       Boolean      @default(true)
  billableAs       String       @default("individual") // individual | package | component | parent_only
  // Turnaround time
  tatMinutes       Int? // expected TAT (minutes) — preferred single unit
  tatRoutineMin    Int?
  tatUrgentMin     Int?
  tatStatMin       Int?
  // Service / billing integration
  serviceId        String? // FK → Service (central pricing)
  nhisEligible     Boolean      @default(false)
  nhisServiceCode  String?
  nhisTariffRef    String?
  claimableStatus  String       @default("not_configured") // not_configured | claimable | non_claimable | pending
  // Versioning / ownership
  version          Int          @default(1)
  createdById      String?
  updatedById      String?
  retiredAt        DateTime?
  retiredById      String?
  retirementReason String?
  // JSONB-style config (kept for back-compat; structured fields preferred)
  configuration    String? // JSONB in PG
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  labOrderItems LabOrderItem[]

  // ---- Lab Test Catalog relations ----
  aliases              LabTestAlias[]
  specimenConfigs      LabTestSpecimenConfig[]
  components           LabTestComponent[]            @relation("LabTestComponentTest")
  panelMemberships     LabTestPanelMember[]          @relation("LabTestPanelParent")
  componentOfPanels    LabTestPanelMember[]          @relation("LabTestPanelComponent")
  referenceRanges      LabTestReferenceRange[]
  criticalValues       LabTestCriticalValue[]
  resultOptions        LabTestResultOption[]
  facilityAvailability LabTestFacilityAvailability[]
  versions             LabTestVersion[]
  catalogAudits        LabTestCatalogAudit[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, category])
  @@index([organizationId, testType])
  @@index([serviceId])
}

// ---------------------------------------------------------------------
// LAB TEST CATALOG — Master configuration models
// (Central master catalog for laboratory tests. Pricing is governed by
//  Service / FacilityServicePrice; this catalog only stores a serviceId
//  reference. Reference ranges are versioned so historical results retain
//  their applicable configuration at time of result entry.)
// ---------------------------------------------------------------------

model LabTestAlias {
  id               String         @id @default(cuid())
  laboratoryTestId String
  laboratoryTest   LaboratoryTest @relation(fields: [laboratoryTestId], references: [id], onDelete: Cascade)
  alias            String
  aliasType        String         @default("synonym") // abbreviation | synonym | common_name | search_alias
  createdAt        DateTime       @default(now())

  @@unique([laboratoryTestId, alias])
  @@index([alias])
}

model LabTestCategory {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  code           String
  description    String?
  sortOrder      Int      @default(0)
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, code])
  @@unique([organizationId, name])
}

model LabTestSpecimenType {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  code           String
  description    String?
  sortOrder      Int      @default(0)
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, code])
  @@unique([organizationId, name])
}

model LabTestUnit {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  code           String
  description    String?
  sortOrder      Int      @default(0)
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, code])
  @@unique([organizationId, name])
}

// Per-test specimen configuration (a test may have multiple acceptable specimens)
model LabTestSpecimenConfig {
  id                     String         @id @default(cuid())
  laboratoryTestId       String
  laboratoryTest         LaboratoryTest @relation(fields: [laboratoryTestId], references: [id], onDelete: Cascade)
  specimenType           String // e.g., Whole Blood | Serum | Plasma | Urine | Stool | Sputum | Swab | CSF | Tissue
  isPrimary              Boolean        @default(false)
  container              String?
  minVolume              String?
  collectionRequirements String?
  processingRequirements String?
  storageRequirements    String?
  transportRequirements  String?
  stabilityInfo          String?
  fastingRequired        Boolean        @default(false)
  timingRequired         String?
  specialPreparation     String?
  collectionNotes        String?
  sortOrder              Int            @default(0)
  status                 String         @default("active")
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  @@index([laboratoryTestId])
  @@index([specimenType])
}

// Component-level definition (also reusable as a standalone test by setting isStandalone=true)
model LabTestComponent {
  id               String         @id @default(cuid())
  laboratoryTestId String
  laboratoryTest   LaboratoryTest @relation("LabTestComponentTest", fields: [laboratoryTestId], references: [id], onDelete: Cascade)
  componentName    String
  componentCode    String?
  resultType       String         @default("numeric") // numeric | text | qualitative | pos_neg | reactive_nonreactive | categorical | other
  unit             String?
  referenceRange   String?
  criticalLow      Float?
  criticalHigh     Float?
  decimalPrecision Int?
  displayOrder     Int            @default(0)
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([laboratoryTestId])
}

// Many-to-many: a panel test ↔ component test (the component is itself a LaboratoryTest)
model LabTestPanelMember {
  id              String         @id @default(cuid())
  panelTestId     String
  panelTest       LaboratoryTest @relation("LabTestPanelParent", fields: [panelTestId], references: [id], onDelete: Cascade)
  componentTestId String
  componentTest   LaboratoryTest @relation("LabTestPanelComponent", fields: [componentTestId], references: [id], onDelete: Cascade)
  displayOrder    Int            @default(0)
  isActive        Boolean        @default(true)
  addedAt         DateTime       @default(now())
  removedAt       DateTime?

  @@unique([panelTestId, componentTestId])
  @@index([panelTestId])
  @@index([componentTestId])
}

// Versioned reference ranges — historical results retain applicable range via effectiveFrom/effectiveTo
model LabTestReferenceRange {
  id                  String         @id @default(cuid())
  laboratoryTestId    String
  laboratoryTest      LaboratoryTest @relation(fields: [laboratoryTestId], references: [id], onDelete: Cascade)
  label               String? // e.g., "Adult male", "Neonate", "Pregnant 1st trimester"
  sex                 String? // male | female | all | null=all
  ageGroup            String? // neonate | infant | child | adolescent | adult | older_adult | all
  ageMinDays          Int?
  ageMaxDays          Int?
  pregnancyApplicable Boolean        @default(false)
  specimenType        String?
  facilityId          String? // null = org-level default
  lowText             String? // e.g., "13.5"
  highText            String? // e.g., "17.5"
  rangeText           String? // full display text e.g., "13.5 - 17.5 g/dL"
  unit                String?
  criticalLowText     String?
  criticalHighText    String?
  notes               String?
  version             Int            @default(1)
  effectiveFrom       DateTime       @default(now())
  effectiveTo         DateTime?
  status              String         @default("active") // active | superseded | retired
  createdById         String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([laboratoryTestId])
  @@index([laboratoryTestId, sex, ageGroup])
  @@index([laboratoryTestId, effectiveFrom, effectiveTo])
}

// Critical value thresholds (separate from reference ranges; used for alert escalation)
model LabTestCriticalValue {
  id                   String         @id @default(cuid())
  laboratoryTestId     String
  laboratoryTest       LaboratoryTest @relation(fields: [laboratoryTestId], references: [id], onDelete: Cascade)
  sex                  String? // male | female | all | null=all
  ageGroup             String? // neonate | infant | child | adolescent | adult | older_adult | all
  ageMinDays           Int?
  ageMaxDays           Int?
  criticalLow          Float?
  criticalHigh         Float?
  alertType            String         @default("numeric") // numeric | qualitative | categorical
  alertValue           String? // for qualitative/categorical critical markers
  notificationBehavior String? // e.g., notify_clinician | notify_lab_manager | escalate
  notes                String?
  status               String         @default("active")
  createdById          String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([laboratoryTestId])
}

// Qualitative / categorical result options for a test (e.g., Positive, Negative, Reactive, Detected)
model LabTestResultOption {
  id               String         @id @default(cuid())
  laboratoryTestId String
  laboratoryTest   LaboratoryTest @relation(fields: [laboratoryTestId], references: [id], onDelete: Cascade)
  optionValue      String
  optionLabel      String?
  isCritical       Boolean        @default(false)
  displayOrder     Int            @default(0)
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())

  @@index([laboratoryTestId])
}

// Facility-specific availability / overrides (multi-facility support without duplicating the test)
model LabTestFacilityAvailability {
  id                     String         @id @default(cuid())
  laboratoryTestId       String
  laboratoryTest         LaboratoryTest @relation(fields: [laboratoryTestId], references: [id], onDelete: Cascade)
  facilityId             String
  availability           String         @default("available") // available | temporarily_unavailable | unavailable | referral_out
  performingDepartmentId String?
  facilityTatMinutes     Int?
  facilityReferralLab    String?
  facilityNotes          String?
  status                 String         @default("active")
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  @@unique([laboratoryTestId, facilityId])
  @@index([facilityId])
}

// Version history snapshot — captures the test configuration as it was at a point in time
model LabTestVersion {
  id               String         @id @default(cuid())
  laboratoryTestId String
  laboratoryTest   LaboratoryTest @relation(fields: [laboratoryTestId], references: [id], onDelete: Cascade)
  version          Int
  snapshot         String // JSON snapshot of test + components + ranges + critical values at version time
  changeSummary    String?
  changedById      String?
  createdAt        DateTime       @default(now())

  @@unique([laboratoryTestId, version])
  @@index([laboratoryTestId, version])
}

// Dedicated catalog audit log (complements the global AuditLog)
model LabTestCatalogAudit {
  id               String         @id @default(cuid())
  laboratoryTestId String
  laboratoryTest   LaboratoryTest @relation(fields: [laboratoryTestId], references: [id], onDelete: Cascade)
  organizationId   String
  facilityId       String?
  action           String // CREATED | UPDATED | ARCHIVED | REACTIVATED | RETIRED | SPECIMEN_CHANGED | RANGE_CHANGED | CRITICAL_CHANGED | PANEL_CHANGED | TAT_CHANGED | SERVICE_MAPPED | NHIS_MAPPED | BULK_IMPORT | BULK_UPDATE | DUPLICATE_MERGED
  previousValue    String?
  newValue         String?
  reason           String?
  userId           String?
  userRole         String?
  ipAddress        String?
  createdAt        DateTime       @default(now())

  @@index([laboratoryTestId, createdAt])
  @@index([organizationId, createdAt])
}

model LabOrder {
  id                   String    @id @default(cuid())
  patientId            String
  patient              Patient   @relation(fields: [patientId], references: [id])
  encounterId          String
  encounter            Encounter @relation(fields: [encounterId], references: [id])
  facilityId           String
  facility             Facility  @relation(fields: [facilityId], references: [id])
  orderingClinicianId  String?
  orderingClinician    User?     @relation("labOrderClinician", fields: [orderingClinicianId], references: [id])
  orderNumber          String
  status               String    @default("ordered") // ordered | collected | received | processing | resulted | verified | released | cancelled
  priority             String    @default("routine") // routine | urgent | stat
  orderedAt            DateTime  @default(now())
  notes                String?
  // ---- Diagnostic workflow extensions ----
  clinicalIndication   String? // structured indication / reason for order
  diagnosisRef         String? // diagnosis code or free-text reference
  departmentId         String? // ordering department
  // TAT timestamps (set as the order progresses)
  collectedAt          DateTime?
  receivedAt           DateTime?
  resultedAt           DateTime?
  verifiedAt           DateTime?
  releasedAt           DateTime?
  // Duplicate detection
  duplicateOfId        String? // points to a recent similar order for the same patient
  isDuplicateOverride  Boolean   @default(false) // clinician acknowledged duplicate and proceeded
  duplicateNote        String?
  // Recollection support
  recollectFromOrderId String? // if this order is a recollection of a previous cancelled/rejected order
  // Cancellation / rejection metadata
  cancelledAt          DateTime?
  cancelledById        String?
  cancellationReason   String?
  // Billing integration
  serviceInvoiceItemId String? // link to the generated invoice item (if any)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  items   LabOrderItem[]
  samples LabSample[]

  @@unique([facilityId, orderNumber])
  @@index([patientId, status])
  @@index([facilityId, status, orderedAt])
  @@index([facilityId, priority, orderedAt])
  @@index([orderingClinicianId])
  @@index([departmentId])
}

model LabOrderItem {
  id               String         @id @default(cuid())
  labOrderId       String
  labOrder         LabOrder       @relation(fields: [labOrderId], references: [id])
  laboratoryTestId String
  laboratoryTest   LaboratoryTest @relation(fields: [laboratoryTestId], references: [id])
  status           String         @default("ordered") // ordered | collected | processing | resulted | verified | released | cancelled
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  results LabResult[]
}

model LabSample {
  id                  String    @id @default(cuid())
  labOrderId          String
  labOrder            LabOrder  @relation(fields: [labOrderId], references: [id])
  sampleNumber        String
  specimenType        String?
  collectedById       String?
  collectedAt         DateTime?
  receivedById        String?
  receivedAt          DateTime?
  status              String    @default("pending") // pending | collected | received | rejected | processing | recollected
  rejectionReason     String?
  rejectionReasonCode String? // coded reason: insufficient | wrong_container | wrong_specimen | leakage | clotted | hemolysed | labeling | other
  rejectionNotes      String?
  rejectedById        String?
  rejectedAt          DateTime?
  // Recollection chain — link to the new sample that replaced this one
  recollectFromId     String? // if this sample is a recollection, points to the rejected sample it replaces
  collectionLocation  String?
  container           String?
  volume              String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([labOrderId, sampleNumber])
  @@index([status])
  @@index([recollectFromId])
}

model LabResult {
  id                       String       @id @default(cuid())
  labOrderItemId           String
  labOrderItem             LabOrderItem @relation(fields: [labOrderItemId], references: [id])
  resultValue              String?
  numericValue             Float?
  unit                     String?
  referenceRange           String?
  abnormalFlag             String? // normal | low | high | critical_low | critical_high | abnormal | positive | negative | reactive | non_reactive | detected | not_detected
  criticalFlag             Boolean      @default(false)
  // Auto-flagging source — was this flag computed from catalog reference ranges / critical values?
  flagSource               String       @default("manual") // manual | auto_ref_range | auto_critical_value | auto_result_option
  flagRangeApplied         String? // human-readable range used for auto-flagging (e.g., "13.5 - 17.5 g/dL")
  // Component-level support (for panel results)
  componentId              String? // FK → LabTestComponent (if this result is for a specific component)
  componentName            String? // denormalized for legacy queries
  // Result option support (for qualitative/categorical tests)
  resultOptionId           String? // FK → LabTestResultOption (if selected from configured options)
  // Comments
  resultNotes              String? // technical lab comment
  specimenComment          String? // specimen-quality comment
  clinicianComment         String? // clinician interpretation (separate from lab comment)
  // Performing lab / staff
  performingLab            String?
  performingStaffId        String?
  enteredById              String?
  verifiedById             String?
  enteredAt                DateTime?
  verifiedAt               DateTime?
  releasedAt               DateTime?
  releasedById             String?
  status                   String       @default("draft") // draft | entered | verified | released | amended | cancelled
  amendedFromId            String?
  amendmentReason          String?
  amendmentApprovedById    String?
  version                  Int          @default(1)
  // ---- Critical value acknowledgement workflow ----
  isCritical               Boolean      @default(false) // true if result meets configured critical thresholds
  criticalAcknowledgedById String?
  criticalAcknowledgedAt   DateTime?
  criticalAckMethod        String? // phone | in_person | electronic | other
  criticalAckNotes         String?
  criticalEscalationLevel  Int          @default(0) // 0 = not escalated, 1+ = escalation tiers
  notifiedUserIds          String? // JSON array of user IDs who were notified
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  @@index([labOrderItemId])
  @@index([status])
  @@index([isCritical])
  @@index([componentId])
}

// ---------------------------------------------------------------------
// IMAGING & PROCEDURES
// ---------------------------------------------------------------------

model ImagingOrder {
  id                  String    @id @default(cuid())
  patientId           String
  patient             Patient   @relation(fields: [patientId], references: [id])
  encounterId         String
  encounter           Encounter @relation(fields: [encounterId], references: [id])
  facilityId          String
  facility            Facility  @relation(fields: [facilityId], references: [id])
  orderingClinicianId String?
  orderingClinician   User?     @relation("imagingOrderClinician", fields: [orderingClinicianId], references: [id])
  procedureName       String
  procedureCode       String?
  // ---- Diagnostic imaging extensions ----
  modality            String? // x_ray | ultrasound | ct | mri | mammography | fluoroscopy | other
  bodySite            String? // e.g., Chest, Abdomen, Skull
  laterality          String? // left | right | bilateral | na
  contrastRequired    Boolean   @default(false)
  contrastNotes       String?
  clinicalIndication  String?
  diagnosisRef        String?
  departmentId        String?
  // Scheduling
  requestedAt         DateTime? // when the clinician wants it done
  scheduledAt         DateTime?
  scheduledById       String?
  imagingRoom         String?
  appointmentId       String? // link to existing Appointments system if booked
  patientArrivedAt    DateTime?
  // DICOM-ready fields (populated when study is performed)
  accessionNumber     String?
  studyInstanceUid    String?
  seriesInstanceUid   String?
  performedAt         DateTime?
  performedById       String?
  // Service / billing integration
  serviceId           String? // FK → Service (central pricing)
  priority            String    @default("routine")
  status              String    @default("ordered") // ordered | scheduled | arrived | in_progress | completed | reported | verified | released | cancelled | rescheduled | no_show
  orderedAt           DateTime  @default(now())
  notes               String?
  // Cancellation
  cancelledAt         DateTime?
  cancelledById       String?
  cancellationReason  String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  reports ImagingReport[]

  @@index([patientId, status])
  @@index([facilityId, status, orderedAt])
  @@index([facilityId, modality, status])
  @@index([accessionNumber])
  @@index([serviceId])
}

model ImagingReport {
  id                     String       @id @default(cuid())
  imagingOrderId         String // not unique — amendment chain preserves multiple versions
  imagingOrder           ImagingOrder @relation(fields: [imagingOrderId], references: [id])
  patientId              String
  // Structured report fields
  clinicalIndication     String?
  technique              String?
  findings               String?
  impression             String?
  recommendations        String?
  // Staff / timestamps
  reportedById           String?
  verifiedById           String?
  reportedAt             DateTime?
  verifiedAt             DateTime?
  releasedAt             DateTime?
  releasedById           String?
  status                 String       @default("draft") // draft | preliminary | final | verified | released | amended | cancelled
  // Amendment chain
  amendedFromId          String?
  amendmentReason        String?
  amendmentApprovedById  String?
  version                Int          @default(1)
  // Differential / follow-up
  differentialDiagnosis  String?
  followUpRecommendation String?
  isLatest               Boolean      @default(true) // marks the current/latest version of the report
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  @@index([imagingOrderId, isLatest])
  @@index([status])
  @@index([reportedById])
  @@index([amendedFromId])
}

model Procedure {
  id                   String    @id @default(cuid())
  patientId            String
  patient              Patient   @relation(fields: [patientId], references: [id])
  encounterId          String
  encounter            Encounter @relation(fields: [encounterId], references: [id])
  facilityId           String
  facility             Facility  @relation(fields: [facilityId], references: [id])
  // Catalog linkage (new)
  procedureCatalogId   String? // FK → ProcedureCatalog (optional; legacy free-text still supported)
  procedureCode        String?
  procedureName        String
  category             String? // minor | major | diagnostic | therapeutic | bedside | outpatient | inpatient | specialty
  // Request / scheduling / performance
  requestedById        String? // clinician who requested the procedure
  requestedAt          DateTime?
  scheduledAt          DateTime?
  scheduledById        String?
  procedureRoom        String?
  appointmentId        String? // link to existing Appointments system
  performedById        String?
  performedBy          User?     @relation("procedurePerformer", fields: [performedById], references: [id])
  performedAt          DateTime?
  // Clinical documentation
  indication           String?
  diagnosisRef         String?
  preProcedureNotes    String?
  findings             String?
  outcome              String?
  complications        String? // free-text or JSON list of complications
  specimensSent        String? // free-text or JSON list of specimens sent to lab
  consumablesUsed      String? // free-text or JSON list of consumables (links to inventory batches where configured)
  followUpInstructions String?
  consentStatus        String    @default("not_taken") // taken | not_taken | refused | not_applicable
  consentNotes         String?
  notes                String?
  // Service / billing integration
  serviceId            String? // FK → Service (central pricing)
  // Status state machine
  status               String    @default("requested") // requested | scheduled | confirmed | patient_ready | in_progress | completed | cancelled | rescheduled | no_show | aborted
  // Cancellation
  cancelledAt          DateTime?
  cancelledById        String?
  cancellationReason   String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([patientId])
  @@index([facilityId, status])
  @@index([procedureCatalogId])
  @@index([serviceId])
}

// =====================================================================
// PROCEDURE CATALOG — master configuration for procedures
// (Mirrors the Lab Test Catalog pattern. Pricing flows through
//  Service / FacilityServicePrice; this catalog only stores a serviceId
//  reference.)
// =====================================================================

model ProcedureCatalog {
  id                       String                                 @id @default(cuid())
  organizationId           String
  name                     String
  code                     String
  shortName                String?
  description              String?
  category                 String                                 @default("minor") // minor | major | diagnostic | therapeutic | bedside | outpatient | inpatient | specialty | other
  procedureType            String                                 @default("diagnostic") // diagnostic | therapeutic | surgical | other
  departmentId             String?
  // Required staff type (e.g., doctor, nurse, specialist)
  requiredStaffType        String?
  estimatedDurationMinutes Int?
  // Service / billing integration
  serviceId                String?
  isBillable               Boolean                                @default(true)
  billableAs               String                                 @default("individual") // individual | package
  // NHIS (config slots only — no fabricated codes)
  nhisEligible             Boolean                                @default(false)
  nhisServiceCode          String?
  nhisTariffRef            String?
  claimableStatus          String                                 @default("not_configured")
  // Required consumables (JSON array of inventory item references or names)
  requiredConsumables      String?
  // Status
  status                   String                                 @default("active") // active | inactive | retired | archived
  // Facility availability (multi-facility without duplicating the catalog entry)
  facilityAvailability     ProcedureCatalogFacilityAvailability[]
  // Versioning
  version                  Int                                    @default(1)
  createdById              String?
  updatedById              String?
  createdAt                DateTime                               @default(now())
  updatedAt                DateTime                               @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, category])
  @@index([serviceId])
}

model ProcedureCatalogFacilityAvailability {
  id                     String           @id @default(cuid())
  procedureCatalogId     String
  procedureCatalog       ProcedureCatalog @relation(fields: [procedureCatalogId], references: [id], onDelete: Cascade)
  facilityId             String
  availability           String           @default("available") // available | temporarily_unavailable | unavailable | referral_out
  performingDepartmentId String?
  facilityNotes          String?
  status                 String           @default("active")
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  @@unique([procedureCatalogId, facilityId])
  @@index([facilityId])
}

// ---------------------------------------------------------------------
// INPATIENT — ADMISSIONS, BEDS, TRANSFERS, DISCHARGES, NURSING
// ---------------------------------------------------------------------

model Admission {
  id                 String    @id @default(cuid())
  patientId          String
  patient            Patient   @relation(fields: [patientId], references: [id])
  encounterId        String
  encounter          Encounter @relation(fields: [encounterId], references: [id])
  facilityId         String
  facility           Facility  @relation(fields: [facilityId], references: [id])
  admissionNumber    String
  admissionType      String? // emergency | elective | urgent | planned | transfer_in | post_operative | maternity | newborn | observation | day_case | other
  admittedById       String?
  admittedBy         User?     @relation("admissionAdmittedBy", fields: [admittedById], references: [id])
  admissionReason    String?
  admissionDiagnosis String?
  admittedAt         DateTime  @default(now())
  dischargedAt       DateTime?
  status             String    @default("admitted") // requested | pending_approval | approved | awaiting_bed | bed_assigned | admitted | transferred | discharge_planned | discharged | cancelled | declined | ama | deceased
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // ---- Admission request workflow extensions ----
  requestedById          String? // clinician who requested the admission
  requestedAt            DateTime? // when the request was made
  approvedById           String? // who approved the admission
  approvedAt             DateTime?
  approvalDecision       String? // approved | declined | pending
  approvalNotes          String?
  // Clinical context
  provisionalDiagnosis   String?
  clinicalIndication     String?
  priority               String    @default("routine") // routine | urgent | stat
  departmentId           String? // ordering department
  // Bed request
  requestedWardId        String? // preferred ward
  requestedBedType       String? // preferred bed type
  specialRequirements    String? // e.g., isolation, oxygen, cardiac monitoring
  // Discharge planning
  expectedDischargeDate  DateTime?
  dischargeReadiness     String    @default("not_ready") // not_ready | pending_investigations | pending_medications | pending_consult | ready | cleared
  dischargePlannedAt     DateTime?
  dischargePlannedById   String?
  pendingItems           String? // JSON array of pending discharge items
  // Care team
  attendingClinicianId   String? // primary attending doctor
  referringClinicianId   String? // who referred the patient
  // Cancellation / decline
  cancelledAt            DateTime?
  cancelledById          String?
  cancellationReason     String?
  // Death documentation
  deceasedAt             DateTime?
  deceasedDocumentedById String?
  deathSummary           String?
  // Source (where the admission came from)
  admissionSource        String? // emergency | consultation | opd | specialty_clinic | maternity | referral | transfer_in | other
  // Versioning / ownership
  createdById            String?
  updatedById            String?
  notes                  String?

  bedAssignments                BedAssignment[]
  transfers                     PatientTransfer[]
  discharges                    DischargeRecord[]
  nursingNotes                  NursingNote[]
  carePlans                     CarePlan[]
  intakeOutputEntries           IntakeOutputEntry[]
  intakeOutputMonitoringPeriods IntakeOutputMonitoringPeriod[]
  progressNotes                 ProgressNote[]
  careTeamMembers               CareTeamMember[]
  bedReservations               BedReservation[]

  @@unique([facilityId, admissionNumber])
  @@index([patientId, status])
  @@index([facilityId, status])
  @@index([facilityId, admissionType])
  @@index([status, admittedAt])
  @@index([requestedWardId])
}

model BedAssignment {
  id           String    @id @default(cuid())
  admissionId  String
  admission    Admission @relation(fields: [admissionId], references: [id])
  patientId    String
  patient      Patient   @relation(fields: [patientId], references: [id])
  facilityId   String
  facility     Facility  @relation(fields: [facilityId], references: [id])
  wardId       String
  ward         Ward      @relation(fields: [wardId], references: [id])
  roomId       String?
  room         Room?     @relation(fields: [roomId], references: [id])
  bedId        String
  bed          Bed       @relation(fields: [bedId], references: [id])
  assignedAt   DateTime  @default(now())
  releasedAt   DateTime?
  assignedById String?
  status       String    @default("active") // active | released
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([bedId, status])
  @@index([admissionId])
}

model PatientTransfer {
  id                      String    @id @default(cuid())
  transferNumber          String?   @unique // TRF-2026-000001
  patientId               String
  patient                 Patient   @relation(fields: [patientId], references: [id])
  admissionId             String
  admission               Admission @relation(fields: [admissionId], references: [id])
  fromFacilityId          String
  fromFacility            Facility  @relation("ptFromFacility", fields: [fromFacilityId], references: [id])
  toFacilityId            String
  toFacility              Facility  @relation("ptToFacility", fields: [toFacilityId], references: [id])
  fromWardId              String?
  fromBedId               String?
  toWardId                String?
  toBedId                 String?
  // ---- Transfer type & priority ----
  transferType            String    @default("internal") // internal | external
  transferCategory        String? // ward | bed | department | specialty | icu | emergency | theatre | imaging | procedure | facility | referral | specialist | rehabilitation | other
  priority                String    @default("routine") // routine | urgent | emergency | critical
  reason                  String?
  clinicalSummary         String?
  // ---- Destination contact (external) ----
  toDepartment            String?
  toAddress               String?
  toContactPerson         String?
  toContactPhone          String?
  toContactEmail          String?
  toDestinationNotes      String?
  receivingClinicianId    String?
  receivingClinicianName  String?
  // ---- Referral & ambulance integration ----
  referralId              String?
  ambulanceTripId         String?
  // ---- Transport ----
  transportMethod         String? // hospital_ambulance | private_ambulance | family_vehicle | wheelchair | stretcher | other
  transportRequirements   String? // JSON array: wheelchair, stretcher, oxygen, monitoring, escort, nurse_escort, clinician_escort
  oxygenRequired          Boolean   @default(false)
  cardiacMonitoring       Boolean   @default(false)
  ivAccess                Boolean   @default(false)
  isolationPrecautions    String?
  escortRequired          String? // none | nurse | clinician | both
  // ---- Clinical handover ----
  handoverSummary         String?
  nursingHandover         String?
  // ---- Special requirements ----
  specialRequirements     String?
  clinicalNotes           String?
  nursingNotes            String?
  administrativeNotes     String?
  transportNotes          String?
  receivingNotes          String?
  // ---- Workflow lifecycle timestamps ----
  requestedById           String?
  requestedBy             User?     @relation("ptRequestedBy", fields: [requestedById], references: [id])
  approvedById            String?
  approvedBy              User?     @relation("ptApprovedBy", fields: [approvedById], references: [id])
  approvedAt              DateTime?
  acceptedById            String?
  acceptedBy              User?     @relation("ptAcceptedBy", fields: [acceptedById], references: [id])
  acceptedAt              DateTime?
  rejectedAt              DateTime?
  rejectedById            String?
  rejectedBy              User?     @relation("ptRejectedBy", fields: [rejectedById], references: [id])
  rejectionReason         String?
  departedAt              DateTime?
  departedFrom            String?
  departedById            String?
  departedBy              User?     @relation("ptDepartedBy", fields: [departedById], references: [id])
  conditionAtDeparture    String?
  arrivedAt               DateTime?
  arrivedAtLocation       String?
  arrivedById             String?
  arrivedBy               User?     @relation("ptArrivedBy", fields: [arrivedById], references: [id])
  conditionOnArrival      String?
  completedAt             DateTime?
  completedById           String?
  completedBy             User?     @relation("ptCompletedBy", fields: [completedById], references: [id])
  isFinalized             Boolean   @default(false)
  // ---- Cancellation / delay ----
  cancelledAt             DateTime?
  cancelledById           String?
  cancelledBy             User?     @relation("ptCancelledBy", fields: [cancelledById], references: [id])
  cancelReason            String?
  delayedAt               DateTime?
  delayReason             String?
  delayDepartment         String?
  expectedTransferAt      DateTime?
  // ---- Amendment tracking ----
  amendedById             String?
  amendedBy               User?     @relation("ptAmendedBy", fields: [amendedById], references: [id])
  amendedAt               DateTime?
  amendmentReason         String?
  version                 Int       @default(1)
  // ---- Patient belongings & equipment ----
  belongingsChecked       Boolean   @default(false)
  belongingsNotes         String?
  equipmentAccompanying   String? // JSON array
  // ---- Acknowledgement ----
  acknowledgedByPatient   Boolean   @default(false)
  acknowledgedByCaregiver Boolean   @default(false)
  caregiverName           String?
  caregiverRelationship   String?
  // ---- Workflow fields ----
  requestedAt             DateTime  @default(now())
  status                  String    @default("requested") // requested | pending_review | pending_approval | pending_destination | accepted | rejected | pending_bed | pending_transport | ready | in_transit | arrived | completed | cancelled | delayed
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  checklist      TransferChecklistItem[]
  communications TransferCommunication[]

  @@index([patientId, status])
  @@index([fromFacilityId, status])
  @@index([toFacilityId, status])
  @@index([transferType, status])
  @@index([status, requestedAt])
  @@index([priority, status])
}

// ---------------------------------------------------------------------
// TRANSFER CHECKLIST — per-transfer completion tracking
// ---------------------------------------------------------------------
model TransferChecklistItem {
  id            String          @id @default(cuid())
  transferId    String
  transfer      PatientTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  category      String // clinical | nursing | destination | transport | documentation
  label         String
  status        String          @default("pending") // pending | completed | not_applicable | blocked
  completedById String?
  completedAt   DateTime?
  notes         String?
  required      Boolean         @default(true)
  sortOrder     Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([transferId, category])
  @@index([transferId, status])
}

// ---------------------------------------------------------------------
// TRANSFER COMMUNICATION LOG — auditable communication history
// ---------------------------------------------------------------------
model TransferCommunication {
  id                  String          @id @default(cuid())
  transferId          String
  transfer            PatientTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  senderId            String?
  senderName          String?
  recipientName       String?
  recipientDepartment String?
  recipientFacility   String?
  messageType         String // call | email | sms | internal_notification | other
  message             String?
  outcome             String? // delivered | acknowledged | accepted | rejected | no_response | other
  sentAt              DateTime        @default(now())
  createdAt           DateTime        @default(now())

  @@index([transferId, sentAt])
}

model DischargeRecord {
  id                        String    @id @default(cuid())
  patientId                 String
  patient                   Patient   @relation(fields: [patientId], references: [id])
  admissionId               String
  admission                 Admission @relation(fields: [admissionId], references: [id])
  facilityId                String?
  facility                  Facility? @relation(fields: [facilityId], references: [id])
  dischargeNumber           String?   @unique // DIS-2026-000001
  dischargeSummary          String?
  finalDiagnosis            String?
  procedures                String?
  medications               String?
  followUpPlan              String?
  disposition               String? // home | transferred | referred | deceased | ama | absconded | other
  dischargedById            String?
  dischargedBy              User?     @relation("dischargeUser", fields: [dischargedById], references: [id])
  dischargedAt              DateTime  @default(now())
  // ---- Extended structured fields ----
  attendingClinicianId      String? // separate from discharging user
  admissionDate             DateTime? // mirror of admission.admittedAt for report portability
  primaryDiagnosisCode      String? // ICD-10 code
  primaryDiagnosisName      String?
  secondaryDiagnoses        String? // JSON array of {code, name}
  investigationResults      String? // JSON array of important lab/imaging results
  dischargeConditions       String? // patient condition at discharge
  adviceOnDischarge         String?
  sickLeaveDays             Int?
  followUpAppointmentDate   DateTime?
  followUpClinic            String?
  followUpClinicianId       String?
  allergiesAtDischarge      String? // JSON array
  billedAmount              Float?
  insuranceProviderId       String?
  dischargeType             String? // routine | transfer_to_facility | transfer_to_ward | ama | absconded | deceased | other
  // Clearances
  clinicalCleared           Boolean   @default(false)
  clinicalClearedById       String?
  clinicalClearedBy         User?     @relation("dischargeClinicalClear", fields: [clinicalClearedById], references: [id])
  clinicalClearedAt         DateTime?
  nursingCleared            Boolean   @default(false)
  nursingClearedById        String?
  nursingClearedBy          User?     @relation("dischargeNursingClear", fields: [nursingClearedById], references: [id])
  nursingClearedAt          DateTime?
  financialCleared          Boolean   @default(false)
  financialClearedById      String?
  financialClearedBy        User?     @relation("dischargeFinancialClear", fields: [financialClearedById], references: [id])
  financialClearedAt        DateTime?
  pharmacyCleared           Boolean   @default(false)
  pharmacyClearedById       String?
  pharmacyClearedBy         User?     @relation("dischargePharmacyClear", fields: [pharmacyClearedById], references: [id])
  pharmacyClearedAt         DateTime?
  // Amendment / versioning
  amendedFromId             String?
  amendmentReason           String?
  amendedById               String?
  amendedBy                 User?     @relation("dischargeAmender", fields: [amendedById], references: [id])
  amendedAt                 DateTime?
  version                   Int       @default(1)
  isLatest                  Boolean   @default(true)
  // ---- Workflow lifecycle (new) ----
  status                    String    @default("requested") // requested | clinical_review | approved | pending_clearance | pending_billing | pending_medication | pending_documentation | ready | discharged | cancelled | delayed
  requestedById             String?
  requestedBy               User?     @relation("dischargeRequester", fields: [requestedById], references: [id])
  requestedAt               DateTime?
  proposedDischargeAt       DateTime?
  approvedById              String?
  approvedBy                User?     @relation("dischargeApprover", fields: [approvedById], references: [id])
  approvedAt                DateTime?
  cancelledAt               DateTime?
  cancelledById             String?
  cancelledBy               User?     @relation("dischargeCanceller", fields: [cancelledById], references: [id])
  cancelReason              String?
  delayedAt                 DateTime?
  delayReason               String?
  delayDepartment           String?
  expectedDischargeAt       DateTime?
  finalizedAt               DateTime?
  finalizedById             String?
  finalizedBy               User?     @relation("dischargeFinalizer", fields: [finalizedById], references: [id])
  isFinalized               Boolean   @default(false)
  // ---- Discharge-type-specific fields ----
  // DAMA
  damaReason                String?
  damaRisksExplained        Boolean   @default(false)
  damaAdviceProvided        String?
  damaAcknowledgedById      String?
  damaAcknowledgedAt        DateTime?
  damaWitnessName           String?
  // Transfer
  transferDestination       String?
  transferReceivingFacility String?
  transferReceivingDept     String?
  transferContactPerson     String?
  transferContactPhone      String?
  transferReason            String?
  transferTransportMethod   String?
  transferAmbulanceTripId   String?
  transferReferralId        String?
  // Death
  deathDate                 DateTime?
  deathPronouncedById       String?
  deathCause                String?
  deathMortuaryAdmissionId  String?
  // Absconded
  abscondedLastSeenAt       DateTime?
  abscondedLastLocation     String?
  abscondedCircumstances    String?
  abscondedStaffNotified    String?
  // Patient education
  patientEducationProvided  Boolean   @default(false)
  patientEducationTopics    String? // JSON array
  patientEducationNotes     String?
  // Discharge instructions (structured)
  instructionsMedication    String?
  instructionsDiet          String?
  instructionsActivity      String?
  instructionsWoundCare     String?
  instructionsFollowUp      String?
  instructionsWarningSigns  String?
  instructionsEmergency     String?
  instructionsOther         String?
  // Acknowledgement
  acknowledgedByPatient     Boolean   @default(false)
  acknowledgedByCaregiver   Boolean   @default(false)
  caregiverName             String?
  caregiverRelationship     String?
  acknowledgedAt            DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  checklist                 DischargeChecklistItem[]
  medicationsReconciliation DischargeMedication[]

  @@index([patientId])
  @@index([admissionId])
  @@index([dischargedAt])
  @@index([facilityId, status])
  @@index([status, dischargedAt])
}

// ---------------------------------------------------------------------
// DISCHARGE CHECKLIST — configurable per-facility, completed per-discharge
// ---------------------------------------------------------------------
model DischargeChecklistItem {
  id            String          @id @default(cuid())
  dischargeId   String
  discharge     DischargeRecord @relation(fields: [dischargeId], references: [id], onDelete: Cascade)
  category      String // clinical | financial | pharmacy | nursing | records | follow_up | transport | patient_education
  label         String
  status        String          @default("pending") // pending | completed | not_applicable | blocked
  completedById String?
  completedAt   DateTime?
  notes         String?
  required      Boolean         @default(true)
  sortOrder     Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([dischargeId, category])
  @@index([dischargeId, status])
}

// ---------------------------------------------------------------------
// DISCHARGE MEDICATION RECONCILIATION
//   Tracks each medication's status through the discharge process:
//   continue / stop / change / new / hold
// ---------------------------------------------------------------------
model DischargeMedication {
  id                String          @id @default(cuid())
  dischargeId       String
  discharge         DischargeRecord @relation(fields: [dischargeId], references: [id], onDelete: Cascade)
  medicationName    String
  medicationId      String?
  strength          String?
  dose              String?
  route             String?
  frequency         String?
  duration          String?
  quantity          String?
  instructions      String?
  action            String          @default("continue") // continue | stop | change | new | hold
  preAdmission      Boolean         @default(false)
  inpatient         Boolean         @default(false)
  dispensed         Boolean         @default(false)
  dispensedQuantity String?
  dispensedAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([dischargeId, action])
}

// =====================================================================
// BED RESERVATION — reserve a bed for an approved admission
// =====================================================================

model BedReservation {
  id            String     @id @default(cuid())
  admissionId   String?
  admission     Admission? @relation(fields: [admissionId], references: [id], onDelete: SetNull)
  patientId     String
  facilityId    String
  wardId        String
  roomId        String?
  bedId         String
  bed           Bed        @relation(fields: [bedId], references: [id], onDelete: Cascade)
  reservedAt    DateTime   @default(now())
  expectedUseAt DateTime? // when the bed is expected to be used
  expiresAt     DateTime? // reservation expiry
  reservedById  String?
  reason        String? // why the bed is reserved
  status        String     @default("active") // active | used | expired | cancelled
  notes         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([bedId, status])
  @@index([admissionId])
  @@index([facilityId, status])
  @@index([patientId])
}

// =====================================================================
// BED CLEANING — cleaning workflow after discharge/transfer
// =====================================================================

model BedCleaning {
  id            String    @id @default(cuid())
  bedId         String
  bed           Bed       @relation(fields: [bedId], references: [id], onDelete: Cascade)
  facilityId    String
  // Cleaning state
  status        String    @default("pending") // pending | in_progress | completed | skipped
  initiatedAt   DateTime  @default(now())
  startedAt     DateTime?
  completedAt   DateTime?
  // Staff
  initiatedById String? // who flagged it for cleaning
  cleanedById   String? // who performed the cleaning
  // Details
  cleaningType  String? // routine | deep | isolation | terminal
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([bedId, status])
  @@index([facilityId, status])
}

// =====================================================================
// BED MAINTENANCE — maintenance workflow
// =====================================================================

model BedMaintenance {
  id                 String    @id @default(cuid())
  bedId              String
  bed                Bed       @relation(fields: [bedId], references: [id], onDelete: Cascade)
  facilityId         String
  // Maintenance state
  status             String    @default("reported") // reported | in_progress | resolved | unresolved
  reason             String? // what needs maintenance
  reportedAt         DateTime  @default(now())
  reportedById       String?
  startedAt          DateTime?
  expectedCompletion DateTime?
  completedAt        DateTime?
  // Staff
  technicianId       String? // maintenance staff
  technicianName     String?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([bedId, status])
  @@index([facilityId, status])
}

// =====================================================================
// BED BLOCK — blocking a bed for various reasons
// =====================================================================

model BedBlock {
  id            String    @id @default(cuid())
  bedId         String
  bed           Bed       @relation(fields: [bedId], references: [id], onDelete: Cascade)
  facilityId    String
  // Block state
  status        String    @default("active") // active | removed | expired
  reason        String? // infection_control | maintenance | renovation | staffing_shortage | isolation_requirement | ward_closure | other
  reasonDetails String?
  blockedAt     DateTime  @default(now())
  expectedEnd   DateTime?
  actualEnd     DateTime?
  blockedById   String?
  approvedById  String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([bedId, status])
  @@index([facilityId, status])
}

// =====================================================================
// PROGRESS NOTE — doctor SOAP notes for inpatient encounters
// =====================================================================

model ProgressNote {
  id            String    @id @default(cuid())
  admissionId   String
  admission     Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  patientId     String
  encounterId   String?
  facilityId    String
  // SOAP fields
  subjective    String? // S — patient's complaint / history
  objective     String? // O — examination findings, vitals
  assessment    String? // A — diagnosis / clinical assessment
  plan          String? // P — treatment plan, orders
  // Additional
  diagnosisRef  String? // ICD-10 code or diagnosis name
  orders        String? // JSON array of orders generated
  followUp      String?
  noteType      String    @default("doctor") // doctor | consultant | resident | handover
  authoredById  String?
  authoredAt    DateTime  @default(now())
  status        String    @default("final") // draft | final | amended
  amendedFromId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([admissionId, authoredAt])
  @@index([patientId])
}

// =====================================================================
// CARE TEAM MEMBER — multi-disciplinary care team for an admission
// =====================================================================

model CareTeamMember {
  id           String    @id @default(cuid())
  admissionId  String
  admission    Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  userId       String? // FK → User (staff record)
  staffName    String? // denormalized for legacy / external staff
  role         String    @default("attending") // attending | consultant | resident | nurse | pharmacist | physiotherapist | specialist | other
  assignedAt   DateTime  @default(now())
  unassignedAt DateTime?
  assignedById String?
  status       String    @default("active") // active | inactive
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([admissionId, status])
  @@index([userId])
}

model NursingNote {
  id            String     @id @default(cuid())
  patientId     String
  patient       Patient    @relation(fields: [patientId], references: [id])
  encounterId   String
  encounter     Encounter  @relation(fields: [encounterId], references: [id])
  admissionId   String?
  admission     Admission? @relation(fields: [admissionId], references: [id])
  nurseId       String?
  nurse         User?      @relation("nursingNoteAuthor", fields: [nurseId], references: [id])
  noteType      String? // assessment | intervention | handover | observation | wound | shift_note | progress | soap | focus_dar | narrative | post_procedure | post_op | emergency | maternity | pediatric | discharge | transfer | incident | initial_assessment
  content       String
  // ---- Extended fields ----
  shift         String? // morning | afternoon | night | other
  // SOAP fields (optional — used when noteType is soap/progress/initial_assessment)
  subjective    String? // S — patient's complaint / history
  objective     String? // O — examination findings, vitals
  assessment    String? // A — nursing assessment
  plan          String? // P — nursing plan
  // Focus/DAR fields (optional — used when noteType is focus_dar)
  focusData     String? // D — Data
  focusAction   String? // A — Action
  focusResponse String? // R — Response
  // Status lifecycle
  status        String     @default("draft") // draft | submitted | signed | amended
  signedById    String?
  signedAt      DateTime?
  // Amendment chain
  amendedFromId String?
  // Event vs documentation timestamps
  eventAt       DateTime? // when care occurred (defaults to createdAt if not set)
  // Escalation flag
  isEscalation  Boolean    @default(false)
  // Ward/bed context
  wardId        String?
  bedId         String?
  facilityId    String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([patientId, createdAt])
  @@index([admissionId])
  @@index([status])
  @@index([shift])
  @@index([noteType])
}

model CarePlan {
  id                 String     @id @default(cuid())
  patientId          String
  patient            Patient    @relation(fields: [patientId], references: [id])
  encounterId        String
  encounter          Encounter  @relation(fields: [encounterId], references: [id])
  admissionId        String?
  admission          Admission? @relation(fields: [admissionId], references: [id])
  problem            String?
  goal               String?
  interventions      String?
  evaluation         String?
  createdById        String?
  createdBy          User?      @relation("carePlanAuthor", fields: [createdById], references: [id])
  // ---- Extended fields ----
  status             String     @default("active") // active | completed | modified | discontinued
  priority           String? // low | medium | high | urgent
  expectedOutcome    String?
  reviewDate         DateTime?
  responsibleNurseId String?
  facilityId         String?
  // Link to nursing diagnosis
  nursingDiagnosis   String?
  relatedFactors     String?
  patientResponse    String?
  outcome            String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  interventions_rows NursingIntervention[]

  @@index([patientId])
  @@index([admissionId])
  @@index([status])
}

// =====================================================================
// NURSING HANDOVER — per-patient clinical handover
// =====================================================================

model NursingHandover {
  id                    String    @id @default(cuid())
  patientId             String
  admissionId           String?
  encounterId           String?
  facilityId            String?
  wardId                String?
  // Handover details
  shiftType             String    @default("morning") // morning | afternoon | night
  handoverDate          DateTime  @default(now())
  // SBAR-style structure
  currentCondition      String?
  background            String?
  assessment            String?
  recommendation        String?
  // Additional handover info
  medicationsDue        String?
  pendingTasks          String?
  safetyConcerns        String?
  allergies             String?
  recentVitals          String?
  pendingInvestigations String?
  // Staff
  fromNurseId           String?
  toNurseId             String?
  // Status
  status                String    @default("active") // active | acknowledged | archived
  acknowledgedAt        DateTime?
  acknowledgedById      String?
  notes                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([patientId, handoverDate])
  @@index([shiftType])
  @@index([status])
}

// =====================================================================
// NURSING ESCALATION — nurse-to-clinician escalation
// =====================================================================

model NursingEscalation {
  id            String    @id @default(cuid())
  patientId     String
  admissionId   String?
  encounterId   String?
  facilityId    String?
  // Escalation details
  concern       String // what the nurse is concerned about
  priority      String    @default("routine") // routine | urgent | critical
  escalatedTo   String? // doctor | specialist | nurse_in_charge | emergency_team | other
  escalatedToId String? // specific user ID if known
  escalatedById String?
  escalatedAt   DateTime  @default(now())
  // Response
  response      String?
  responseById  String?
  respondedAt   DateTime?
  resolution    String?
  resolvedAt    DateTime?
  resolvedById  String?
  status        String    @default("open") // open | acknowledged | in_progress | resolved
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([patientId])
  @@index([status])
  @@index([priority])
}

// =====================================================================
// NURSING TASK — nursing-specific tasks (vitals, meds, wound care, etc.)
// =====================================================================

model NursingTask {
  id              String    @id @default(cuid())
  patientId       String
  admissionId     String?
  encounterId     String?
  facilityId      String?
  wardId          String?
  // Task details
  taskType        String // vitals | medication | wound_care | repositioning | intake_output | patient_education | monitoring | specimen_collection | procedure_preparation | discharge_preparation | other
  title           String
  description     String?
  // Scheduling
  dueAt           DateTime
  frequency       String? // once | every_4h | every_8h | every_12h | daily | weekly | prn | other
  // Assignment
  assignedToId    String? // nurse user ID
  // Completion
  status          String    @default("pending") // pending | due | in_progress | completed | missed | cancelled
  completedAt     DateTime?
  completedById   String?
  completionNotes String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([patientId, status])
  @@index([dueAt])
  @@index([assignedToId])
}

// =====================================================================
// WOUND ASSESSMENT — wound/skin documentation
// =====================================================================

model WoundAssessment {
  id                 String    @id @default(cuid())
  patientId          String
  admissionId        String?
  encounterId        String?
  facilityId         String?
  // Wound details
  woundLocation      String? // body location
  woundType          String? // surgical | pressure | diabetic | venous | arterial | burn | traumatic | other
  // Dimensions
  length             Float? // cm
  width              Float? // cm
  depth              Float? // cm
  // Appearance
  stage              String? // stage_1 | stage_2 | stage_3 | stage_4 | unstageable | deep_tissue | partial | full
  appearance         String? // healthy | granulating | sloughy | necrotic | infected | mixed
  exudateType        String? // none | serous | sanguineous | serosanguineous | purulent
  exudateAmount      String? // none | scant | small | moderate | large
  surroundingSkin    String? // intact | macerated | erythema | induration | other
  odor               String? // none | mild | moderate | strong
  painScore          Int? // 0-10
  // Treatment
  dressingType       String?
  treatmentGiven     String?
  nextDressingChange DateTime?
  // Staff
  assessedById       String?
  assessedAt         DateTime  @default(now())
  patientResponse    String?
  notes              String?
  // Photo reference (if image storage is available)
  photoUrl           String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([patientId, assessedAt])
  @@index([admissionId])
}

// =====================================================================
// RISK ASSESSMENT — fall risk, pressure injury risk
// =====================================================================

model RiskAssessment {
  id             String    @id @default(cuid())
  patientId      String
  admissionId    String?
  encounterId    String?
  facilityId     String?
  // Assessment type
  assessmentType String // fall_risk | pressure_injury | other
  // Risk level
  riskLevel      String? // low | moderate | high | severe
  riskScore      Int?
  // Details
  riskFactors    String? // JSON array of identified risk factors
  preventionPlan String?
  interventions  String? // JSON array of prevention interventions
  // Assessment metadata
  assessedById   String?
  assessedAt     DateTime  @default(now())
  reviewDate     DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([patientId, assessmentType])
  @@index([admissionId])
}

// =====================================================================
// NURSING INTERVENTION — structured intervention records
// =====================================================================

model NursingIntervention {
  id               String    @id @default(cuid())
  carePlanId       String?
  carePlan         CarePlan? @relation(fields: [carePlanId], references: [id], onDelete: SetNull)
  patientId        String
  admissionId      String?
  encounterId      String?
  facilityId       String?
  // Intervention details
  interventionType String? // positioning | hygiene | wound_care | mobility | nutrition | education | monitoring | comfort | oxygen | intake_output | safety | medication_admin | other
  description      String
  frequency        String? // once | hourly | every_2h | every_4h | daily | prn | other
  // Execution
  status           String    @default("pending") // pending | in_progress | completed | discontinued
  executedById     String?
  executedAt       DateTime?
  // Patient response
  patientResponse  String? // improvement | no_change | deterioration | adverse | escalation
  responseNotes    String?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([patientId])
  @@index([carePlanId])
  @@index([status])
}

// ---------------------------------------------------------------------
// REFERRALS & IMMUNIZATIONS & MATERNITY
// ---------------------------------------------------------------------

model Referral {
  id                          String     @id @default(cuid())
  referralNumber              String?    @unique // REF-YYYY-000001 — null for legacy rows, populated on new ones
  // 'kind' discriminates inter-facility referrals (sent to another facility)
  // from specialty referrals (sent to a specialty clinic within the same
  // facility). Specialty referrals use toDepartmentCode (CARDIO, DERM, etc.)
  // and may not have a receivingFacilityId. This field enables the unified
  // Referrals API to filter by kind=specialty for the Specialty Clinics view
  // while kind=inter_facility (default) powers the main Referrals view.
  kind                        String     @default("inter_facility") // inter_facility | specialty
  toDepartmentCode            String? // specialty code (CARDIO, DERM, OPHTH, ENT, PHYSIO, PSYCH, NEURO, ORTHO, URO, ENDO, PAED, DENTAL) — used when kind=specialty
  referralType                String     @default("external") // internal | external | inter_facility | specialist | emergency | routine | diagnostic | surgical | maternal | pediatric | mental_health | rehabilitation | laboratory | radiology | pharmacy | follow_up | counter_referral
  patientIdFrom               String
  patient                     Patient    @relation("refPatientFrom", fields: [patientIdFrom], references: [id])
  patientIdTo                 String?
  patientTo                   Patient?   @relation("refPatientTo", fields: [patientIdTo], references: [id])
  // encounterId is optional for specialty referrals (kind=specialty) which
  // may be created from OPD without a formal encounter record. Inter-facility
  // referrals should still link to a source encounter.
  encounterId                 String?
  encounter                   Encounter? @relation(fields: [encounterId], references: [id])
  referringFacilityId         String
  referringFacility           Facility   @relation("refFromFacility", fields: [referringFacilityId], references: [id])
  receivingFacilityId         String?
  receivingFacility           Facility?  @relation("refToFacility", fields: [receivingFacilityId], references: [id])
  referringDepartmentId       String?
  receivingDepartmentId       String?
  referringStaffId            String?
  referredBy                  User?      @relation("referralMadeBy", fields: [referringStaffId], references: [id])
  receivingStaffId            String?
  receivedBy                  User?      @relation("referralReceivedBy", fields: [receivingStaffId], references: [id])
  // Destination snapshot (free-text specialty / provider name for external referrals where no facility record exists)
  receivingFacilityName       String? // Snapshot of external facility name if not in HMIS
  receivingProviderName       String? // Snapshot of external provider name
  receivingContact            String? // Phone / email of receiving facility/provider
  reason                      String?
  referralReasonCategory      String? // specialist_evaluation | higher_level_care | advanced_investigation | surgical_intervention | emergency_management | diagnostic_confirmation | treatment_unavailable | equipment_unavailable | specialist_unavailable | continuity_of_care | follow_up | other
  clinicalSummary             String?
  // Clinical context links
  primaryDiagnosisId          String? // optional FK to Diagnosis (primary reason for referral)
  primaryDiagnosis            Diagnosis? @relation("referralPrimaryDiagnosis", fields: [primaryDiagnosisId], references: [id])
  // Lifecycle
  urgency                     String     @default("routine") // routine | urgent | emergency | stat
  priority                    String     @default("routine") // alias kept for UI clarity — same vocabulary as urgency
  status                      String     @default("draft") // draft | submitted | authorized | sent | acknowledged | accepted | rejected | scheduled | in_transit | arrived | under_care | completed | feedback_received | follow_up | closed | cancelled | expired | returned | redirected | no_response | unable_to_attend
  feedbackStatus              String     @default("awaiting") // awaiting | received | reviewed | follow_up_required | closed
  // Transport / appointment integration
  transportRequired           Boolean    @default(false)
  transportStatus             String? // not_required | pending | requested | assigned | departed | in_transit | arrived | cancelled
  transportRequestId          String? // link to ServiceRequest with serviceType=transport (no FK — service requests are polymorphic)
  appointmentId               String? // link to Appointment booked at receiving facility (no FK to avoid circular relation)
  appointmentDate             DateTime? // snapshot of scheduled appointment date for quick display
  // Stabilization for emergency referrals
  stabilizationPerformed      String? // free-text: IV access, Oxygen, Fluids, Medication, Immobilization, etc.
  // Authorization
  authorizedById              String? // user who authorized the referral (clinical lead / coordinator)
  authorizedAt                DateTime?
  // Closure
  closureReason               String?
  closedById                  String?
  closedAt                    DateTime?
  // Timestamps for each lifecycle stage (enables performance analytics)
  referredAt                  DateTime   @default(now())
  submittedAt                 DateTime?
  sentAt                      DateTime?
  acknowledgedAt              DateTime?
  acceptedAt                  DateTime?
  rejectedAt                  DateTime?
  arrivedAt                   DateTime?
  completedAt                 DateTime?
  feedbackReceivedAt          DateTime?
  cancelledAt                 DateTime?
  // Consent
  consentStatus               String? // obtained | declined | not_required | pending
  consentObtainedById         String?
  consentObtainedAt           DateTime?
  // Redirect chain
  originalReceivingFacilityId String? // if redirected, the original destination before change
  // Multi-level referral chain
  parentReferralId            String? // if this referral was created from another referral (chain)
  createdAt                   DateTime   @default(now())
  updatedAt                   DateTime   @updatedAt

  events   ReferralEvent[]
  feedback ReferralFeedback[]
  messages ReferralMessage[]

  @@index([patientIdFrom, status])
  @@index([referringFacilityId, status])
  @@index([receivingFacilityId, status])
  @@index([status, feedbackStatus])
  @@index([urgency, status])
  @@index([referralNumber])
  @@index([kind, toDepartmentCode])
  @@index([kind, status])
}

// =====================================================================
// REFERRAL EVENT — Timeline / status history
// =====================================================================
// Each lifecycle transition or notable event gets its own row, giving a
// clean chronological timeline without having to reconstruct from AuditLog.
model ReferralEvent {
  id          String   @id @default(cuid())
  referralId  String
  referral    Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)
  eventType   String // created | edited | authorized | sent | acknowledged | accepted | rejected | redirected | scheduled | in_transit | arrived | under_care | completed | feedback_received | follow_up | closed | cancelled | expired | returned | more_info_requested | more_info_responded | consent_obtained | transport_requested | transport_assigned | transport_arrived | note_added
  fromStatus  String?
  toStatus    String?
  actorUserId String?
  actorUser   User?    @relation("referralEventActor", fields: [actorUserId], references: [id])
  facilityId  String? // facility the actor was at when performing the action
  title       String
  description String?
  metadata    String? // JSON string for extra context (e.g., rejection reason, redirect destination)
  createdAt   DateTime @default(now())

  @@index([referralId, createdAt])
  @@index([eventType])
}

// =====================================================================
// REFERRAL FEEDBACK — Counter-referral from receiving facility
// =====================================================================
// Receiving facility uses this to send clinical findings, treatment,
// outcome, and recommendations back to the referring facility.
// Multiple feedback entries are allowed over the referral lifecycle
// (e.g., interim update + final discharge summary).
model ReferralFeedback {
  id                    String   @id @default(cuid())
  referralId            String
  referral              Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)
  feedbackType          String   @default("interim") // interim | final | discharge_summary | counter_referral | specialist_response
  authorUserId          String?
  authorUser            User?    @relation("referralFeedbackAuthor", fields: [authorUserId], references: [id])
  authorFacilityId      String?
  // Clinical content
  clinicalFindings      String?
  diagnosis             String?
  treatmentProvided     String?
  proceduresPerformed   String?
  investigationsDone    String?
  outcome               String? // completed | admitted | treated_and_discharged | procedure_completed | referred_further | returned_to_referring_facility | patient_declined | no_show | expired
  medicationsPrescribed String?
  recommendations       String?
  followUpPlan          String?
  returnRecommendation  String? // none | follow_up_at_referring_facility | follow_up_at_receiving_facility | refer_further
  isFinal               Boolean  @default(false) // marks the definitive closing feedback
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([referralId, createdAt])
  @@index([feedbackType])
}

// =====================================================================
// REFERRAL MESSAGE — Communication log between referring & receiving staff
// =====================================================================
// Threaded messages between referring and receiving staff. Each message
// belongs to a referral and is visible to both sides according to
// permissions. Used for info requests, clarifications, status updates.
model ReferralMessage {
  id               String    @id @default(cuid())
  referralId       String
  referral         Referral  @relation(fields: [referralId], references: [id], onDelete: Cascade)
  senderUserId     String?
  senderUser       User?     @relation("referralMessageSender", fields: [senderUserId], references: [id])
  senderFacilityId String?
  // Direction relative to the referral: outbound = referring→receiving, inbound = receiving→referring
  direction        String    @default("outbound") // outbound | inbound
  message          String
  messageType      String    @default("message") // message | info_request | info_response | phone_call_log | system_note
  attachments      String? // JSON string of document IDs / links
  isRead           Boolean   @default(false)
  readAt           DateTime?
  createdAt        DateTime  @default(now())

  @@index([referralId, createdAt])
  @@index([direction, isRead])
}

model Immunization {
  id                  String          @id @default(cuid())
  patientId           String
  patient             Patient         @relation(fields: [patientId], references: [id])
  // Vaccine identification — supports both catalog-linked and legacy free-text
  vaccineCatalogId    String? // FK to VaccineCatalog (null for legacy/historical records)
  vaccineCatalog      VaccineCatalog? @relation(fields: [vaccineCatalogId], references: [id])
  vaccineName         String // Snapshotted name (preserves history even if catalog changes)
  dose                String? // Free-text dose label (e.g. "1st dose", "Birth dose", "Booster")
  doseNumber          Int? // Numeric dose in series (1, 2, 3...) for schedule tracking
  seriesId            String? // Groups multi-dose series (e.g., "PENTA-2026-patientX")
  // Batch / lot tracking — links to InventoryBatch for stock traceability
  batchId             String? // FK to InventoryBatch (null for historical/external records)
  batchNumber         String? // Snapshotted batch number (preserves history)
  manufacturer        String? // Snapshotted manufacturer name
  expiryDate          DateTime? // Snapshotted batch expiry at time of administration
  // Administration details
  route               String? // IM | SC | Oral | Intradermal | Nasal | Other
  site                String? // Left deltoid | Right deltoid | Left thigh | Right thigh | Oral | Other
  administeredAt      DateTime        @default(now())
  nextDueAt           DateTime?
  // Status & lifecycle
  status              String          @default("completed") // completed | scheduled | due | overdue | missed | declined | deferred | contraindicated | cancelled | not_available | unknown
  indication          String? // routine | catch_up | campaign | occupational | travel | maternal | clinical_indication | outbreak
  // Encounter linkage
  encounterId         String? // Optional link to the source encounter
  // Appointment linkage — auto-booked next-dose appointment (no FK to avoid
  // circular relation; Appointment deletion does not cascade to Immunization)
  appointmentId       String?
  // Consent (for minors / capable adults)
  consentStatus       String? // obtained | declined | not_required | pending
  consentObtainedById String?
  consentObtainedAt   DateTime?
  guardianName        String? // For pediatric patients — guardian who brought the child
  // Facility & staff
  facilityId          String
  facility            Facility        @relation(fields: [facilityId], references: [id])
  administeredById    String?
  administeredBy      User?           @relation("immunizationAdmin", fields: [administeredById], references: [id])
  // Clinical
  notes               String?
  // Deferral / decline tracking
  deferralReason      String?
  deferredUntil       DateTime?
  declineReason       String?
  // Amendment tracking (immutable clinical history — corrections via amendment)
  amendedFromId       String? // If this record corrects a previous one
  amendmentReason     String?
  // Recall tracking
  recalledAt          DateTime? // If the batch was recalled, when was this record flagged
  recallStatus        String? // pending_review | contacted | resolved | no_action
  // Outreach linkage
  communityOutreachId String? // Link to CommunityOutreach session if administered during outreach
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  aefiRecords AEFI[]

  @@index([patientId, administeredAt])
  @@index([facilityId, administeredAt])
  @@index([status])
  @@index([vaccineCatalogId])
  @@index([batchId])
  @@index([seriesId])
}

// =====================================================================
// VACCINE CATALOG — Configurable master list of vaccines
// =====================================================================
// Org-level catalog of vaccines. Each vaccine has a code, default route/site,
// and links to an InventoryItem (so administering a dose can deduct stock).
// The schedule rules (which dose at which age) live in VaccineScheduleDose.
model VaccineCatalog {
  id                 String       @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id])
  code               String // Unique vaccine code, e.g. "BCG", "OPV", "PENTA", "PCV", "MR", "HPV"
  name               String // Display name, e.g. "BCG Vaccine"
  genericName        String? // Standard/generic name, e.g. "Bacille Calmette-Guérin"
  description        String?
  diseasePrevented   String? // e.g. "Tuberculosis"
  vaccineType        String? // routine_childhood | adolescent | adult | maternal | travel | occupational | catch_up | campaign | other
  ageGroup           String? // birth | under_1 | 1_5 | 5_10 | adolescent | adult | maternal | all
  defaultRoute       String? // IM | SC | Oral | Intradermal | Nasal | Other
  defaultSite        String? // Left deltoid | Right deltoid | Left thigh | Right thigh | Oral | Other
  doseVolumeMl       Float? // Volume per dose in mL
  // Link to inventory — when this vaccine is administered, stock is deducted
  // from the InventoryItem with itemType="vaccine" linked here.
  inventoryItemId    String? // FK to InventoryItem (optional — some vaccines may not be stock-tracked)
  // Link to billing — when this vaccine is administered and createInvoice=true,
  // an InvoiceItem is created using this Service's price.
  serviceId          String? // FK to Service (optional — for billable vaccines)
  service            Service?     @relation(fields: [serviceId], references: [id])
  // Schedule metadata
  totalDosesInSeries Int          @default(1) // e.g., PENTA has 3 doses, BCG has 1
  isActive           Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  immunizations Immunization[]
  scheduleDoses VaccineScheduleDose[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
}

// =====================================================================
// VACCINE SCHEDULE DOSE — Configurable EPI schedule rules
// =====================================================================
// Each row defines when a specific dose of a vaccine is due, based on age.
// The schedule engine uses these rules + the patient's DOB + their existing
// immunization history to compute due/overdue/upcoming doses.
model VaccineScheduleDose {
  id                           String         @id @default(cuid())
  organizationId               String
  organization                 Organization   @relation(fields: [organizationId], references: [id])
  vaccineCatalogId             String
  vaccineCatalog               VaccineCatalog @relation(fields: [vaccineCatalogId], references: [id])
  doseNumber                   Int // 1, 2, 3, etc.
  doseLabel                    String // "Birth dose", "6 weeks", "10 weeks", "14 weeks", "9 months", "Booster"
  // When is this dose due? Expressed as age from birth.
  ageAtDueDays                 Int // Age in days when the dose becomes due (0 = at birth)
  ageAtOverdueDays             Int // Age in days when the dose becomes overdue (e.g., 14 days after due)
  // Interval from previous dose (for multi-dose series)
  intervalFromPreviousDoseDays Int? // Minimum days since the previous dose
  // Applicability
  appliesToSex                 String? // male | female | all (null = all) — for HPV, etc.
  isActive                     Boolean        @default(true)
  createdAt                    DateTime       @default(now())
  updatedAt                    DateTime       @updatedAt

  @@unique([vaccineCatalogId, doseNumber])
  @@index([organizationId, isActive])
}

// =====================================================================
// AEFI — Adverse Event Following Immunization
// =====================================================================
model AEFI {
  id                   String       @id @default(cuid())
  immunizationId       String
  immunization         Immunization @relation(fields: [immunizationId], references: [id], onDelete: Cascade)
  patientId            String
  patient              Patient      @relation(fields: [patientId], references: [id])
  facilityId           String
  facility             Facility     @relation(fields: [facilityId], references: [id])
  // Event details
  onsetAt              DateTime // When the adverse event started (may differ from administration time)
  reportedAt           DateTime     @default(now())
  reportedById         String?
  reportedBy           User?        @relation("aefiReportedBy", fields: [reportedById], references: [id])
  // Clinical details
  symptoms             String // Description of symptoms/event
  severity             String       @default("mild") // mild | moderate | severe | fatal
  actionTaken          String? // observation | medication | hospitalization | referral | other
  treatment            String? // Treatment provided
  outcome              String? // recovered | recovering | unresolved | death | unknown
  // Follow-up
  status               String       @default("open") // open | under_review | follow_up_required | referred | resolved | closed
  reviewedById         String?
  reviewedBy           User?        @relation("aefiReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt           DateTime?
  followUpNotes        String?
  followUpDate         DateTime?
  // Referral
  referredToFacilityId String?
  referralNotes        String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([immunizationId])
  @@index([patientId, reportedAt])
  @@index([status])
  @@index([severity])
}

// =====================================================================
// VACCINE WASTAGE — Track wasted vaccine doses
// =====================================================================
model VaccineWastage {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  facilityId      String
  facility        Facility     @relation(fields: [facilityId], references: [id])
  // What was wasted
  inventoryItemId String? // FK to InventoryItem
  batchId         String? // FK to InventoryBatch
  vaccineName     String // Snapshotted vaccine name
  batchNumber     String? // Snapshotted batch number
  quantity        Int // Number of doses wasted
  // Why
  reason          String // broken_vial | expired | damaged | cold_chain_issue | open_vial_wastage | spillage | other
  notes           String?
  // Who & when
  disposedById    String?
  disposedBy      User?        @relation("wasteDisposedBy", fields: [disposedById], references: [id])
  disposedAt      DateTime     @default(now())
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([facilityId, disposedAt])
  @@index([batchId])
  @@index([reason])
}

// =====================================================================
// COLD CHAIN ALERT — Temperature monitoring records
// =====================================================================
// Manual temperature readings + alerts. Not real-time IoT — staff record
// readings and the system flags excursions outside the safe range (2-8°C
// for most vaccines).
model ColdChainAlert {
  id                       String       @id @default(cuid())
  organizationId           String
  organization             Organization @relation(fields: [organizationId], references: [id])
  facilityId               String
  facility                 Facility     @relation(fields: [facilityId], references: [id])
  // Equipment / location
  equipmentName            String? // e.g., "Vaccine Fridge 1"
  storageLocation          String? // e.g., "Pharmacy Cold Room"
  // Reading
  temperatureC             Float // Temperature in Celsius
  recordedAt               DateTime     @default(now())
  recordedById             String?
  recordedBy               User?        @relation("coldChainRecordedBy", fields: [recordedById], references: [id])
  // Alert
  isExcursion              Boolean      @default(false) // True if outside 2-8°C range
  excursionDurationMinutes Int? // How long the excursion lasted (if known)
  notes                    String?
  // Resolution
  acknowledgedById         String?
  acknowledgedBy           User?        @relation("coldChainAckedBy", fields: [acknowledgedById], references: [id])
  acknowledgedAt           DateTime?
  resolutionNotes          String?
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  @@index([facilityId, recordedAt])
  @@index([isExcursion])
}

// =====================================================================
// AMBULANCE VEHICLE — Fleet management
// =====================================================================
model AmbulanceVehicle {
  id                   String       @id @default(cuid())
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id])
  facilityId           String
  facility             Facility     @relation(fields: [facilityId], references: [id])
  vehicleNumber        String // Internal fleet number (e.g. AMB-001)
  registrationNumber   String // License plate
  make                 String?
  model                String?
  year                 Int?
  ambulanceType        String       @default("basic_life_support") // basic_life_support | advanced_life_support | emergency | patient_transport | maternity | other
  capacity             Int          @default(2) // Seating/capacity (excluding driver)
  // Status
  status               String       @default("available") // available | dispatched | on_trip | returning | out_of_service | maintenance | unavailable
  // Equipment (JSON array of equipment profiles)
  equipmentProfile     String? // JSON: ["oxygen", "stretcher", "monitor", "defibrillator", ...]
  // Maintenance
  lastServiceDate      DateTime?
  nextServiceDate      DateTime?
  currentOdometer      Int?
  insuranceExpiry      DateTime?
  roadworthinessExpiry DateTime?
  // Metadata
  baseLocation         String?
  notes                String?
  createdById          String?
  createdBy            User?        @relation("ambulanceCreator", fields: [createdById], references: [id])
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  trips AmbulanceTrip[]

  @@unique([organizationId, vehicleNumber])
  @@index([facilityId, status])
  @@index([organizationId, status])
}

// =====================================================================
// AMBULANCE TRIP — Request + dispatch + transport + completion
// =====================================================================
model AmbulanceTrip {
  id                      String            @id @default(cuid())
  organizationId          String
  organization            Organization      @relation(fields: [organizationId], references: [id])
  facilityId              String
  facility                Facility          @relation(fields: [facilityId], references: [id])
  tripNumber              String // AMB-TRIP-YYYY-000001
  // Patient link (optional — emergency unregistered patients may not have a record yet)
  patientId               String?
  patient                 Patient?          @relation(fields: [patientId], references: [id])
  // Referral link (optional — for inter-facility transfers)
  referralId              String?
  // Service request link (optional — for support-services-originated transport)
  serviceRequestId        String?
  // Request details
  requestType             String            @default("emergency") // emergency | inter_facility | hospital_to_home | home_to_hospital | referral_transport | non_emergency | maternity | discharge | other
  priority                String            @default("urgent") // critical | high | urgent | routine | non_emergency
  // Pickup
  pickupLocation          String // Address or facility name
  pickupFacilityId        String? // If pickup is at a facility
  pickupContactName       String?
  pickupContactPhone      String?
  pickupNotes             String?
  // Destination
  destinationLocation     String
  destinationFacilityId   String?
  destinationDepartment   String?
  destinationContactName  String?
  destinationContactPhone String?
  // Clinical
  reasonForTransport      String?
  clinicalIndication      String?
  patientCondition        String? // stable | critical | serious | stable_on_oxygen | other
  mobilityRequirement     String? // ambulatory | wheelchair | stretcher | bed
  oxygenRequired          Boolean           @default(false)
  accompanyingPerson      String?
  specialRequirements     String?
  // Assignment
  vehicleId               String?
  vehicle                 AmbulanceVehicle? @relation(fields: [vehicleId], references: [id])
  driverStaffId           String? // FK to Staff/User
  crewIds                 String? // JSON array of staff IDs
  // Timeline timestamps
  requestedAt             DateTime          @default(now())
  requestedDepartureAt    DateTime?
  dispatchedAt            DateTime?
  departedAt              DateTime?
  arrivedAtPickupAt       DateTime?
  patientOnBoardAt        DateTime?
  departedPickupAt        DateTime?
  arrivedAtDestinationAt  DateTime?
  handoverAt              DateTime?
  returnedAt              DateTime?
  completedAt             DateTime?
  cancelledAt             DateTime?
  // Trip details
  startMileage            Int?
  endMileage              Int?
  distance                Float? // km
  // Billing
  serviceId               String? // FK to Service for billing
  invoiceId               String? // Link to generated invoice
  billingStatus           String            @default("unbilled") // unbilled | billed | partially_paid | paid | waived | claimed | refunded | cancelled
  // Handover
  handoverReceivedById    String? // Staff who received the patient
  handoverNotes           String?
  // Status
  status                  String            @default("requested") // requested | dispatched | en_route_pickup | at_pickup | patient_on_board | en_route_destination | at_destination | handover | returning | completed | cancelled | no_show | failed_pickup
  cancellationReason      String?
  // Metadata
  requestedById           String?
  requestedBy             User?             @relation("ambulanceRequester", fields: [requestedById], references: [id])
  dispatchedById          String?
  notes                   String?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  incidents AmbulanceIncident[]

  @@unique([organizationId, tripNumber])
  @@index([facilityId, status])
  @@index([patientId])
  @@index([vehicleId])
  @@index([status])
  @@index([priority, status])
}

// =====================================================================
// AMBULANCE INCIDENT — Trip incidents/issues
// =====================================================================
model AmbulanceIncident {
  id               String        @id @default(cuid())
  tripId           String
  trip             AmbulanceTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  organizationId   String
  incidentType     String // delay | vehicle_issue | route_issue | patient_incident | transfer_issue | other
  description      String
  actionTaken      String?
  resolution       String?
  followUpRequired Boolean       @default(false)
  reportedById     String?
  reportedAt       DateTime      @default(now())
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([tripId])
  @@index([incidentType])
}

model MaternityRecord {
  id                  String     @id @default(cuid())
  patientId           String
  patient             Patient    @relation(fields: [patientId], references: [id])
  encounterId         String?
  encounter           Encounter? @relation(fields: [encounterId], references: [id])
  facilityId          String
  facility            Facility   @relation(fields: [facilityId], references: [id])
  // Obstetric summary
  gravida             Int?
  para                Int?
  abortions           Int?
  livingChildren      Int?
  // Pregnancy dating
  lmp                 DateTime? // Last menstrual period
  eddLmp              DateTime? // EDD calculated from LMP (LMP + 280 days)
  eddUltrasound       DateTime? // EDD from ultrasound dating
  eddClinical         DateTime? // Clinically assigned EDD
  eddFinal            DateTime? // Final/active EDD (may differ from LMP-based)
  eddConfidenceReason String? // Why EDD was changed (if different from LMP-based)
  // Pregnancy details
  pregnancyNumber     Int? // Which pregnancy for this patient (1, 2, 3...)
  pregnancyStatus     String     @default("active") // active | delivered | miscarried | terminated | ectopic | referred | transferred | lost_to_followup | completed
  pregnancyType       String? // singleton | twin | triplet | higher_order
  riskLevel           String     @default("low") // low | moderate | high
  riskFactors         String? // JSON array of risk factor strings
  riskOverrideReason  String? // If clinician manually set risk level
  bloodGroup          String?
  rhStatus            String? // positive | negative
  // Clinical notes
  antenatalNotes      String?
  deliveryNotes       String?
  // Delivery summary (detailed capture in LaborAndDelivery model)
  deliveryDate        DateTime?
  deliveryType        String? // normal | cesarean | assisted | vacuum | breech
  birthOutcome        String? // live_birth | still_birth | miscarriage | neonatal_death
  // Metadata
  createdById         String?
  createdBy           User?      @relation("maternityCreator", fields: [createdById], references: [id])
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  newborns         NewbornRecord[]
  ancVisits        AncVisit[]
  laborAndDelivery LaborAndDelivery?
  postnatalVisits  PostnatalVisit[]

  @@index([patientId, pregnancyStatus])
  @@index([facilityId, pregnancyStatus])
  @@index([eddFinal])
  @@index([riskLevel, pregnancyStatus])
}

model NewbornRecord {
  id                String          @id @default(cuid())
  motherPatientId   String
  mother            Patient         @relation("newbornMother", fields: [motherPatientId], references: [id])
  patientId         String? // Link to newborn's own Patient record (created at birth)
  deliveryRecordId  String
  deliveryRecord    MaternityRecord @relation(fields: [deliveryRecordId], references: [id])
  birthDate         DateTime // Required — no default; must be explicitly set
  sex               String? // male | female | unknown
  birthWeight       Float? // kg
  birthLength       Float? // cm
  headCircumference Float? // cm
  apgar1            Int?
  apgar5            Int?
  apgar10           Int?
  gestationalAge    Int? // weeks
  feedingStatus     String? // breastfeeding | formula | mixed | not_feeding
  resuscitation     String? // none | stimulation | oxygen | bag_mask | intubation | other
  complications     String? // Free-text or JSON of neonatal complications
  outcome           String? // stable | referred | admitted_nicu | expired | transferred
  babyName          String? // Optional — may not be named at birth
  attendingStaffId  String?
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([motherPatientId])
  @@index([deliveryRecordId])
}

// =====================================================================
// ANC VISIT — Antenatal care visit record
// =====================================================================
model AncVisit {
  id                 String          @id @default(cuid())
  maternityRecordId  String
  maternityRecord    MaternityRecord @relation(fields: [maternityRecordId], references: [id], onDelete: Cascade)
  patientId          String
  patient            Patient         @relation(fields: [patientId], references: [id])
  encounterId        String? // Optional link to the encounter created for this visit
  facilityId         String
  facility           Facility        @relation(fields: [facilityId], references: [id])
  visitDate          DateTime        @default(now())
  gestationalAge     Int? // weeks at time of visit
  // Maternal vitals
  weight             Float? // kg
  bpSystolic         Int?
  bpDiastolic        Int?
  pulse              Int?
  temperature        Float? // °C
  respiratoryRate    Int?
  oxygenSaturation   Int?
  // Obstetric examination
  fundalHeight       Float? // cm
  fetalHeartRate     Int? // bpm
  fetalMovement      String? // present | reduced | absent | not_assessed
  presentation       String? // cephalic | breech | transverse | unknown
  edema              String? // none | mild | moderate | severe
  // Assessment
  symptoms           String? // Patient complaints
  clinicalAssessment String?
  riskFlags          String? // JSON array of flags
  nextVisitDate      DateTime?
  // Education
  educationTopics    String? // JSON array of topics covered
  notes              String?
  recordedById       String?
  recordedBy         User?           @relation("ancVisitRecorder", fields: [recordedById], references: [id])
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([maternityRecordId, visitDate])
  @@index([patientId, visitDate])
  @@index([facilityId, visitDate])
}

// =====================================================================
// LABOR & DELIVERY — Structured labor monitoring + delivery record
// =====================================================================
model LaborAndDelivery {
  id                     String          @id @default(cuid())
  maternityRecordId      String          @unique // 1:1 with MaternityRecord
  maternityRecord        MaternityRecord @relation(fields: [maternityRecordId], references: [id], onDelete: Cascade)
  patientId              String
  patient                Patient         @relation("laborPatient", fields: [patientId], references: [id])
  facilityId             String
  facility               Facility        @relation(fields: [facilityId], references: [id])
  // Admission
  admissionDate          DateTime? // When admitted for labor
  admissionId            String? // Link to Admission record (no FK to avoid circular)
  // Labor assessment
  onsetOfLabor           DateTime?
  ruptureOfMembranes     DateTime? // Time of ROM
  membraneStatus         String? // intact | ruptured | artificial_rupture
  liquorColor            String? // clear | meconium_stained | blood_stained | absent
  // Cervical assessment
  cervicalDilation       Int? // cm (0-10)
  effacement             Int? // percentage
  station                Int? // -3 to +3
  // Contractions
  contractionFreq        Int? // contractions per 10 minutes
  contractionDur         Int? // duration in seconds
  contractionStrength    String? // mild | moderate | strong
  // Fetal monitoring
  fetalHeartRate         Int? // bpm
  fetalHeartRateAbnormal Boolean         @default(false)
  // Maternal vitals during labor
  maternalPulse          Int?
  maternalBpSystolic     Int?
  maternalBpDiastolic    Int?
  maternalTemp           Float?
  // Delivery
  deliveryDate           DateTime?
  deliveryType           String? // spontaneous_vaginal | assisted_vaginal | cesarean | breech | vacuum | forceps
  deliveryIndication     String? // Indication for C-section/assisted
  presentation           String? // cephalic | breech | transverse | compound
  episiotomy             Boolean         @default(false)
  episiotomyType         String? // midline | mediolateral
  // Post-delivery
  placentaDelivered      Boolean         @default(false)
  placentaCondition      String? // complete | incomplete | retained
  estimatedBloodLoss     Int? // mL
  oxytocinUsed           Boolean         @default(false)
  ivFluidsGiven          String?
  urineOutput            String?
  // Complications
  maternalComplications  String? // JSON array or free-text
  neonatalComplications  String?
  // Outcomes
  maternalOutcome        String? // stable | referred | transferred | postpartum_complication | expired
  // Staff
  attendingClinicianId   String?
  attendingMidwifeId     String?
  attendingClinician     User?           @relation("laborClinician", fields: [attendingClinicianId], references: [id])
  attendingMidwife       User?           @relation("laborMidwife", fields: [attendingMidwifeId], references: [id])
  // Partograph data (JSON — flexible key-value for time-series readings)
  partographData         String? // JSON: [{ time, dilation, fhr, pulse, bp, contractions, ... }]
  notes                  String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  @@index([maternityRecordId])
  @@index([patientId, deliveryDate])
  @@index([facilityId, deliveryDate])
}

// =====================================================================
// POSTNATAL VISIT — Postnatal care visit record
// =====================================================================
model PostnatalVisit {
  id                       String          @id @default(cuid())
  maternityRecordId        String
  maternityRecord          MaternityRecord @relation(fields: [maternityRecordId], references: [id], onDelete: Cascade)
  patientId                String
  patient                  Patient         @relation("postnatalPatient", fields: [patientId], references: [id])
  facilityId               String
  facility                 Facility        @relation(fields: [facilityId], references: [id])
  visitDate                DateTime        @default(now())
  visitType                String          @default("routine") // 6h | 6d | 6w | routine | follow_up
  // Maternal assessment
  maternalStatus           String? // stable | complicated | critical
  bpSystolic               Int?
  bpDiastolic              Int?
  pulse                    Int?
  temperature              Float?
  bleeding                 String? // normal | light | moderate | heavy
  pain                     String? // none | mild | moderate | severe
  woundCondition           String? // clean | inflamed | infected | dehisced | n/a
  uterineAssessment        String? // well_involved | subinvolved | boggy
  breastfeeding            String? // established | difficulty | not_feeding | mixed
  emotionalStatus          String? // well | low_mood | distressed | referral_needed
  // Newborn status (if applicable)
  newbornStatus            String? // healthy | concerns | referred | admitted
  newbornNotes             String?
  // Education + planning
  familyPlanningCounseling Boolean         @default(false)
  familyPlanningMethod     String? // none | pills | iud | implant | injection | condoms | permanent | other
  educationTopics          String? // JSON array
  // Follow-up
  nextFollowUpDate         DateTime?
  notes                    String?
  recordedById             String?
  recordedBy               User?           @relation("postnatalRecorder", fields: [recordedById], references: [id])
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  @@index([maternityRecordId, visitDate])
  @@index([patientId, visitDate])
}

// ---------------------------------------------------------------------
// BILLING & FINANCE
// ---------------------------------------------------------------------

model Service {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  name            String
  shortName       String?
  code            String
  category        String? // consultation | lab | imaging | procedure | pharmacy | admission | nursing | theatre | maternity | emergency | dental | eye | ent | physiotherapy | immunization | blood_bank | ambulance | medical_report | health_screening | administrative | other
  serviceType     String? // consultation | investigation | procedure | treatment | admission | bed_room | professional | diagnostic | pharmacy_service | nursing_service | theatre_service | emergency_service | administrative_service | other
  departmentId    String?
  department      Department?  @relation(fields: [departmentId], references: [id])
  unitId          String?
  unit            Unit?        @relation(fields: [unitId], references: [id])
  description     String?
  // Pricing
  defaultPrice    Float        @default(0)
  nhisPrice       Float? // NHIS-insured price/tariff
  insurancePrice  Float? // Private insurance price
  cashPrice       Float? // Cash price (if different from default)
  // Billing flags
  isBillable      Boolean      @default(true)
  isTaxable       Boolean      @default(false)
  nhisEligible    Boolean      @default(false)
  nhisServiceCode String? // NHIS tariff/service code
  // Unit of measure
  unitOfMeasure   String? // service | visit | test | procedure | day | hour | session | item | other
  // Status
  status          String       @default("active") // active | inactive | archived | temporarily_unavailable
  // Ownership
  createdById     String?
  createdBy       User?        @relation("serviceCreator", fields: [createdById], references: [id])
  updatedById     String?
  updatedBy       User?        @relation("serviceUpdater", fields: [updatedById], references: [id])
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  facilityPrices  FacilityServicePrice[]
  priceHistory    ServicePriceHistory[]
  invoiceItems    InvoiceItem[]
  vaccineCatalogs VaccineCatalog[]
  packageItems    ServicePackageItem[]

  @@unique([organizationId, code])
  @@index([departmentId])
  @@index([organizationId, status])
  @@index([organizationId, category])
  @@index([organizationId, serviceType])
}

model FacilityServicePrice {
  id            String    @id @default(cuid())
  facilityId    String
  facility      Facility  @relation(fields: [facilityId], references: [id])
  serviceId     String
  service       Service   @relation(fields: [serviceId], references: [id])
  price         Float
  nhisPrice     Float? // Facility-specific NHIS price override
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  status        String    @default("active")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([facilityId, serviceId])
  @@index([serviceId])
  @@index([facilityId])
}

// =====================================================================
// SERVICE PRICE HISTORY — Track all price changes for audit
// =====================================================================
model ServicePriceHistory {
  id             String   @id @default(cuid())
  organizationId String
  serviceId      String
  service        Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  facilityId     String? // null = org-level default price change
  // Price snapshot
  oldPrice       Float?
  newPrice       Float
  priceType      String   @default("default") // default | nhis | insurance | cash | facility
  // Metadata
  effectiveDate  DateTime @default(now())
  reason         String?
  changedById    String?
  changedBy      User?    @relation("servicePriceChanger", fields: [changedById], references: [id])
  createdAt      DateTime @default(now())

  @@index([serviceId, effectiveDate])
  @@index([organizationId, effectiveDate])
}

// =====================================================================
// SERVICE PACKAGE — Bundled services with package pricing
// =====================================================================
// A package groups multiple services together with a single package price.
// When billed, the package creates invoice items for each component
// service at zero cost (or the package price as a single line item),
// preventing double-charging of components.
model ServicePackage {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  code           String // e.g. MAT-PKG-001, ANC-PKG-001
  description    String?
  // Pricing
  packagePrice   Float        @default(0)
  nhisPrice      Float? // NHIS tariff for the package
  // Validity
  effectiveFrom  DateTime     @default(now())
  effectiveTo    DateTime?
  isActive       Boolean      @default(true)
  // Metadata
  status         String       @default("active") // active | inactive | archived
  createdById    String?
  createdBy      User?        @relation("packageCreator", fields: [createdById], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  components ServicePackageItem[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
  @@index([organizationId, status])
}

// =====================================================================
// SERVICE PACKAGE ITEM — Component services within a package
// =====================================================================
model ServicePackageItem {
  id            String         @id @default(cuid())
  packageId     String
  package       ServicePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  serviceId     String
  service       Service        @relation(fields: [serviceId], references: [id])
  quantity      Int            @default(1)
  // Optional: override the component's price within this package
  // (null = use package price; set = charge this amount for this component)
  overridePrice Float?
  isMandatory   Boolean        @default(true) // If false, can be optionally included
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now())

  @@index([packageId])
  @@index([serviceId])
}

model Invoice {
  id                      String     @id @default(cuid())
  patientId               String
  patient                 Patient    @relation(fields: [patientId], references: [id])
  encounterId             String?
  encounter               Encounter? @relation(fields: [encounterId], references: [id])
  admissionId             String?
  facilityId              String
  facility                Facility   @relation(fields: [facilityId], references: [id])
  invoiceNumber           String
  invoiceType             String     @default("patient") // patient | outpatient | inpatient | emergency | pharmacy | laboratory | imaging | procedure | theatre | maternity | ambulance | corporate | insurance | nhis | other
  status                  String     @default("draft") // draft | pending_review | approved | issued | partially_paid | paid | overdue | cancelled | voided | refunded | written_off
  payerType               String     @default("self_pay") // self_pay | nhis | private_insurance | corporate | employer | government | other
  // Financial fields
  subtotal                Float      @default(0)
  discount                Float      @default(0)
  discountReason          String?
  discountApprovedById    String?
  tax                     Float      @default(0)
  taxRate                 Float      @default(0)
  total                   Float      @default(0)
  amountPaid              Float      @default(0)
  amountRefunded          Float      @default(0)
  amountCredited          Float      @default(0)
  balance                 Float      @default(0)
  // Payer responsibility
  payerResponsibility     Float      @default(0)
  patientResponsibility   Float      @default(0)
  insuranceResponsibility Float      @default(0)
  nhisResponsibility      Float      @default(0)
  // Insurance/NHIS
  insuranceProviderId     String?
  insurancePolicyNumber   String?
  insuranceAuthorization  String?
  nhisNumber              String?
  nhisClaimId             String?
  // Corporate
  corporateName           String?
  corporateAccountNumber  String?
  // Currency
  currency                String     @default("GHS")
  // Lifecycle timestamps
  issuedAt                DateTime?
  dueAt                   DateTime?
  reviewedAt              DateTime?
  reviewedById            String?
  approvedAt              DateTime?
  approvedById            String?
  issuedById              String?
  voidedAt                DateTime?
  voidedById              String?
  voidReason              String?
  cancelledAt             DateTime?
  cancelledById           String?
  cancelReason            String?
  refundedAt              DateTime?
  writtenOffAt            DateTime?
  writtenOffById          String?
  writeOffReason          String?
  writeOffAmount          Float?
  // Notes
  internalNotes           String?
  patientNotes            String?
  paymentTerms            String?
  // Audit
  createdById             String?
  createdBy               User?      @relation("invoiceCreator", fields: [createdById], references: [id])
  reviewedBy              User?      @relation("invoiceReviewer", fields: [reviewedById], references: [id])
  approvedBy              User?      @relation("invoiceApprover", fields: [approvedById], references: [id])
  issuedBy                User?      @relation("invoiceIssuer", fields: [issuedById], references: [id])
  voidedBy                User?      @relation("invoiceVoider", fields: [voidedById], references: [id])
  cancelledBy             User?      @relation("invoiceCanceller", fields: [cancelledById], references: [id])
  writtenOffBy            User?      @relation("invoiceWriteOff", fields: [writtenOffById], references: [id])
  discountApprovedBy      User?      @relation("invoiceDiscountApprover", fields: [discountApprovedById], references: [id])
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt

  items           InvoiceItem[]
  payments        Payment[]
  refunds         Refund[]
  insuranceClaims InsuranceClaim[]
  creditNotes     CreditNote[]
  adjustments     InvoiceAdjustment[]

  @@unique([facilityId, invoiceNumber])
  @@index([patientId, status])
  @@index([facilityId, status, issuedAt])
  @@index([status, dueAt])
  @@index([payerType, status])
  @@index([invoiceType, status])
}

model InvoiceItem {
  id            String   @id @default(cuid())
  invoiceId     String
  invoice       Invoice  @relation(fields: [invoiceId], references: [id])
  serviceId     String?
  service       Service? @relation(fields: [serviceId], references: [id])
  description   String
  quantity      Int      @default(1)
  unitPrice     Float    @default(0)
  discount      Float    @default(0)
  tax           Float    @default(0)
  total         Float    @default(0)
  referenceType String? // consultation | lab_order | prescription | procedure | imaging_order | admission
  referenceId   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([invoiceId])
}

model Payment {
  id                   String   @id @default(cuid())
  invoiceId            String
  invoice              Invoice  @relation(fields: [invoiceId], references: [id])
  patientId            String
  patient              Patient  @relation(fields: [patientId], references: [id])
  facilityId           String
  facility             Facility @relation(fields: [facilityId], references: [id])
  paymentNumber        String
  amount               Float
  paymentMethod        String // cash | mobile_money | card | bank | insurance | other
  transactionReference String?
  status               String   @default("completed") // pending | completed | failed | reversed
  receivedById         String?
  receivedBy           User?    @relation("paymentReceiver", fields: [receivedById], references: [id])
  receivedAt           DateTime @default(now())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  refunds Refund[]

  @@unique([facilityId, paymentNumber])
  @@index([patientId, receivedAt])
  @@index([facilityId, receivedAt])
}

model Refund {
  id                String    @id @default(cuid())
  refundNumber      String?   @unique // REF-2026-000001
  paymentId         String
  payment           Payment   @relation(fields: [paymentId], references: [id])
  invoiceId         String
  invoice           Invoice   @relation(fields: [invoiceId], references: [id])
  patientId         String?
  facilityId        String?
  // Refund details
  amount            Float
  approvedAmount    Float?
  processedAmount   Float?
  reason            String?
  refundType        String    @default("full") // full | partial | overpayment | deposit | credit_balance | duplicate_payment | service_cancellation | payment_error | other
  refundSource      String? // patient_payment | insurance_payment | nhis_payment | corporate_payment | patient_deposit | credit_balance
  refundMethod      String? // cash | mobile_money | card | bank | original_method | patient_credit | other
  externalReference String?
  notes             String?
  // Status lifecycle
  status            String    @default("pending") // pending | reviewed | approved | rejected | processing | completed | cancelled | reversed | failed
  // Workflow timestamps
  reviewedAt        DateTime?
  reviewedById      String?
  approvedAt        DateTime?
  approvedById      String?
  rejectedAt        DateTime?
  rejectedById      String?
  rejectionReason   String?
  processedAt       DateTime?
  processedById     String?
  cancelledAt       DateTime?
  cancelledById     String?
  cancelReason      String?
  reversedAt        DateTime?
  reversedById      String?
  reversalReason    String?
  failedAt          DateTime?
  failureReason     String?
  retryCount        Int       @default(0)
  // Verification
  verifiedAt        DateTime?
  verifiedById      String?
  // Users
  requestedById     String?
  requestedBy       User?     @relation("refundRequestedBy", fields: [requestedById], references: [id])
  reviewedBy        User?     @relation("refundReviewedBy", fields: [reviewedById], references: [id])
  approvedBy        User?     @relation("refundApprovedBy", fields: [approvedById], references: [id])
  rejectedBy        User?     @relation("refundRejectedBy", fields: [rejectedById], references: [id])
  processedBy       User?     @relation("refundProcessedBy", fields: [processedById], references: [id])
  cancelledBy       User?     @relation("refundCancelledBy", fields: [cancelledById], references: [id])
  reversedBy        User?     @relation("refundReversedBy", fields: [reversedById], references: [id])
  verifiedBy        User?     @relation("refundVerifiedBy", fields: [verifiedById], references: [id])
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([paymentId, status])
  @@index([invoiceId, status])
  @@index([status, createdAt])
  @@index([facilityId, status])
  @@index([refundType, status])
  @@index([refundMethod, status])
}

// ---------------------------------------------------------------------
// CREDIT NOTE — for billing corrections, overbilling, approved discounts
//   after issuance, returned services. References the original invoice.
// ---------------------------------------------------------------------
model CreditNote {
  id               String    @id @default(cuid())
  creditNoteNumber String
  invoiceId        String
  invoice          Invoice   @relation(fields: [invoiceId], references: [id])
  facilityId       String
  facility         Facility  @relation(fields: [facilityId], references: [id])
  patientId        String
  patient          Patient   @relation(fields: [patientId], references: [id])
  amount           Float
  reason           String
  description      String?
  status           String    @default("draft") // draft | issued | applied | reversed
  issuedAt         DateTime?
  issuedById       String?
  issuedBy         User?     @relation("creditNoteIssuer", fields: [issuedById], references: [id])
  appliedAt        DateTime?
  reversedAt       DateTime?
  reversalReason   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([facilityId, creditNoteNumber])
  @@index([invoiceId])
  @@index([patientId])
  @@index([status, issuedAt])
}

// ---------------------------------------------------------------------
// INVOICE ADJUSTMENT — for any financial adjustment after issuance
//   (debit notes, write-offs, corrections)
// ---------------------------------------------------------------------
model InvoiceAdjustment {
  id             String    @id @default(cuid())
  invoiceId      String
  invoice        Invoice   @relation(fields: [invoiceId], references: [id])
  adjustmentType String // debit | credit | write_off | correction | other
  amount         Float
  reason         String
  description    String?
  approvedById   String?
  approvedBy     User?     @relation("adjustmentApprover", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([invoiceId])
  @@index([adjustmentType])
}

model InsuranceClaim {
  id                        String            @id @default(cuid())
  patientId                 String
  patient                   Patient           @relation(fields: [patientId], references: [id])
  facilityId                String
  facility                  Facility          @relation(fields: [facilityId], references: [id])
  insuranceProviderId       String
  insuranceProvider         InsuranceProvider @relation(fields: [insuranceProviderId], references: [id])
  invoiceId                 String
  invoice                   Invoice           @relation(fields: [invoiceId], references: [id])
  encounterId               String? // link to encounter for diagnosis traceability
  claimNumber               String
  claimAmount               Float             @default(0)
  approvedAmount            Float             @default(0)
  // Ghana NHIS compliance fields
  claimType                 String            @default("outpatient") // outpatient | inpatient | day_case
  nhisNumber                String? // patient's NHIS membership number (or Ghana Card merged)
  primaryDiagnosisCode      String? // ICD-10 code — primary (snapshotted from Diagnosis)
  primaryDiagnosisName      String? // ICD-10 name — primary
  primaryDiagnosisCatalogId String? // link to catalog
  secondaryDiagnosisCodes   String? // JSON array of {code, name} — secondary diagnoses
  gdrgCode                  String? // Ghana DRG code for this claim
  gdrgName                  String? // Ghana DRG description
  nhisTariff                Float? // NHIS tariff amount for this G-DRG
  isNhisValidated           Boolean           @default(false) // passed NHIS validation checks
  nhisValidationNotes       String? // validation messages (missing ICD-10, invalid NHIS #, etc.)
  claimSubmissionRef        String? // reference from CLAIM-it system
  batchId                   String?
  status                    String            @default("draft") // draft | submitted | approved | partially_approved | rejected | paid | resubmitted
  submittedAt               DateTime?
  approvedAt                DateTime?
  rejectedAt                DateTime?
  rejectionReason           String?
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt

  claimDiagnoses ClaimDiagnosis[]
  claimItems     ClaimItem[]
  claimQueries   ClaimQuery[]
  claimPayments  ClaimPayment[]
  batch          ClaimBatch?      @relation("claims", fields: [batchId], references: [id])

  @@unique([facilityId, claimNumber])
  @@index([patientId])
  @@index([encounterId])
  @@index([status])
  @@index([primaryDiagnosisCode])
}

// ---------------------------------------------------------------------
// CLAIM DIAGNOSIS — Multiple diagnoses attached to an insurance claim
// (NHIS allows primary + multiple secondary diagnoses per claim)
// ---------------------------------------------------------------------
model ClaimDiagnosis {
  id            String            @id @default(cuid())
  claimId       String
  claim         InsuranceClaim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  catalogId     String?
  catalog       DiagnosisCatalog? @relation(fields: [catalogId], references: [id])
  diagnosisCode String // ICD-10 code (snapshotted)
  diagnosisName String // ICD-10 name (snapshotted)
  diagnosisType String            @default("primary") // primary | secondary | complication
  isPrimary     Boolean           @default(false)
  createdAt     DateTime          @default(now())

  @@index([claimId])
  @@index([catalogId])
}

// ---------------------------------------------------------------------
// CLAIM ITEMS — Structured line items per claim (services, meds, labs)
// ---------------------------------------------------------------------
model ClaimItem {
  id               String         @id @default(cuid())
  claimId          String
  claim            InsuranceClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  itemType         String // consultation | lab | pharmacy | imaging | procedure | bed_charge | other
  serviceCode      String? // NHIS/payer service code
  description      String // service name / description
  serviceDate      DateTime       @default(now())
  quantity         Int            @default(1)
  unitPrice        Float          @default(0)
  claimedAmount    Float          @default(0)
  approvedAmount   Float?
  rejectedAmount   Float?
  adjustmentReason String?
  status           String         @default("pending") // pending | approved | rejected | adjusted
  createdAt        DateTime       @default(now())

  @@index([claimId])
  @@index([itemType])
}

// ---------------------------------------------------------------------
// CLAIM BATCHES — Group multiple claims for batch submission
// ---------------------------------------------------------------------
model ClaimBatch {
  id                  String    @id @default(cuid())
  organizationId      String
  facilityId          String?
  batchNumber         String    @unique
  insuranceProviderId String
  claimCount          Int       @default(0)
  totalAmount         Float     @default(0)
  status              String    @default("draft") // draft | validated | submitted | failed | accepted | rejected | partially_accepted | reconciled
  submissionMethod    String    @default("manual") // manual | electronic
  submissionRef       String? // external submission reference
  submittedAt         DateTime?
  submittedById       String?
  submittedByName     String?
  responseReceivedAt  DateTime?
  responseNotes       String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  claims InsuranceClaim[] @relation("claims")

  @@index([organizationId, facilityId])
  @@index([status])
}

// ---------------------------------------------------------------------
// CLAIM QUERIES — Track payer queries on claims
// ---------------------------------------------------------------------
model ClaimQuery {
  id               String         @id @default(cuid())
  claimId          String
  claim            InsuranceClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  queryReason      String // e.g., "Missing diagnosis", "Invalid member number"
  queryCode        String? // payer-specific query code
  queriedAt        DateTime       @default(now())
  responseDeadline DateTime?
  assignedToId     String?
  assignedToName   String?
  response         String?
  responseAt       DateTime?
  status           String         @default("open") // open | assigned | in_progress | responded | resubmitted | closed
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([claimId])
  @@index([status])
}

// ---------------------------------------------------------------------
// CLAIM PAYMENTS — Track payer payments separately from invoice payments
// ---------------------------------------------------------------------
model ClaimPayment {
  id               String         @id @default(cuid())
  claimId          String
  claim            InsuranceClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  paymentReference String? // payer payment reference
  paymentDate      DateTime       @default(now())
  amount           Float          @default(0)
  adjustment       Float          @default(0)
  paymentStatus    String         @default("received") // received | cleared | disputed
  notes            String?
  recordedById     String?
  recordedByName   String?
  createdAt        DateTime       @default(now())

  @@index([claimId])
}

// ---------------------------------------------------------------------
// ELIGIBILITY VERIFICATION — Track NHIS/insurance eligibility checks
// ---------------------------------------------------------------------
model EligibilityVerification {
  id                    String    @id @default(cuid())
  organizationId        String
  patientId             String
  patient               Patient   @relation(fields: [patientId], references: [id])
  insuranceProviderId   String?
  membershipNumber      String?
  verificationDate      DateTime  @default(now())
  verificationStatus    String    @default("not_verified") // not_verified | verified | active | inactive | expired | unable_to_verify | pending
  coverageStatus        String? // active | expired | suspended
  coverageStart         DateTime?
  coverageEnd           DateTime?
  verificationSource    String    @default("manual") // manual | api | card_check
  verificationReference String? // external reference
  verifiedById          String?
  verifiedByName        String?
  notes                 String?
  createdAt             DateTime  @default(now())

  @@index([patientId])
  @@index([organizationId])
  @@index([verificationStatus])
}

// ---------------------------------------------------------------------
// INVENTORY & PROCUREMENT
// ---------------------------------------------------------------------

model InventoryItem {
  id                  String       @id @default(cuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id])
  name                String
  sku                 String
  barcode             String?
  itemType            String // medication | consumable | equipment | supply | other
  category            String?
  subcategory         String?
  unit                String?
  packSize            String?
  description         String?
  reorderLevel        Int          @default(0)
  minimumStock        Int          @default(0)
  maximumStock        Int          @default(0)
  reorderQuantity     Int          @default(0)
  safetyStock         Int          @default(0)
  manufacturer        String?
  brand               String?
  countryOfOrigin     String?
  storageConditions   String?
  isControlled        Boolean      @default(false)
  isConsumable        Boolean      @default(true)
  isRefrigerated      Boolean      @default(false)
  isHazardous         Boolean      @default(false)
  isSterile           Boolean      @default(false)
  preferredSupplierId String?
  status              String       @default("active") // active | inactive | discontinued | blocked | recalled
  medicationId        String?
  medication          Medication?  @relation("medicationInventoryItem", fields: [medicationId], references: [id])
  createdById         String?
  createdBy           User?        @relation("inventoryItemCreator", fields: [createdById], references: [id])
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  facilityInventory     FacilityInventory[]
  purchaseOrderItems    PurchaseOrderItem[]
  stockTransferItems    StockTransferItem[]
  inventoryTransactions InventoryTransaction[]
  stockAdjustments      StockAdjustment[]
  supplierProducts      SupplierProduct[]

  @@unique([organizationId, sku])
  @@index([itemType, status])
  @@index([category])
}

model FacilityInventory {
  id                  String        @id @default(cuid())
  facilityId          String
  facility            Facility      @relation(fields: [facilityId], references: [id])
  inventoryItemId     String
  inventoryItem       InventoryItem @relation(fields: [inventoryItemId], references: [id])
  currentQuantity     Int           @default(0)
  reservedQuantity    Int           @default(0)
  quarantinedQuantity Int           @default(0)
  damagedQuantity     Int           @default(0)
  minimumQuantity     Int           @default(0)
  maximumQuantity     Int           @default(0)
  storageLocation     String?
  storeName           String?
  binLocation         String?
  lastCostPrice       Float         @default(0)
  averageCost         Float         @default(0)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  batches InventoryBatch[]

  @@unique([facilityId, inventoryItemId])
  @@index([facilityId, currentQuantity])
}

model InventoryBatch {
  id                  String            @id @default(cuid())
  facilityInventoryId String
  facilityInventory   FacilityInventory @relation(fields: [facilityInventoryId], references: [id])
  batchNumber         String
  expiryDate          DateTime?
  manufactureDate     DateTime?
  quantity            Int               @default(0)
  costPrice           Float             @default(0)
  sellingPrice        Float             @default(0)
  supplierId          String?
  supplier            Supplier?         @relation(fields: [supplierId], references: [id])
  purchaseOrderId     String?
  goodsReceivedId     String?
  receivedAt          DateTime          @default(now())
  status              String            @default("active") // active | expired | damaged | depleted | quarantined | recalled
  notes               String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  transactions InventoryTransaction[]

  @@index([facilityInventoryId, expiryDate])
  @@index([status, expiryDate])
  @@index([supplierId])
}

model InventoryTransaction {
  id              String          @id @default(cuid())
  facilityId      String
  facility        Facility        @relation(fields: [facilityId], references: [id])
  inventoryItemId String
  inventoryItem   InventoryItem   @relation(fields: [inventoryItemId], references: [id])
  batchId         String?
  batch           InventoryBatch? @relation(fields: [batchId], references: [id])
  transactionType String // purchase | dispense | issue | receive | adjustment | return | transfer_out | transfer_in | damage | expiry | disposal | opening_balance | stocktake_adjustment | reversal
  quantity        Int // signed (+/-)
  balanceBefore   Int?
  balanceAfter    Int?
  unitCost        Float?
  totalValue      Float?
  referenceType   String?
  referenceId     String?
  performedById   String?
  performedBy     User?           @relation(fields: [performedById], references: [id])
  transactionAt   DateTime        @default(now())
  reason          String?
  notes           String?
  createdAt       DateTime        @default(now())

  @@index([facilityId, transactionAt])
  @@index([inventoryItemId])
  @@index([transactionType, transactionAt])
  @@index([batchId])
}

model Supplier {
  id                 String       @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id])
  name               String
  code               String
  contactPerson      String?
  phone              String?
  email              String?
  address            String?
  status             String       @default("active")
  // --- New: classification ---
  supplierType       String? // manufacturer | distributor | wholesaler | retailer | importer | local_supplier | service_provider | equipment_vendor | contractor | other
  category           String? // pharmaceutical | medical_supplies | laboratory | reagents | medical_equipment | surgical | ppe | cleaning | office_supplies | it | maintenance | furniture | ambulance | mortuary | imaging | blood_bank | catering | security | facility_services | other
  // --- New: business identity ---
  legalBusinessName  String?
  tradingName        String?
  vendorId           String?
  registrationNumber String?
  taxIdNumber        String?
  vatStatus          String? // registered | not_registered | exempt
  // --- New: contact details ---
  website            String?
  alternatePhone     String?
  postalAddress      String?
  city               String?
  region             String?
  country            String?
  digitalAddress     String? // Ghana Post GPS
  // --- New: payment & banking ---
  paymentTerms       String? // cash | immediate | 7_days | 15_days | 30_days | 45_days | 60_days | 90_days | custom
  creditLimit        Float        @default(0)
  bankName           String?
  bankAccountName    String?
  bankAccountNumber  String?
  bankBranch         String?
  swiftCode          String?
  // --- New: compliance & preferences ---
  isPreferred        Boolean      @default(false)
  complianceStatus   String? // compliant | partially_compliant | non_compliant | under_review
  // --- New: lifecycle / approval workflow ---
  approvedById       String?
  approvedBy         User?        @relation("supplierApprovedBy", fields: [approvedById], references: [id])
  approvedAt         DateTime?
  verifiedById       String?
  verifiedBy         User?        @relation("supplierVerifiedBy", fields: [verifiedById], references: [id])
  verifiedAt         DateTime?
  suspendedAt        DateTime?
  suspendedById      String?
  suspendedBy        User?        @relation("supplierSuspendedBy", fields: [suspendedById], references: [id])
  suspensionReason   String?
  // --- New: performance metrics ---
  performanceRating  Float? // 0-100
  totalSpend         Float        @default(0)
  totalOrders        Int          @default(0)
  // --- New: ownership ---
  createdById        String?
  createdBy          User?        @relation("supplierCreatedBy", fields: [createdById], references: [id])
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  purchaseOrders   PurchaseOrder[]
  batches          InventoryBatch[]
  contacts         SupplierContact[]
  documents        SupplierDocument[]
  supplierProducts SupplierProduct[]
  evaluations      SupplierEvaluation[]
  complaints       SupplierComplaint[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, category])
  @@index([organizationId, supplierType])
  @@index([organizationId, isPreferred])
  @@index([organizationId, complianceStatus])
}

model SupplierContact {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  name       String
  position   String?
  phone      String?
  email      String?
  department String?
  isPrimary  Boolean  @default(false)
  status     String   @default("active") // active | inactive
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([supplierId, isPrimary])
  @@index([supplierId, status])
}

model SupplierDocument {
  id                 String    @id @default(cuid())
  supplierId         String
  supplier           Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  documentType       String // business_registration | tax_clearance | vat_certificate | iso_certificate | license | insurance | contract | other
  documentName       String
  issueDate          DateTime?
  expiryDate         DateTime?
  verifiedById       String?
  verifiedBy         User?     @relation("supplierDocVerifiedBy", fields: [verifiedById], references: [id])
  verifiedAt         DateTime?
  verificationStatus String    @default("pending") // pending | verified | rejected | expired
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([supplierId, verificationStatus])
  @@index([supplierId, expiryDate])
}

model SupplierProduct {
  id                   String        @id @default(cuid())
  supplierId           String
  supplier             Supplier      @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  inventoryItemId      String
  inventoryItem        InventoryItem @relation(fields: [inventoryItemId], references: [id])
  supplierItemCode     String?
  supplierSku          String?
  purchasePrice        Float         @default(0)
  minimumOrderQuantity Int           @default(1)
  leadTimeDays         Int           @default(0)
  isPreferred          Boolean       @default(false)
  lastPurchasePrice    Float         @default(0)
  lastPurchaseDate     DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@unique([supplierId, inventoryItemId])
  @@index([supplierId, isPreferred])
  @@index([inventoryItemId])
}

model SupplierEvaluation {
  id               String    @id @default(cuid())
  supplierId       String
  supplier         Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  evaluationPeriod String // e.g. "2026-Q1", "2026"
  criteria         String // quality | delivery | pricing | responsiveness | overall
  score            Float // 0-100
  comments         String?
  evaluatedById    String?
  evaluatedBy      User?     @relation("supplierEvaluatedBy", fields: [evaluatedById], references: [id])
  evaluatedAt      DateTime  @default(now())
  facilityId       String?
  facility         Facility? @relation(fields: [facilityId], references: [id])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([supplierId, evaluationPeriod])
  @@index([supplierId, criteria])
}

model SupplierComplaint {
  id              String         @id @default(cuid())
  supplierId      String
  supplier        Supplier       @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  complaintType   String // quality | delivery | pricing | communication | documentation | other
  subject         String
  description     String?
  severity        String         @default("medium") // low | medium | high | critical
  status          String         @default("open") // open | investigating | resolved | closed | escalated
  resolvedAt      DateTime?
  resolvedById    String?
  resolvedBy      User?          @relation("supplierComplaintResolvedBy", fields: [resolvedById], references: [id])
  resolutionNotes String?
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  facilityId      String?
  facility        Facility?      @relation(fields: [facilityId], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([supplierId, status])
  @@index([supplierId, severity])
}

model PurchaseOrder {
  id                  String    @id @default(cuid())
  facilityId          String
  facility            Facility  @relation(fields: [facilityId], references: [id])
  supplierId          String
  supplier            Supplier  @relation(fields: [supplierId], references: [id])
  purchaseOrderNumber String
  status              String    @default("draft") // draft | submitted | approved | ordered | partially_received | received | cancelled
  subtotal            Float     @default(0)
  tax                 Float     @default(0)
  total               Float     @default(0)
  requestedById       String?
  requestedBy         User?     @relation("poRequestedBy", fields: [requestedById], references: [id])
  approvedById        String?
  approvedBy          User?     @relation("poApprovedBy", fields: [approvedById], references: [id])
  approvedAt          DateTime?
  orderedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  items              PurchaseOrderItem[]
  goodsReceived      GoodsReceived[]
  supplierComplaints SupplierComplaint[]

  @@unique([facilityId, purchaseOrderNumber])
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  quantity        Int           @default(0)
  unitPrice       Float         @default(0)
  total           Float         @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model GoodsReceived {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  facilityId      String
  facility        Facility      @relation(fields: [facilityId], references: [id])
  receivedById    String?
  receivedBy      User?         @relation("goodsReceivedBy", fields: [receivedById], references: [id])
  receivedAt      DateTime      @default(now())
  referenceNumber String?
  notes           String?
  createdAt       DateTime      @default(now())
}

model StockTransfer {
  id             String    @id @default(cuid())
  fromFacilityId String
  fromFacility   Facility  @relation("stockFromFacility", fields: [fromFacilityId], references: [id])
  toFacilityId   String
  toFacility     Facility  @relation("stockToFacility", fields: [toFacilityId], references: [id])
  transferNumber String
  status         String    @default("requested") // requested | approved | shipped | received | cancelled
  requestedById  String?
  requestedBy    User?     @relation("stRequestedBy", fields: [requestedById], references: [id])
  approvedById   String?
  approvedBy     User?     @relation("stApprovedBy", fields: [approvedById], references: [id])
  receivedById   String?
  receivedBy     User?     @relation("stReceivedBy", fields: [receivedById], references: [id])
  requestedAt    DateTime  @default(now())
  approvedAt     DateTime?
  shippedAt      DateTime?
  receivedAt     DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  items StockTransferItem[]
}

model StockTransferItem {
  id               String        @id @default(cuid())
  stockTransferId  String
  stockTransfer    StockTransfer @relation(fields: [stockTransferId], references: [id])
  inventoryItemId  String
  inventoryItem    InventoryItem @relation(fields: [inventoryItemId], references: [id])
  batchId          String?
  quantity         Int           @default(0)
  receivedQuantity Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

// ---------------------------------------------------------------------
// STOCK ADJUSTMENT — controlled adjustments with before/after quantities
// ---------------------------------------------------------------------
model StockAdjustment {
  id                 String        @id @default(cuid())
  facilityId         String
  facility           Facility      @relation(fields: [facilityId], references: [id])
  inventoryItemId    String
  inventoryItem      InventoryItem @relation(fields: [inventoryItemId], references: [id])
  batchId            String?
  adjustmentType     String // counting_error | damaged | lost | found | data_correction | expired | conversion | other
  beforeQuantity     Int
  adjustmentQuantity Int
  afterQuantity      Int
  reason             String
  notes              String?
  status             String        @default("pending") // pending | approved | rejected | completed
  requestedById      String?
  requestedBy        User?         @relation("adjustmentRequestedBy", fields: [requestedById], references: [id])
  approvedById       String?
  approvedBy         User?         @relation("adjustmentApprovedBy", fields: [approvedById], references: [id])
  approvedAt         DateTime?
  completedAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([facilityId, status])
  @@index([inventoryItemId])
  @@index([adjustmentType, status])
}

// ---------------------------------------------------------------------
// EQUIPMENT & MAINTENANCE
// ---------------------------------------------------------------------

model Equipment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  facilityId     String?
  facility       Facility?    @relation(fields: [facilityId], references: [id])
  departmentId   String?
  department     Department?  @relation(fields: [departmentId], references: [id])
  assetNumber    String
  name           String
  category       String?
  manufacturer   String?
  model          String?
  serialNumber   String?
  purchaseDate   DateTime?
  purchasePrice  Float?
  warrantyExpiry DateTime?
  status         String       @default("active") // active | maintenance | retired
  location       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  maintenance EquipmentMaintenance[]

  @@unique([organizationId, assetNumber])
}

model EquipmentMaintenance {
  id              String    @id @default(cuid())
  equipmentId     String
  equipment       Equipment @relation(fields: [equipmentId], references: [id])
  maintenanceType String? // preventive | corrective | calibration | inspection
  description     String?
  performedById   String?
  performedBy     User?     @relation("maintenancePerformedBy", fields: [performedById], references: [id])
  performedAt     DateTime  @default(now())
  nextDueAt       DateTime?
  cost            Float?
  status          String    @default("completed")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// ---------------------------------------------------------------------
// HR — SHIFTS & LEAVE
// ---------------------------------------------------------------------

model StaffShift {
  id           String      @id @default(cuid())
  staffId      String
  staff        Staff       @relation(fields: [staffId], references: [id])
  facilityId   String
  facility     Facility    @relation(fields: [facilityId], references: [id])
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  shiftDate    DateTime
  startTime    DateTime
  endTime      DateTime?
  shiftType    String? // morning | evening | night | on_call
  status       String      @default("scheduled") // scheduled | completed | cancelled | no_show
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([staffId, shiftDate])
}

model LeaveRecord {
  id           String    @id @default(cuid())
  staffId      String
  staff        Staff     @relation(fields: [staffId], references: [id])
  leaveType    String? // annual | sick | maternity | paternity | unpaid | study
  startDate    DateTime
  endDate      DateTime?
  reason       String?
  status       String    @default("pending") // pending | approved | rejected | cancelled
  approvedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ---------------------------------------------------------------------
// DOCUMENTS, CONSENTS, TASKS, NOTIFICATIONS
// ---------------------------------------------------------------------

model Document {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  patientId      String?
  patient        Patient?     @relation(fields: [patientId], references: [id])
  encounterId    String?
  encounter      Encounter?   @relation(fields: [encounterId], references: [id])
  facilityId     String?
  facility       Facility?    @relation(fields: [facilityId], references: [id])
  documentType   String? // referral_letter | medical_report | consent_form | discharge_summary | lab_report | imaging_report | other
  fileName       String
  fileUrl        String
  mimeType       String?
  fileSize       Int?
  uploadedById   String?
  uploadedBy     User?        @relation("docUploader", fields: [uploadedById], references: [id])
  uploadedAt     DateTime     @default(now())
  visibility     String       @default("facility") // public | facility | department | restricted
  status         String       @default("active")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([patientId])
}

model Consent {
  id           String     @id @default(cuid())
  patientId    String
  patient      Patient    @relation(fields: [patientId], references: [id])
  encounterId  String?
  encounter    Encounter? @relation(fields: [encounterId], references: [id])
  consentType  String? // treatment | procedure | information_sharing | data_processing | communication | research
  status       String     @default("given") // given | withdrawn | refused
  description  String?
  givenAt      DateTime   @default(now())
  withdrawnAt  DateTime?
  recordedById String?
  recordedBy   User?      @relation("consentRecorder", fields: [recordedById], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([patientId])
}

model Task {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  facilityId     String?
  facility       Facility?    @relation(fields: [facilityId], references: [id])
  departmentId   String?
  department     Department?  @relation(fields: [departmentId], references: [id])
  patientId      String?
  patient        Patient?     @relation(fields: [patientId], references: [id])
  encounterId    String?
  encounter      Encounter?   @relation(fields: [encounterId], references: [id])
  title          String
  description    String?
  priority       String       @default("routine") // routine | urgent | high
  assignedToId   String?
  assignedTo     User?        @relation("taskAssignee", fields: [assignedToId], references: [id])
  createdById    String?
  createdBy      User?        @relation("taskCreator", fields: [createdById], references: [id])
  dueAt          DateTime?
  status         String       @default("pending") // pending | in_progress | completed | cancelled
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([assignedToId, status])
  @@index([facilityId, status])
}

model Notification {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  facilityId    String?
  facility      Facility? @relation(fields: [facilityId], references: [id])
  type          String? // appointment | lab_result | prescription | low_inventory | expiring_medicine | referral | transfer | payment | claim
  title         String
  message       String
  referenceType String?
  referenceId   String?
  readAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([userId, readAt])
}

// ---------------------------------------------------------------------
// AUDIT, ACCESS LOGS, BREAK-GLASS, SETTINGS
// ---------------------------------------------------------------------

model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  facilityId     String?
  facility       Facility?     @relation(fields: [facilityId], references: [id])
  userId         String?
  user           User?         @relation(fields: [userId], references: [id])
  action         String
  resourceType   String?
  resourceId     String?
  oldValues      String? // JSON
  newValues      String? // JSON
  ipAddress      String?
  userAgent      String?
  reason         String?
  createdAt      DateTime      @default(now())

  @@index([userId, createdAt])
  @@index([resourceType, resourceId])
  @@index([facilityId, createdAt])
}

model PatientAccessLog {
  id           String    @id @default(cuid())
  patientId    String
  patient      Patient   @relation(fields: [patientId], references: [id])
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  facilityId   String?
  facility     Facility? @relation(fields: [facilityId], references: [id])
  accessType   String // view | edit | export | break_glass
  resourceType String?
  resourceId   String?
  reason       String?
  accessedAt   DateTime  @default(now())

  @@index([patientId, accessedAt])
}

model BreakGlassEvent {
  id          String    @id @default(cuid())
  patientId   String
  patient     Patient   @relation(fields: [patientId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  facilityId  String?
  facility    Facility? @relation(fields: [facilityId], references: [id])
  reason      String
  accessScope String?
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  createdAt   DateTime  @default(now())

  @@index([patientId, startedAt])
}

model SystemSetting {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  facilityId     String?
  facility       Facility?     @relation(fields: [facilityId], references: [id])
  settingKey     String
  settingValue   String?
  settingType    String? // string | number | boolean | json
  updatedById    String?
  updatedBy      User?         @relation(fields: [updatedById], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([organizationId, facilityId, settingKey])
}

// ---------------------------------------------------------------------
// PATIENT MERGE (CONTROLLED, AUDITABLE)
// ---------------------------------------------------------------------

model PatientMergeEvent {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation("mergeOrgEvents", fields: [organizationId], references: [id])
  sourcePatientId String
  sourcePatient   Patient      @relation("mergeSource", fields: [sourcePatientId], references: [id])
  targetPatientId String
  targetPatient   Patient      @relation("mergeTarget", fields: [targetPatientId], references: [id])
  reason          String?
  metadata        String? // JSON: counts of records moved
  mergedById      String?
  mergedBy        User?        @relation("mergePerformedBy", fields: [mergedById], references: [id])
  approvedById    String?
  approvedBy      User?        @relation("mergeApprovedBy", fields: [approvedById], references: [id])
  mergedAt        DateTime     @default(now())
  createdAt       DateTime     @default(now())
}

// ---------------------------------------------------------------------
// HR — STAFF ATTENDANCE, TRAINING & CERTIFICATIONS
// ---------------------------------------------------------------------

model StaffAttendance {
  id         String    @id @default(cuid())
  staffId    String
  staff      Staff     @relation(fields: [staffId], references: [id])
  facilityId String
  facility   Facility  @relation(fields: [facilityId], references: [id])
  date       DateTime  @db.Date
  checkInAt  DateTime?
  checkOutAt DateTime?
  status     String    @default("present") // present | late | absent | half_day
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([staffId, date])
  @@index([facilityId, date])
}

model TrainingRecord {
  id                String       @id @default(cuid())
  staffId           String
  staff             Staff        @relation(fields: [staffId], references: [id])
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id])
  trainingName      String
  provider          String?
  trainingDate      DateTime
  durationHours     Float?
  certificateIssued Boolean      @default(false)
  certificateNumber String?
  expiryDate        DateTime?
  notes             String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([staffId])
}

model Certification {
  id                String       @id @default(cuid())
  staffId           String
  staff             Staff        @relation(fields: [staffId], references: [id])
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id])
  certificationName String
  issuingBody       String?
  issueDate         DateTime
  expiryDate        DateTime?
  certificateNumber String?
  status            String       @default("active") // active | expired | revoked
  notes             String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([staffId])
  @@index([expiryDate])
}

// ---------------------------------------------------------------------
// OPERATIONS — INCIDENT REPORTS, SHIFT HANDOVERS
// ---------------------------------------------------------------------

model IncidentReport {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  facilityId      String?
  facility        Facility?    @relation(fields: [facilityId], references: [id])
  incidentType    String // clinical | safety | security | equipment | other
  severity        String // low | medium | high | critical
  description     String
  location        String?
  peopleInvolved  String?
  immediateAction String?
  status          String       @default("reported") // reported | investigating | resolved
  resolvedAt      DateTime?
  resolution      String?
  reportedById    String?
  reportedBy      User?        @relation("incidentReporter", fields: [reportedById], references: [id])
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([facilityId, createdAt])
}

model ShiftHandover {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  facilityId      String
  facility        Facility     @relation(fields: [facilityId], references: [id])
  departmentId    String?
  department      Department?  @relation(fields: [departmentId], references: [id])
  shiftType       String // morning | evening | night
  handoverDate    DateTime     @default(now())
  outgoingStaffId String?
  outgoingStaff   User?        @relation("handoverOutgoing", fields: [outgoingStaffId], references: [id])
  incomingStaffId String?
  incomingStaff   User?        @relation("handoverIncoming", fields: [incomingStaffId], references: [id])
  patientsToFlag  String? // JSON array of patient IDs
  notes           String
  pendingTasks    String?
  status          String       @default("completed")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([facilityId, handoverDate])
}

// ---------------------------------------------------------------------
// INPATIENT — WARD ROUNDS, INTAKE/OUTPUT CHARTING
// ---------------------------------------------------------------------

model WardRound {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  facilityId     String
  facility       Facility     @relation(fields: [facilityId], references: [id])
  wardId         String?
  ward           Ward?        @relation(fields: [wardId], references: [id])
  consultantId   String?
  consultant     User?        @relation("wardRoundConsultant", fields: [consultantId], references: [id])
  roundDate      DateTime     @default(now())
  patientsSeen   String? // JSON array of patient IDs (legacy — kept for back-compat)
  notes          String?
  planChanges    String?
  createdById    String?
  createdBy      User?        @relation("wardRoundCreator", fields: [createdById], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // ---- Extended fields ----
  roundType           String    @default("daily") // daily | consultant | specialist | mdt | post_op | emergency | maternity | pediatric | icu | weekend | night | discharge_planning | transfer_review | follow_up | other
  status              String    @default("scheduled") // scheduled | in_progress | completed | cancelled | rescheduled
  priority            String    @default("routine") // routine | urgent | stat
  leadClinicianId     String? // lead clinician (may differ from consultantId)
  // Scheduling
  startTime           DateTime?
  endTime             DateTime?
  expectedEndTime     DateTime?
  // Completion
  completedAt         DateTime?
  completedById       String?
  // Cancellation
  cancelledAt         DateTime?
  cancelledById       String?
  cancellationReason  String?
  // Round summary (generated on completion)
  summary             String? // JSON: { patientsReviewed, patientsNotReviewed, significantConcerns, actionItems, etc. }
  // Participants string (legacy — for quick display)
  participantsSummary String?

  // Relations
  roundPatients     WardRoundPatient[]
  roundNotes        WardRoundNote[]
  roundActions      WardRoundAction[]
  roundParticipants WardRoundParticipant[]

  @@index([facilityId, roundDate])
  @@index([facilityId, status])
  @@index([wardId, roundDate])
  @@index([status, roundDate])
}

// =====================================================================
// WARD ROUND PATIENT — per-patient review record
// =====================================================================

model WardRoundPatient {
  id                 String    @id @default(cuid())
  wardRoundId        String
  wardRound          WardRound @relation(fields: [wardRoundId], references: [id], onDelete: Cascade)
  patientId          String
  patient            Patient   @relation(fields: [patientId], references: [id])
  admissionId        String?
  encounterId        String?
  facilityId         String
  wardId             String?
  bedId              String?
  // Review status
  reviewStatus       String    @default("pending") // pending | reviewed | not_available | discharged | transferred | other
  reviewPriority     String    @default("routine") // critical | high | routine | follow_up
  notReviewedReason  String?
  // Clinical snapshot at time of round
  primaryDiagnosis   String?
  allergies          String?
  latestVitals       String? // JSON snapshot
  currentMedications String?
  pendingLabs        String?
  pendingImaging     String?
  pendingProcedures  String?
  dischargeStatus    String?
  clinicalAlerts     String?
  // Progress
  progressStatus     String? // improving | stable | deteriorating | new_concern | resolved | awaiting_investigation | awaiting_procedure | awaiting_specialist | other
  // Overnight events
  overnightEvents    String?
  // Timestamps
  reviewedAt         DateTime?
  reviewedById       String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([wardRoundId])
  @@index([patientId])
  @@index([reviewStatus])
}

// =====================================================================
// WARD ROUND NOTE — SOAP clinical documentation per patient per round
// =====================================================================

model WardRoundNote {
  id                  String    @id @default(cuid())
  wardRoundId         String
  wardRound           WardRound @relation(fields: [wardRoundId], references: [id], onDelete: Cascade)
  wardRoundPatientId  String?
  patientId           String
  patient             Patient   @relation(fields: [patientId], references: [id])
  admissionId         String?
  encounterId         String?
  facilityId          String
  // SOAP fields
  subjective          String? // S — patient's complaint, overnight events
  objective           String? // O — examination findings, vitals
  assessment          String? // A — clinical assessment, progress
  plan                String? // P — treatment plan, decisions
  // Additional clinical fields
  overnightEvents     String?
  examinationFindings String?
  clinicalConcerns    String?
  responseToTreatment String?
  // Free-text content (for non-SOAP formats)
  content             String?
  // Progress status
  progressStatus      String? // improving | stable | deteriorating | new_concern | resolved | other
  // Status lifecycle
  status              String    @default("draft") // draft | submitted | signed | amended
  signedById          String?
  signedAt            DateTime?
  amendedFromId       String?
  amendmentReason     String?
  // Author
  authoredById        String?
  authoredAt          DateTime  @default(now())
  // Event vs documentation timestamp
  eventAt             DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([wardRoundId])
  @@index([patientId])
  @@index([status])
}

// =====================================================================
// WARD ROUND ACTION — structured action items from rounds
// =====================================================================

model WardRoundAction {
  id                 String    @id @default(cuid())
  wardRoundId        String
  wardRound          WardRound @relation(fields: [wardRoundId], references: [id], onDelete: Cascade)
  wardRoundPatientId String?
  patientId          String?
  patient            Patient?  @relation(fields: [patientId], references: [id])
  facilityId         String
  // Action details
  actionType         String // order_lab | review_lab | order_imaging | review_imaging | adjust_medication | request_consult | perform_procedure | nursing_intervention | patient_education | discharge_preparation | referral | transfer | follow_up | other
  title              String
  description        String?
  // Assignment
  assignedToId       String? // responsible person (User ID)
  assignedToName     String? // denormalized for display
  assignedToRole     String? // doctor | nurse | pharmacist | physiotherapist | etc.
  // Scheduling
  dueDate            DateTime?
  priority           String    @default("routine") // routine | urgent | stat
  // Status
  status             String    @default("pending") // pending | in_progress | completed | cancelled | overdue
  completedAt        DateTime?
  completedById      String?
  completionNotes    String?
  // Created by
  createdById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([wardRoundId])
  @@index([patientId])
  @@index([status])
  @@index([assignedToId])
}

// =====================================================================
// WARD ROUND PARTICIPANT — multidisciplinary team members
// =====================================================================

model WardRoundParticipant {
  id               String    @id @default(cuid())
  wardRoundId      String
  wardRound        WardRound @relation(fields: [wardRoundId], references: [id], onDelete: Cascade)
  userId           String? // FK → User (if internal staff)
  staffName        String? // denormalized for external participants
  role             String    @default("doctor") // consultant | medical_officer | physician_assistant | specialist | nurse | pharmacist | lab_staff | radiology_staff | physiotherapist | dietitian | social_worker | student | other
  attendanceStatus String    @default("invited") // invited | attended | absent | late
  joinedAt         DateTime?
  leftAt           DateTime?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([wardRoundId])
  @@index([userId])
}

model IntakeOutputEntry {
  id               String     @id @default(cuid())
  patientId        String
  patient          Patient    @relation(fields: [patientId], references: [id])
  encounterId      String?
  encounter        Encounter? @relation(fields: [encounterId], references: [id])
  admissionId      String?
  admission        Admission? @relation(fields: [admissionId], references: [id])
  facilityId       String
  facility         Facility   @relation(fields: [facilityId], references: [id])
  entryType        String // intake | output
  fluidType        String // LEGACY: oral | iv | urine | drainage | blood_loss | other (kept for backward compat)
  // ---- Structured clinical fields (new) ----
  category         String? // oral | enteral | iv | medication | blood_product | urine | drains | gi | other (intake) / urine | drains | gi | other (output)
  source           String? // specific fluid/product/source name e.g. "Normal Saline", "NG aspirate", "Surgical drain #1"
  route            String? // oral | iv | enteral | ng | peg | blood_product | other (intake) / voided | catheter | ng | drain | ostomy | other (output)
  collectionMethod String? // (output) measured_volume | estimated | counted | other
  drainLabel       String? // free-text drain identifier e.g. "JP-1", "Chest-L"
  catheterStatus   String? // (urine) none | indwelling | supra_pubic | in_out | external
  measurementType  String? // measured | estimated
  unit             String     @default("ml") // default ml; facility-configurable
  amount           Float // in unit (default ml)
  weightKg         Float? // patient weight snapshot at time of recording (for mL/kg/hour calc)
  // ---- Late entry / audit trail ----
  eventAt          DateTime   @default(now()) // when the fluid event actually occurred
  recordedAt       DateTime   @default(now()) // when the entry was documented (may differ for late entries)
  documentedAt     DateTime   @default(now()) // alias of recordedAt for clarity
  // ---- Status / verification / amendment ----
  status           String     @default("recorded") // draft | recorded | verified | amended | cancelled
  verifiedById     String?
  verifiedAt       DateTime?
  amendedById      String?
  amendedAt        DateTime?
  amendmentReason  String?
  originalAmount   Float? // preserved when amended
  cancelledAt      DateTime?
  cancelReason     String?
  // ---- Relationships ----
  recordedById     String?
  recordedBy       User?      @relation("intakeOutputRecorder", fields: [recordedById], references: [id])
  verifiedBy       User?      @relation("intakeOutputVerifier", fields: [verifiedById], references: [id])
  amendedBy        User?      @relation("intakeOutputAmender", fields: [amendedById], references: [id])
  notes            String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  monitoringPeriodId String?
  monitoringPeriod   IntakeOutputMonitoringPeriod? @relation(fields: [monitoringPeriodId], references: [id])

  @@index([patientId, eventAt])
  @@index([patientId, recordedAt])
  @@index([admissionId, eventAt])
  @@index([facilityId, eventAt])
  @@index([status])
  @@index([category])
  @@index([entryType, eventAt])
}

// ---------------------------------------------------------------------
// INTAKE & OUTPUT — MONITORING PERIOD
//   Defines an active fluid-balance monitoring window for an admission.
//   Allows shift-level and 24-hour totals to be scoped properly.
// ---------------------------------------------------------------------
model IntakeOutputMonitoringPeriod {
  id              String     @id @default(cuid())
  organizationId  String
  facilityId      String
  facility        Facility   @relation(fields: [facilityId], references: [id])
  patientId       String
  patient         Patient    @relation(fields: [patientId], references: [id])
  admissionId     String?
  admission       Admission? @relation(fields: [admissionId], references: [id])
  encounterId     String?
  monitoringLevel String     @default("standard") // standard | enhanced | intensive
  intervalMinutes Int        @default(60) // 60 (hourly), 30, 15, 120, 240, 480, 720, 1440
  shiftDefinition String? // JSON: { morning: {start:"07:00", end:"15:00"}, evening: ..., night: ... }
  dailyTargetMl   Float? // documented clinical daily intake target (optional)
  dailyLimitMl    Float? // documented fluid restriction (optional)
  targetSource    String? // care_plan | order | clinician
  startedById     String?
  startedAt       DateTime   @default(now())
  endedById       String?
  endedAt         DateTime?
  status          String     @default("active") // active | ended
  notes           String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  entries IntakeOutputEntry[]
  ward    Ward?               @relation(fields: [wardId], references: [id])
  wardId  String?

  @@index([facilityId, status])
  @@index([patientId, status])
  @@index([admissionId])
}

// ---------------------------------------------------------------------
// INTAKE & OUTPUT — ALERT CONFIGURATION (facility-level)
//   Configurable thresholds — never hard-coded.
// ---------------------------------------------------------------------
model IntakeOutputAlertConfig {
  id                 String              @id @default(cuid())
  organizationId     String
  facilityId         String
  facility           Facility            @relation(fields: [facilityId], references: [id])
  name               String
  code               String // missing_entry | low_urine | negative_balance | positive_balance | high_output | documented_change
  metric             String // urine_output_per_hour | net_balance_24h | missing_entries | drain_output | other
  operator           String // lt | gt | lte | gte | eq
  threshold          Float
  windowMinutes      Int                 @default(1440) // 24h default
  patientGroup       String? // all | icu | pediatric | maternity | custom
  wardId             String?
  severity           String              @default("warning") // info | warning | critical
  recipients         String? // JSON array of role codes / user ids
  active             Boolean             @default(true)
  createdById        String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  ward               Ward?               @relation(fields: [wardId], references: [id])
  intakeOutputAlerts IntakeOutputAlert[]

  @@index([facilityId, active])
  @@index([code])
}

// ---------------------------------------------------------------------
// INTAKE & OUTPUT — ALERT INSTANCE (raised against a patient)
// ---------------------------------------------------------------------
model IntakeOutputAlert {
  id               String                   @id @default(cuid())
  organizationId   String
  facilityId       String
  facility         Facility                 @relation(fields: [facilityId], references: [id])
  patientId        String
  patient          Patient                  @relation(fields: [patientId], references: [id])
  admissionId      String?
  configId         String?
  config           IntakeOutputAlertConfig? @relation(fields: [configId], references: [id])
  code             String // missing_entry | low_urine | negative_balance | positive_balance | high_output | documented_change
  severity         String                   @default("warning") // info | warning | critical
  title            String
  message          String
  metric           String?
  thresholdValue   Float?
  actualValue      Float?
  raisedAt         DateTime                 @default(now())
  acknowledgedById String?
  acknowledgedBy   User?                    @relation("intakeOutputAlertAck", fields: [acknowledgedById], references: [id])
  acknowledgedAt   DateTime?
  actionTaken      String?
  ackNotes         String?
  status           String                   @default("active") // active | acknowledged | resolved
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@index([facilityId, status])
  @@index([patientId, status])
  @@index([code, status])
}

// ---------------------------------------------------------------------
// NEXTAUTH SESSIONS (REQUIRED BY NEXTAUTH)
// ---------------------------------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// =====================================================================
// EXTENDED MODULES — Mortuary, Blood Bank, Theatre, ICU/NICU,
// Specialty Clinics, Support Services, Patient Relations, QA,
// Risk, Legal, Research, PR, IT, Coding, Community Health,
// Home Care, Histopathology
// =====================================================================
// (Appended to schema.prisma — these models use plain String? foreign
//  keys to avoid modifying User/Patient/Encounter with new reverse
//  relations. Internal relations between new models are declared
//  normally.)

// ---------------------------------------------------------------------
// MORTUARY SERVICES — manages deceased persons (including those NOT
// recorded from the facility), body intake, cold storage, release.
// ---------------------------------------------------------------------
model MortuaryAdmission {
  id                 String    @id @default(cuid())
  organizationId     String
  facilityId         String?
  admissionNumber    String    @unique
  patientId          String? // null if deceased was brought in (not a facility patient)
  deceasedName       String
  deceasedAge        Int?
  deceasedSex        String? // male | female | unknown
  deceasedDob        DateTime?
  nationalId         String?
  nextOfKinName      String?
  nextOfKinPhone     String?
  nextOfKinRelation  String?
  dateOfDeath        DateTime
  placeOfDeath       String? // facility | home | roadside | other_facility | unknown
  causeOfDeath       String?
  deathCertificateNo String?
  broughtBy          String? // person who brought the body
  broughtByPhone     String?
  sourceFacility     String? // if from another facility
  sourceNotes        String? // free text source description
  storageUnitId      String?
  storageLocation    String? // chamber / freezer / shelf label
  bodyTag            String?   @unique
  admissionStatus    String    @default("admitted") // admitted | stored | released | transferred_out
  admittedAt         DateTime  @default(now())
  releasedAt         DateTime?
  releasedTo         String? // name of person who collected
  releasedToPhone    String?
  releasedToIdType   String? // national_id | driving | passport
  releasedToIdNo     String?
  releaseNotes       String?
  undertakingCompany String? // funeral home
  createdById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  movements     MortuaryMovement[]
  viewings      MortuaryViewing[]
  propertyItems MortuaryProperty[]

  @@index([organizationId, facilityId])
  @@index([patientId])
  @@index([admissionStatus])
}

// ---------------------------------------------------------------------
// BLOOD BANK — donors, units, transfusions
// ---------------------------------------------------------------------
model BloodDonor {
  id                String    @id @default(cuid())
  organizationId    String
  facilityId        String?
  donorNumber       String    @unique
  donorType         String    @default("voluntary") // voluntary | replacement | autologous | directed
  fullName          String
  age               Int?
  sex               String? // male | female
  bloodGroup        String? // A+ | A- | B+ | B- | AB+ | AB- | O+ | O-
  rhFactor          String? // + | -
  phone             String?
  email             String?
  address           String?
  occupation        String?
  lastDonationAt    DateTime?
  donationCount     Int       @default(0)
  eligibilityStatus String    @default("eligible") // eligible | deferred | banned
  deferralReason    String?
  deferralUntil     DateTime?
  notes             String?
  hbsAg             String? // hepatitis B status
  hcvAb             String? // hepatitis C
  hivAb             String? // HIV
  syphilis          String?
  createdById       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  bloodUnits BloodUnit[]
  donations  BloodDonation[]

  @@index([organizationId, facilityId])
  @@index([bloodGroup])
}

model BloodUnit {
  id                     String     @id @default(cuid())
  organizationId         String
  facilityId             String?
  unitNumber             String     @unique
  donorId                String
  donor                  BloodDonor @relation(fields: [donorId], references: [id])
  bloodGroup             String // A+ | A- | B+ | B- | AB+ | AB- | O+ | O-
  componentType          String     @default("whole_blood") // whole_blood | prbc | ffp | platelets | cryo
  volumeMl               Int        @default(450)
  collectionDate         DateTime   @default(now())
  expiryDate             DateTime
  storageTemp            String? // e.g. 2-6°C, -25°C
  status                 String     @default("available") // available | reserved | issued | transfused | expired | discarded
  reservedForPatientId   String?
  reservedForPatientName String?
  reservedUntil          DateTime?
  issuedAt               DateTime?
  issuedToPatientId      String?
  issuedToPatientName    String?
  issuedById             String?
  transfusedAt           DateTime?
  notes                  String?
  createdById            String?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  transfusions BloodTransfusion[]
  crossmatches BloodCrossmatch[]

  @@index([organizationId, facilityId])
  @@index([status])
  @@index([bloodGroup])
  @@index([expiryDate])
}

model BloodTransfusion {
  id                    String    @id @default(cuid())
  organizationId        String
  facilityId            String?
  transfusionNumber     String    @unique
  patientId             String?
  patientName           String
  patientBloodGroup     String?
  unitId                String
  bloodUnit             BloodUnit @relation(fields: [unitId], references: [id])
  unitNumber            String
  bloodGroup            String
  componentType         String
  volumeMl              Int
  preTransfusionVitals  String? // JSON: {temp, bp, pulse}
  postTransfusionVitals String?
  reactionObserved      Boolean   @default(false)
  reactionDetails       String?
  startedAt             DateTime  @default(now())
  completedAt           DateTime?
  administeredById      String?
  status                String    @default("in_progress") // in_progress | completed | aborted
  notes                 String?
  createdById           String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([organizationId, facilityId])
  @@index([patientId])
}

// ---------------------------------------------------------------------
// OPERATING THEATRE — surgical cases, pre-op, post-op
// ---------------------------------------------------------------------
model TheatreCase {
  id              String    @id @default(cuid())
  organizationId  String
  facilityId      String?
  caseNumber      String    @unique
  patientId       String?
  patientName     String
  patientAge      Int?
  patientSex      String?
  encounterId     String?
  admissionId     String?
  procedureType   String // elective | emergency | urgent
  procedureName   String
  procedureCode   String? // CPT/ICD-9-PCS
  surgeonId       String?
  surgeonName     String?
  anesthetistId   String?
  anesthetistName String?
  scrubNurseId    String?
  scrubNurseName  String?
  theatreRoom     String?
  scheduledStart  DateTime
  scheduledEnd    DateTime?
  actualStart     DateTime?
  actualEnd       DateTime?
  anesthesiaType  String? // general | regional | local | spinal | epidural | sedation
  preOpDiagnosis  String?
  postOpDiagnosis String?
  findings        String?
  procedureNotes  String?
  complications   String?
  bloodLossMl     Int?
  specimensSent   String?
  implantUsed     String?
  status          String    @default("scheduled") // scheduled | in_progress | completed | cancelled | delayed
  recoveryStatus  String? // recovering | recovered_to_ward | icu_transfer
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([organizationId, facilityId])
  @@index([patientId])
  @@index([status])
  @@index([scheduledStart])
}

// ---------------------------------------------------------------------
// CRITICAL CARE — ICU/NICU admissions with monitoring
// ---------------------------------------------------------------------
model CriticalCareAdmission {
  id                     String    @id @default(cuid())
  organizationId         String
  facilityId             String?
  admissionNumber        String    @unique
  patientId              String?
  patientName            String
  patientAge             Int?
  patientSex             String?
  encounterId            String?
  admissionId            String? // link to general admission
  unitType               String // icu | nicu | picu | ccu | hdu
  bedNumber              String?
  admittingDiagnosis     String
  admissionReason        String
  severity               String    @default("critical") // critical | serious | stable
  apacheScore            Int? // APACHE II score
  admittedAt             DateTime  @default(now())
  dischargedAt           DateTime?
  dischargeDestination   String? // ward | home | morgue | transfer_out
  attendingPhysicianId   String?
  attendingPhysicianName String?
  ventilator             Boolean   @default(false)
  ventilatorSettings     String? // JSON
  dialysis               Boolean   @default(false)
  inotropes              String?
  monitoringData         String? // JSON array of hourly readings: [{time, hr, bp, spo2, temp, ...}]
  status                 String    @default("admitted") // admitted | discharged | deceased
  outcomeNotes           String?
  createdById            String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([organizationId, facilityId])
  @@index([patientId])
  @@index([unitType, status])
}

// ---------------------------------------------------------------------
// SPECIALTY CLINICS — Dental, Eye, ENT, Physio, Psych, Derm, Cardio,
// Neuro, Ortho, Urology, etc. — appointments + treatment records.
// ---------------------------------------------------------------------
model SpecialtyEncounter {
  id              String    @id @default(cuid())
  organizationId  String
  facilityId      String?
  encounterNumber String    @unique
  patientId       String?
  patientName     String
  patientAge      Int?
  patientSex      String?
  encounterId     String? // link to general encounter if created from one
  departmentCode  String // DENTAL | OPHTH | ENT | PHYSIO | PSYCH | DERM | CARDIO | NEURO | ORTHO | URO | ENDO
  clinicType      String // new | follow_up | review
  chiefComplaint  String
  history         String?
  examination     String?
  diagnosis       String?
  treatmentPlan   String?
  procedureDone   String?
  prescription    String?
  followUpDate    DateTime?
  nextAppointment DateTime?
  clinicianId     String?
  clinicianName   String?
  status          String    @default("in_progress") // in_progress | completed | cancelled
  startTime       DateTime  @default(now())
  endTime         DateTime?
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  procedures SpecialtyProcedure[]
  notes      SpecialtyClinicalNote[]

  @@index([organizationId, facilityId])
  @@index([departmentCode])
  @@index([patientId])
  @@index([status])
}

// ---------------------------------------------------------------------
// SPECIALTY CLINICS — Clinic configuration, appointments, procedures,
// clinical notes, and referrals. Companion tables to SpecialtyEncounter.
// ---------------------------------------------------------------------
model SpecialtyClin {
  id                String   @id @default(cuid())
  organizationId    String
  facilityId        String?
  code              String // DENTAL | OPHTH | ENT | PHYSIO | PSYCH | DERM | CARDIO | NEURO | ORTHO | URO | ENDO | PAED
  name              String
  description       String?
  leadClinicianId   String?
  leadClinicianName String?
  location          String? // room / suite number
  clinicDays        String? // JSON array: ["MON","WED","FRI"]
  startTime         String? // "08:00"
  endTime           String? // "13:00"
  slotDurationMin   Int      @default(30)
  maxDailyBookings  Int      @default(20)
  color             String? // hex color for UI
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, facilityId])
}

model SpecialtyAppointment {
  id                String    @id @default(cuid())
  organizationId    String
  facilityId        String?
  appointmentNumber String    @unique
  patientId         String?
  patientName       String
  patientAge        Int?
  patientSex        String?
  patientPhone      String?
  departmentCode    String
  clinicId          String?
  clinicianId       String?
  clinicianName     String?
  appointmentDate   DateTime
  startTime         String? // "09:00"
  endTime           String? // "09:30"
  type              String    @default("new") // new | follow_up | review | procedure
  reason            String?
  status            String    @default("scheduled") // scheduled | checked_in | in_consult | completed | cancelled | no_show
  source            String    @default("walk_in") // walk_in | referral | online | phone
  referralFrom      String?
  notes             String?
  checkedInAt       DateTime?
  completedAt       DateTime?
  encounterId       String? // link to resulting specialty encounter
  createdById       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([organizationId, facilityId])
  @@index([departmentCode, appointmentDate])
  @@index([patientId])
  @@index([status])
  @@index([clinicId])
}

model SpecialtyProcedure {
  id                   String             @id @default(cuid())
  organizationId       String
  facilityId           String?
  specialtyEncounterId String
  specialtyEncounter   SpecialtyEncounter @relation(fields: [specialtyEncounterId], references: [id], onDelete: Cascade)
  procedureName        String
  procedureCode        String?
  bodySite             String?
  laterality           String? // left | right | bilateral | n/a
  performedById        String?
  performedByName      String?
  assistedBy           String?
  startedAt            DateTime           @default(now())
  endedAt              DateTime?
  durationMin          Int?
  findings             String?
  complications        String?
  anesthesiaType       String? // local | general | sedation | topical | none
  specimenSent         Boolean            @default(false)
  specimenLabel        String?
  status               String             @default("in_progress") // in_progress | completed | aborted
  notes                String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([organizationId, specialtyEncounterId])
  @@index([status])
}

model SpecialtyClinicalNote {
  id                   String             @id @default(cuid())
  organizationId       String
  specialtyEncounterId String
  specialtyEncounter   SpecialtyEncounter @relation(fields: [specialtyEncounterId], references: [id], onDelete: Cascade)
  noteType             String             @default("addendum") // addendum | nursing | observation | phone_call | handover
  content              String
  authoredById         String?
  authoredByName       String?
  authoredAt           DateTime           @default(now())
  createdAt            DateTime           @default(now())

  @@index([specialtyEncounterId])
  @@index([organizationId])
}

model SpecialtyReferral {
  id                String    @id @default(cuid())
  organizationId    String
  facilityId        String?
  referralNumber    String    @unique
  patientId         String?
  patientName       String
  patientAge        Int?
  patientSex        String?
  patientPhone      String?
  fromDepartment    String? // referring dept (e.g., OPD, ER)
  toDepartmentCode  String // specialty code (CARDIO, DERM, etc.)
  fromClinicianId   String?
  fromClinicianName String?
  toClinicianId     String?
  toClinicianName   String?
  reason            String
  clinicalSummary   String?
  urgency           String    @default("routine") // routine | urgent | emergency
  status            String    @default("pending") // pending | accepted | scheduled | completed | declined
  referralDate      DateTime  @default(now())
  responseDate      DateTime?
  responseNotes     String?
  encounterId       String? // resulting specialty encounter
  createdById       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([organizationId, toDepartmentCode])
  @@index([status])
  @@index([patientId])
}

// ---------------------------------------------------------------------
// SUPPORT SERVICES — Laundry, Housekeeping, Catering, Waste,
// Security, Transport. Unified model with serviceType discriminator.
// ---------------------------------------------------------------------
model ServiceRequest {
  id              String    @id @default(cuid())
  organizationId  String
  facilityId      String?
  requestNumber   String    @unique
  serviceType     String // laundry | housekeeping | catering | waste | security | transport
  category        String? // sub-category: e.g., laundry:linens, housekeeping:room_cleaning, catering:patient_meal, waste:sharp_disposal, security:visitor_pass, transport:ambulance_trip
  priority        String    @default("routine") // routine | urgent | emergency
  status          String    @default("requested") // requested | assigned | in_progress | completed | cancelled
  title           String
  description     String?
  requestedById   String?
  requestedByName String?
  assignedToId    String?
  assignedToName  String?
  location        String? // ward / room / area
  departmentCode  String?
  patientId       String? // if linked to a patient
  patientName     String?
  encounterId     String?
  admissionId     String?
  scheduledAt     DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  quantity        Int? // e.g., 50 linens
  unit            String? // pcs | kg | meal | bag | trip
  itemsDetail     String? // JSON: [{name, qty, condition}]
  equipmentId     String?
  verifiedAt      DateTime?
  verifiedByName  String?
  cost            Float?
  notes           String?
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([organizationId, facilityId])
  @@index([serviceType, status])
  @@index([patientId])
  @@index([departmentCode])
}

// ---------------------------------------------------------------------
// PATIENT RELATIONS — complaints, feedback, satisfaction surveys
// ---------------------------------------------------------------------
model PatientFeedback {
  id                String    @id @default(cuid())
  organizationId    String
  facilityId        String?
  feedbackNumber    String    @unique
  feedbackType      String // complaint | compliment | suggestion | enquiry
  category          String? // clinical | billing | waiting | staff | cleanliness | food | other
  patientId         String?
  patientName       String
  patientPhone      String?
  departmentCode    String?
  encounterId       String?
  subject           String
  description       String
  severity          String    @default("medium") // low | medium | high | critical
  status            String    @default("open") // open | investigating | resolved | closed | escalated
  resolution        String?
  resolvedAt        DateTime?
  resolvedById      String?
  resolvedByName    String?
  satisfactionScore Int? // 1-5
  createdById       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([organizationId, facilityId])
  @@index([feedbackType, status])
  @@index([patientId])
}

// ---------------------------------------------------------------------
// QUALITY ASSURANCE — quality indicators & audits
// ---------------------------------------------------------------------
model QualityIndicator {
  id                   String                  @id @default(cuid())
  organizationId       String
  facilityId           String?
  indicatorCode        String                  @unique
  indicatorName        String
  category             String? // clinical | safety | patient_experience | efficiency | financial
  unit                 String? // % | rate | count
  target               String?
  description          String?
  measurementFrequency String?                 @default("monthly") // daily | weekly | monthly | quarterly
  departmentCode       String?
  isActive             Boolean                 @default(true)
  values               QualityIndicatorValue[]
  createdById          String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@index([organizationId, facilityId])
  @@index([category])
}

model QualityIndicatorValue {
  id             String           @id @default(cuid())
  indicatorId    String
  indicator      QualityIndicator @relation(fields: [indicatorId], references: [id])
  periodStart    DateTime
  periodEnd      DateTime
  measuredValue  Float
  targetValue    Float?
  numerator      Int?
  denominator    Int?
  notes          String?
  measuredById   String?
  measuredByName String?
  createdAt      DateTime         @default(now())

  @@index([indicatorId, periodStart])
}

// ---------------------------------------------------------------------
// RISK MANAGEMENT — risk register
// ---------------------------------------------------------------------
model RiskRegister {
  id                String    @id @default(cuid())
  organizationId    String
  facilityId        String?
  riskNumber        String    @unique
  riskTitle         String
  riskCategory      String? // clinical | financial | operational | strategic | compliance | reputational
  description       String
  likelihood        String    @default("medium") // low | medium | high
  impact            String    @default("medium") // low | medium | high | critical
  riskScore         String? // computed: low | medium | high | critical
  owner             String?
  ownerId           String?
  mitigationPlan    String?
  residualRisk      String?
  status            String    @default("open") // open | mitigated | accepted | closed
  reviewDate        DateTime?
  departmentCode    String?
  relatedIncidentId String?
  createdById       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([organizationId, facilityId])
  @@index([status])
  @@index([riskCategory])
}

// ---------------------------------------------------------------------
// LEGAL / COMPLIANCE
// ---------------------------------------------------------------------
model LegalCase {
  id               String    @id @default(cuid())
  organizationId   String
  facilityId       String?
  caseNumber       String    @unique
  caseType         String // malpractice | employment | contract | regulatory | patient_dispute | other
  title            String
  description      String?
  status           String    @default("open") // open | in_litigation | settled | dismissed | closed
  priority         String    @default("medium")
  filingDate       DateTime?
  courtDate        DateTime?
  opposingParty    String?
  plaintiffName    String?
  defendantName    String?
  patientId        String?
  patientName      String?
  encounterId      String?
  departmentCode   String?
  assignedAttorney String?
  estimatedValue   Float?
  settlementAmount Float?
  resolutionNotes  String?
  closedAt         DateTime?
  createdById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([organizationId, facilityId])
  @@index([caseType, status])
  @@index([courtDate])
}

// ---------------------------------------------------------------------
// RESEARCH & TRAINING (research projects)
// ---------------------------------------------------------------------
model ResearchStudy {
  id                      String                @id @default(cuid())
  organizationId          String
  facilityId              String?
  studyNumber             String                @unique
  studyTitle              String
  studyType               String? // observational | rct | cohort | case_control | qualitative
  principalInvestigator   String?
  principalInvestigatorId String?
  status                  String                @default("planning") // planning | recruiting | ongoing | analysis | completed | suspended | terminated
  ethicsApprovalNo        String?
  ethicsApprovalDate      DateTime?
  startDate               DateTime?
  endDate                 DateTime?
  targetEnrollment        Int?
  currentEnrollment       Int                   @default(0)
  fundingSource           String?
  budget                  Float?
  description             String?
  notes                   String?
  participants            ResearchParticipant[]
  createdById             String?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  @@index([organizationId, facilityId])
  @@index([status])
}

model ResearchParticipant {
  id               String        @id @default(cuid())
  studyId          String
  study            ResearchStudy @relation(fields: [studyId], references: [id])
  participantCode  String        @unique
  patientId        String?
  patientName      String?
  enrollmentDate   DateTime      @default(now())
  status           String        @default("enrolled") // enrolled | active | completed | withdrew | excluded
  withdrawalDate   DateTime?
  withdrawalReason String?
  notes            String?
  createdById      String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([studyId])
  @@index([patientId])
}

// ---------------------------------------------------------------------
// PUBLIC RELATIONS — campaigns, media inquiries
// ---------------------------------------------------------------------
model PRActivity {
  id             String    @id @default(cuid())
  organizationId String
  facilityId     String?
  activityNumber String    @unique
  activityType   String // campaign | media_inquiry | press_release | event | social_media | community_engagement
  title          String
  description    String?
  status         String    @default("planned") // planned | in_progress | completed | cancelled
  priority       String    @default("medium")
  startDate      DateTime?
  endDate        DateTime?
  targetAudience String?
  budget         Float?
  spentAmount    Float?
  mediaOutlet    String?
  contactPerson  String?
  contactPhone   String?
  outcomes       String?
  notes          String?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId, facilityId])
  @@index([activityType, status])
}

// ---------------------------------------------------------------------
// IT OPERATIONS — support tickets
// ---------------------------------------------------------------------
model ITTicket {
  id                 String    @id @default(cuid())
  organizationId     String
  facilityId         String?
  ticketNumber       String    @unique
  ticketType         String // hardware | software | network | access | email | other
  category           String? // specific category
  priority           String    @default("medium") // low | medium | high | critical
  status             String    @default("open") // open | assigned | in_progress | resolved | closed | escalated
  subject            String
  description        String
  affectedSystem     String?
  reportedById       String?
  reportedByName     String?
  reportedByPhone    String?
  assignedToId       String?
  assignedToName     String?
  resolution         String?
  resolvedAt         DateTime?
  resolutionTimeMins Int?
  satisfactionScore  Int?
  createdById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  comments    ITTicketComment[]
  attachments ITTicketAttachment[]
  assetLinks  ITTicketAssetLink[]

  @@index([organizationId, facilityId])
  @@index([ticketType, status])
  @@index([priority])
}

// ---------------------------------------------------------------------
// CODING & CLAIMS — ICD-10 coding for encounters
// ---------------------------------------------------------------------
model CodingRecord {
  id                 String   @id @default(cuid())
  organizationId     String
  facilityId         String?
  encounterId        String?
  patientId          String?
  patientName        String
  codingType         String // icd10 | icd11 | cpt | snomed
  primaryCode        String
  primaryDescription String
  secondaryCodes     String? // JSON array
  coderId            String?
  coderName          String?
  codingDate         DateTime @default(now())
  claimId            String?
  claimStatus        String? // pending | submitted | approved | rejected | paid
  claimAmount        Float?
  notes              String?
  createdById        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([organizationId, facilityId])
  @@index([encounterId])
  @@index([patientId])
  @@index([claimStatus])
}

// ---------------------------------------------------------------------
// COMMUNITY HEALTH — outreach events
// ---------------------------------------------------------------------
model CommunityOutreach {
  id                  String    @id @default(cuid())
  organizationId      String
  facilityId          String?
  eventNumber         String    @unique
  eventType           String // vaccination | screening | health_education | community_clinic | sanitation
  title               String
  description         String?
  location            String
  region              String?
  startDate           DateTime
  endDate             DateTime?
  status              String    @default("planned") // planned | ongoing | completed | cancelled
  targetPopulation    Int?
  participantsReached Int       @default(0)
  servicesProvided    String? // JSON array
  teamLeadId          String?
  teamLeadName        String?
  teamMembers         String?
  budget              Float?
  spentAmount         Float?
  outcomes            String?
  notes               String?
  createdById         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([organizationId, facilityId])
  @@index([eventType, status])
  @@index([startDate])
}

// ---------------------------------------------------------------------
// HOME CARE SERVICES
// ---------------------------------------------------------------------
model HomeCareVisit {
  id               String    @id @default(cuid())
  organizationId   String
  facilityId       String?
  visitNumber      String    @unique
  patientId        String?
  patientName      String
  patientAge       Int?
  patientSex       String?
  patientAddress   String
  patientPhone     String?
  visitType        String // nursing | physiotherapy | medical_review | palliative | postnatal | chronic_disease
  scheduledAt      DateTime
  arrivedAt        DateTime?
  departedAt       DateTime?
  durationMins     Int?
  caregiverId      String?
  caregiverName    String?
  careProvided     String?
  vitalsRecorded   String? // JSON
  medicationsGiven String?
  instructions     String?
  nextVisitDate    DateTime?
  status           String    @default("scheduled") // scheduled | completed | cancelled | no_show
  notes            String?
  createdById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([organizationId, facilityId])
  @@index([patientId])
  @@index([status, scheduledAt])
}

// ---------------------------------------------------------------------
// HISTOPATHOLOGY
// ---------------------------------------------------------------------
model HistopathologySpecimen {
  id                      String    @id @default(cuid())
  organizationId          String
  facilityId              String?
  specimenNumber          String    @unique
  patientId               String?
  patientName             String
  patientAge              Int?
  patientSex              String?
  encounterId             String?
  specimenType            String // biopsy | cytology | resection | fluid | tissue
  specimenSite            String // anatomical location
  collectionMethod        String? // excisional | incisional | needle | brush | scraping
  collectedAt             DateTime  @default(now())
  fixedIn                 String? // formalin | other
  clinicalHistory         String?
  requestingPhysicianId   String?
  requestingPhysicianName String?
  grossExamination        String?
  microscopyFindings      String?
  diagnosis               String?
  differentialDiagnosis   String?
  specialStains           String?
  tumorType               String?
  tumorGrade              String?
  tumorStage              String?
  marginsStatus           String?
  pathologistId           String?
  pathologistName         String?
  reportedAt              DateTime?
  status                  String    @default("received") // received | processing | sectioned | reported | signed_out
  notes                   String?
  createdById             String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([organizationId, facilityId])
  @@index([patientId])
  @@index([status])
}

// ---------------------------------------------------------------------
// RECOVERY ROOM — post-op recovery tracking
// ---------------------------------------------------------------------
model RecoveryRoomRecord {
  id                String    @id @default(cuid())
  organizationId    String
  facilityId        String?
  recordNumber      String    @unique
  patientId         String?
  patientName       String
  theatreCaseId     String?
  theatreCaseNumber String?
  admissionId       String?
  admittedAt        DateTime  @default(now())
  dischargedAt      DateTime?
  aldergroveScore   Int       @default(0) // post-anesthesia recovery score
  painScore         Int       @default(0)
  vitals            String? // JSON array of hourly readings
  complications     String?
  treatmentGiven    String?
  destination       String? // ward | icu | home | theatre_return
  status            String    @default("recovering") // recovering | recovered | transferred | complication
  nurseId           String?
  nurseName         String?
  notes             String?
  createdById       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([organizationId, facilityId])
  @@index([patientId])
  @@index([status])
}

// ---------------------------------------------------------------------
// INTERNAL AUDIT — financial & operational audits
// ---------------------------------------------------------------------
model AuditFinding {
  id                 String    @id @default(cuid())
  organizationId     String
  facilityId         String?
  findingNumber      String    @unique
  auditType          String // financial | operational | compliance | clinical | it
  title              String
  description        String
  findingType        String    @default("observation") // observation | weakness | non_conformance | fraud
  severity           String    @default("medium") // low | medium | high | critical
  status             String    @default("open") // open | in_review | remediated | closed
  auditorId          String?
  auditorName        String?
  auditedPeriod      String?
  auditedDepartment  String?
  recommendation     String?
  managementResponse String?
  remediationPlan    String?
  remediationDueDate DateTime?
  remediatedAt       DateTime?
  createdById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([organizationId, facilityId])
  @@index([auditType, status])
  @@index([severity])
}

// ---------------------------------------------------------------------
// IT SERVICE DESK — Ticket Comments, Knowledge Base, IT Assets, SLA
// ---------------------------------------------------------------------

model ITTicketComment {
  id          String   @id @default(cuid())
  ticketId    String
  ticket      ITTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  commentType String   @default("public") // public | internal
  body        String
  authorId    String?
  authorName  String?
  createdAt   DateTime @default(now())

  @@index([ticketId, createdAt])
}

model ITTicketAttachment {
  id             String   @id @default(cuid())
  ticketId       String
  ticket         ITTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fileName       String
  fileType       String?
  fileSize       Int?
  fileUrl        String
  uploadedById   String?
  uploadedByName String?
  createdAt      DateTime @default(now())

  @@index([ticketId])
}

model KnowledgeBaseArticle {
  id             String   @id @default(cuid())
  organizationId String
  title          String
  category       String   @default("general") // login | printing | network | hmis | email | security | general
  content        String
  keywords       String?
  authorId       String?
  authorName     String?
  status         String   @default("published") // draft | published | archived
  viewCount      Int      @default(0)
  helpfulCount   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, status])
  @@index([category])
}

model ITAsset {
  id              String    @id @default(cuid())
  organizationId  String
  facilityId      String?
  assetTag        String    @unique
  assetType       String // desktop | laptop | printer | scanner | router | switch | server | ups | projector | other
  manufacturer    String?
  model           String?
  serialNumber    String?
  location        String?
  departmentCode  String?
  assignedToId    String?
  assignedToName  String?
  purchaseDate    DateTime?
  warrantyExpiry  DateTime?
  status          String    @default("active") // active | inactive | repair | retired
  condition       String    @default("good") // excellent | good | fair | poor
  operatingSystem String?
  ipAddress       String?
  macAddress      String?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tickets ITTicketAssetLink[]

  @@index([organizationId, facilityId])
  @@index([assetType, status])
}

model ITTicketAssetLink {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    ITTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  assetId   String
  asset     ITAsset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  linkType  String   @default("related") // related | affected | repaired
  createdAt DateTime @default(now())

  @@unique([ticketId, assetId])
}

model SLAPolicy {
  id                 String   @id @default(cuid())
  organizationId     String
  name               String
  priority           String // critical | high | medium | low
  responseTimeMins   Int
  resolutionTimeMins Int
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([organizationId, isActive])
}

// ---------------------------------------------------------------------
// SUPPORT SERVICES — Maintenance Schedule, Facility Inspection
// ---------------------------------------------------------------------

model MaintenanceSchedule {
  id              String    @id @default(cuid())
  organizationId  String
  facilityId      String?
  equipmentId     String?
  maintenanceType String // preventive | corrective | calibration | inspection
  title           String
  description     String?
  scheduledDate   DateTime
  completedAt     DateTime?
  assignedToName  String?
  status          String    @default("scheduled") // scheduled | in_progress | completed | overdue
  frequency       String? // daily | weekly | monthly | quarterly | annually
  nextDueAt       DateTime?
  cost            Float?
  notes           String?
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([organizationId, facilityId])
  @@index([status, scheduledDate])
}

model FacilityInspection {
  id               String    @id @default(cuid())
  organizationId   String
  facilityId       String?
  inspectionType   String // safety | cleanliness | electrical | plumbing | fire_safety | equipment | security
  title            String
  description      String?
  inspectorName    String?
  location         String?
  departmentCode   String?
  findings         String?
  severity         String    @default("low") // low | medium | high | critical
  correctiveAction String?
  followUpDate     DateTime?
  status           String    @default("open") // open | in_progress | resolved | closed
  inspectedAt      DateTime  @default(now())
  createdById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([organizationId, facilityId])
  @@index([inspectionType, status])
}

// ---------------------------------------------------------------------
// MEDICAL RECORDS — Record Requests, Movement Tracking, Amendments
// ---------------------------------------------------------------------

model RecordRequest {
  id                   String    @id @default(cuid())
  organizationId       String
  facilityId           String?
  requestNumber        String    @unique
  patientId            String?
  patientName          String
  patientNumber        String?
  requestingDepartment String?
  requestingStaffName  String?
  purpose              String?
  priority             String    @default("routine") // routine | urgent | emergency
  status               String    @default("requested") // requested | approved | retrieving | issued | in_use | returned | closed | cancelled
  assignedToName       String?
  notes                String?
  requestedAt          DateTime  @default(now())
  requiredBy           DateTime?
  retrievedAt          DateTime?
  issuedAt             DateTime?
  returnedAt           DateTime?
  closedAt             DateTime?
  createdById          String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  movements RecordMovement[]

  @@index([organizationId, facilityId])
  @@index([status])
  @@index([patientId])
}

model RecordMovement {
  id              String         @id @default(cuid())
  recordRequestId String?
  recordRequest   RecordRequest? @relation(fields: [recordRequestId], references: [id], onDelete: Cascade)
  patientId       String?
  patientName     String
  patientNumber   String?
  movementType    String // requested | retrieved | issued | returned | transferred | missing_found | archived
  fromLocation    String?
  toLocation      String?
  departmentCode  String?
  staffName       String?
  notes           String?
  movedAt         DateTime       @default(now())
  createdById     String?
  createdAt       DateTime       @default(now())

  @@index([patientId, movedAt])
  @@index([recordRequestId])
}

model RecordAmendment {
  id              String    @id @default(cuid())
  organizationId  String
  patientId       String?
  patientName     String
  amendmentType   String // demographic | clinical | document | record_correction
  field           String?
  originalValue   String?
  correctedValue  String?
  reason          String
  status          String    @default("pending") // pending | approved | rejected | applied
  requestedById   String?
  requestedByName String?
  approvedById    String?
  approvedByName  String?
  requestedAt     DateTime  @default(now())
  approvedAt      DateTime?
  appliedAt       DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([organizationId, status])
  @@index([patientId])
}

// ---------------------------------------------------------------------
// MORTUARY — Storage, Movements, Viewings, Property
// ---------------------------------------------------------------------

model MortuaryStorage {
  id             String   @id @default(cuid())
  organizationId String
  facilityId     String?
  name           String // e.g., "Refrigerator 1 - Compartment A"
  storageType    String   @default("refrigerator") // refrigerator | freezer | shelf | room | other
  location       String? // building/room description
  capacity       Int      @default(1)
  status         String   @default("available") // available | occupied | reserved | maintenance | out_of_service
  currentCaseId  String? // link to MortuaryAdmission if occupied
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, facilityId])
  @@index([status])
}

model MortuaryMovement {
  id                  String            @id @default(cuid())
  organizationId      String
  mortuaryAdmissionId String
  mortuaryAdmission   MortuaryAdmission @relation(fields: [mortuaryAdmissionId], references: [id], onDelete: Cascade)
  movementType        String // admitted | stored | moved | viewed | released | transferred
  fromLocation        String?
  toLocation          String?
  movedById           String?
  movedByName         String?
  reason              String?
  notes               String?
  movedAt             DateTime          @default(now())
  createdAt           DateTime          @default(now())

  @@index([mortuaryAdmissionId, movedAt])
}

model MortuaryViewing {
  id                  String            @id @default(cuid())
  organizationId      String
  facilityId          String?
  mortuaryAdmissionId String
  mortuaryAdmission   MortuaryAdmission @relation(fields: [mortuaryAdmissionId], references: [id], onDelete: Cascade)
  viewerName          String
  viewerRelation      String?
  viewerPhone         String?
  numVisitors         Int               @default(1)
  scheduledAt         DateTime
  completedAt         DateTime?
  authorizedBy        String?
  status              String            @default("requested") // requested | approved | scheduled | completed | cancelled
  notes               String?
  createdById         String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([organizationId, facilityId])
  @@index([mortuaryAdmissionId])
  @@index([status])
}

model MortuaryProperty {
  id                  String            @id @default(cuid())
  organizationId      String
  mortuaryAdmissionId String
  mortuaryAdmission   MortuaryAdmission @relation(fields: [mortuaryAdmissionId], references: [id], onDelete: Cascade)
  itemName            String
  description         String?
  quantity            Int               @default(1)
  condition           String? // good | fair | poor | damaged
  receivedBy          String?
  storedLocation      String?
  releasedWithBody    Boolean           @default(false)
  releasedAt          DateTime?
  notes               String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([mortuaryAdmissionId])
}

// ---------------------------------------------------------------------
// BLOOD BANK — Donation tracking, Crossmatch, Reservations
// ---------------------------------------------------------------------

model BloodDonation {
  id              String     @id @default(cuid())
  organizationId  String
  facilityId      String?
  donationNumber  String     @unique
  donorId         String
  donor           BloodDonor @relation(fields: [donorId], references: [id])
  donationType    String     @default("whole_blood") // whole_blood | plasmapheresis | plateletpheresis
  bloodGroup      String
  volumeMl        Int        @default(450)
  unitId          String? // link to BloodUnit if created
  collectionDate  DateTime   @default(now())
  status          String     @default("collected") // collected | tested | processed | rejected
  screeningResult String? // JSON: {hbsAg, hcvAb, hivAb, syphilis, malaria}
  notes           String?
  collectedById   String?
  collectedByName String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([organizationId, facilityId])
  @@index([donorId])
  @@index([status])
}

model BloodCrossmatch {
  id                String    @id @default(cuid())
  organizationId    String
  facilityId        String?
  crossmatchNumber  String    @unique
  patientId         String?
  patientName       String
  patientBloodGroup String?
  unitId            String
  unit              BloodUnit @relation(fields: [unitId], references: [id])
  unitNumber        String
  donorBloodGroup   String
  crossmatchResult  String    @default("pending") // compatible | incompatible | pending
  method            String? // gel_card | tube | immediate_spin
  testedBy          String?
  testedAt          DateTime  @default(now())
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([organizationId, facilityId])
  @@index([patientId])
  @@index([crossmatchResult])
}
